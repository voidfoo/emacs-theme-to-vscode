{
  "name": "modus-vivendi",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "panel.background": "#000000",
    "editorGutter.background": "#1e1e1e",
    "editor.foreground": "#ffffff",
    "editorCursor.background": "#ffffff",
    "editor.selectionBackground": "#5a5a5a40",
    "editor.selectionForeground": "#ffffff",
    "editor.findMatchBackground": "#7a610080",
    "editor.selectionHighlightBackground": "#654a39",
    "editor.findMatchHighlightBackground": "#2266ae",
    "editor.wordHighlightStrongBackground": "#2f7f9f",
    "editorLineNumber.foreground": "#989898",
    "editorLineNumber.activeForeground": "#ffffff",
    "input.placeholderForeground": "#6ae4b9",
    "inlineChatInput.placeholderForeground": "#6ae4b9",
    "statusBar.background": "#505050",
    "statusBarItem.remoteBackground": "#505050",
    "statusBar.foreground": "#ffffff",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBar.noFolderBackground": "#2d2d2d",
    "editorGroup.border": "#646464",
    "editorGroupHeader.tabsBackground": "#1e1e1e",
    "diffEditor.insertedLineBackground": "#00381f40",
    "diffEditor.removedLineBackground": "#4f111940",
    "diffEditor.insertedTextBackground": "#034f2f4d",
    "diffEditor.removedTextBackground": "#781a1f4d",
    "editorSuggestWidget.background": "#0c0c0c",
    "editorSuggestWidget.selectedBackground": "#2f447f",
    "editorSuggestWidget.highlightForeground": "#00bcff",
    "sideBar.background": "#1a1a1a",
    "activityBar.background": "#1a1a1a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#141414",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#141414",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9ac8e0"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#caa6df"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b6a0ff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff5f59"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#f78fe7"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d09dc0"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#76afbf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#00d3d0",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#00bcff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#00c06f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff7f86"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#fec43f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5f59"
      }
    },
    {
      "name": "diff-added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a0e0a0",
        "background": "#00381f"
      }
    },
    {
      "name": "diff-removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ffbfbf",
        "background": "#4f1119"
      }
    },
    {
      "name": "diff-changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#efef80",
        "background": "#363300"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#1e1e1e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#989898"
      }
    }
  ]
}
