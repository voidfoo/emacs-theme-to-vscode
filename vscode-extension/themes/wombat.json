{
  "name": "wombat",
  "type": "dark",
  "colors": {
    "editor.background": "#242424",
    "panel.background": "#242424",
    "editorGutter.background": "#242424",
    "editor.foreground": "#f6f3e8",
    "editorCursor.background": "#656565",
    "editor.selectionBackground": "#44444440",
    "editor.findMatchBackground": "#34343480",
    "editor.selectionHighlightBackground": "#333366",
    "editor.findMatchHighlightBackground": "#384048",
    "editor.wordHighlightStrongBackground": "#4f94cd",
    "editorLineNumber.foreground": "#b3b3b3",
    "editorLineNumber.activeForeground": "#b3b3b3",
    "input.placeholderForeground": "#e5786d",
    "inlineChatInput.placeholderForeground": "#e5786d",
    "statusBar.background": "#444444",
    "statusBarItem.remoteBackground": "#444444",
    "statusBar.foreground": "#f6f3e8",
    "statusBarItem.remoteForeground": "#f6f3e8",
    "statusBar.noFolderBackground": "#444444",
    "editorGroupHeader.tabsBackground": "#303030",
    "diffEditor.insertedLineBackground": "#335533",
    "diffEditor.removedLineBackground": "#553333",
    "diffEditor.insertedTextBackground": "#22aa22",
    "diffEditor.removedTextBackground": "#aa2222",
    "breadcrumb.foreground": "#e5786d",
    "gitDecoration.modifiedResourceForeground": "#cae682",
    "gitDecoration.addedResourceForeground": "#92a65e",
    "gitDecoration.renamedResourceForeground": "#95e454",
    "gitDecoration.untrackedResourceForeground": "#95e454",
    "gitDecoration.ignoredResourceForeground": "#99968b",
    "editorSuggestWidget.background": "#424242",
    "editorSuggestWidget.selectedBackground": "#4f4f4f",
    "editorSuggestWidget.highlightForeground": "#afeeee",
    "sideBar.background": "#282828",
    "activityBar.background": "#282828",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#272727",
    "input.foreground": "#f6f3e8",
    "inlineChatInput.background": "#272727",
    "inlineChatInput.foreground": "#f6f3e8",
    "editorCursor.foreground": "#f6f3e8"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#99968b"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#99968b"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#95e454"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#95e454"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#e5786d"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8ac6f2"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e5786d"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#92a65e"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e5786d"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#95e454"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#e5786d"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ccaa8f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffc0cb"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff0000"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#a020f0"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#737373"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#999999"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#cae682"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#95e454"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#b3b3b3"
      }
    }
  ]
}
