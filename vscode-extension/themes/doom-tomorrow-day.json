{
  "name": "doom-tomorrow-day",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "panel.background": "#ffffff",
    "editorGutter.background": "#ffffff",
    "editor.foreground": "#4d4d4c",
    "editorCursor.background": "#4271ae",
    "editor.selectionBackground": "#e4e4e440",
    "editor.findMatchBackground": "#c6d4e680",
    "editor.selectionHighlightBackground": "#8e908c",
    "editor.findMatchHighlightBackground": "#c6d4e6",
    "editor.wordHighlightStrongBackground": "#f2f2f2",
    "editorLineNumber.foreground": "#c0bfbf",
    "editorLineNumber.activeForeground": "#000000",
    "input.placeholderForeground": "#4271ae",
    "inlineChatInput.placeholderForeground": "#4271ae",
    "statusBar.background": "#f7f7f7",
    "statusBarItem.remoteBackground": "#f7f7f7",
    "statusBar.foreground": "#4d4d4c",
    "statusBarItem.remoteForeground": "#4d4d4c",
    "statusBar.noFolderBackground": "#f4f4f4",
    "editorGroup.border": "#d6d4d4",
    "editorGroupHeader.tabsBackground": "#f7f7f7",
    "diffEditor.insertedLineBackground": "#f2f2f2",
    "diffEditor.removedLineBackground": "#d6d4d4",
    "diffEditor.insertedTextBackground": "#f2f2f2",
    "diffEditor.removedTextBackground": "#d6d4d4",
    "breadcrumb.foreground": "#718c00",
    "gitDecoration.modifiedResourceForeground": "#8959a8",
    "gitDecoration.addedResourceForeground": "#a9ba66",
    "gitDecoration.renamedResourceForeground": "#8e908c",
    "gitDecoration.untrackedResourceForeground": "#eab700",
    "gitDecoration.ignoredResourceForeground": "#8e908c",
    "editorSuggestWidget.background": "#f2f2f2",
    "editorSuggestWidget.foreground": "#4d4d4c",
    "editorSuggestWidget.selectedBackground": "#e4e4e4",
    "editorSuggestWidget.highlightForeground": "#4271ae",
    "sideBar.background": "#e6e6e6",
    "activityBar.background": "#e6e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0e0e0",
    "input.foreground": "#272726",
    "inlineChatInput.background": "#e0e0e0",
    "inlineChatInput.foreground": "#272726",
    "editorCursor.foreground": "#4d4d4c"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8e908c"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8e908c"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#718c00"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8e908c"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#f5871f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8959a8"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#4271ae"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4271ae"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4271ae"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#c82829"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c82829"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c82829"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#c82829"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#bb9200"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f5871f"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f5871f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#718c00"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eab700"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c82829"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#c82829"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f2f2f2",
        "background": "#c82829"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#8abeb7"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#4271ae"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4271ae"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#d6d4d4"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#c82829"
      }
    }
  ]
}
