{
  "name": "ef-deuteranopia-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#000a1f",
    "panel.background": "#000a1f",
    "editorGutter.background": "#000a1f",
    "editor.foreground": "#ddddee",
    "editorCursor.background": "#ffff00",
    "editor.selectionBackground": "#22384840",
    "editor.findMatchBackground": "#5f5f0080",
    "editor.selectionHighlightBackground": "#00405f",
    "editor.findMatchHighlightBackground": "#266fd0",
    "editor.wordHighlightStrongBackground": "#0f4f9a",
    "editorLineNumber.foreground": "#7f8797",
    "editorLineNumber.activeForeground": "#009fff",
    "input.placeholderForeground": "#009fff",
    "inlineChatInput.placeholderForeground": "#009fff",
    "statusBar.background": "#003f8f",
    "statusBarItem.remoteBackground": "#003f8f",
    "statusBar.foreground": "#ffffff",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBar.noFolderBackground": "#243145",
    "editorGroup.border": "#555a64",
    "editorGroupHeader.tabsBackground": "#121f34",
    "diffEditor.insertedLineBackground": "#00234f",
    "diffEditor.removedLineBackground": "#323200",
    "diffEditor.insertedTextBackground": "#03395f",
    "diffEditor.removedTextBackground": "#484800",
    "editorSuggestWidget.background": "#001137",
    "editorSuggestWidget.selectedBackground": "#343420",
    "editorSuggestWidget.highlightForeground": "#009fff",
    "sideBar.background": "#1a2335",
    "activityBar.background": "#1a2335",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#141e31",
    "input.foreground": "#ddddee",
    "inlineChatInput.background": "#141e31",
    "inlineChatInput.foreground": "#ddddee",
    "editorCursor.foreground": "#ddddee"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#af9a6a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#af9a6a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3f90f0"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c59fcf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cfaf00"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#cfaf00"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bfaf7a"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#af9a6a"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#0db0ff"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#0db0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#0db0ff"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9f95ff"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#009fff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#af9a6a"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3f90f0"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#cfaf00"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#af9a6a"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#aa9f32"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#bfaf7a"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cfaf00"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#5f5f00"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cfaf00",
        "background": "#442f00"
      }
    }
  ]
}
