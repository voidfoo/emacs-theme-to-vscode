{
  "name": "ef-reverie",
  "type": "light",
  "colors": {
    "editor.background": "#f3eddf",
    "panel.background": "#f3eddf",
    "editorGutter.background": "#f3eddf",
    "editor.foreground": "#4f204f",
    "editorCursor.background": "#9d5744",
    "editor.selectionBackground": "#e0d0ba40",
    "editor.findMatchBackground": "#e2b27080",
    "editor.selectionHighlightBackground": "#d0c4e4",
    "editor.findMatchHighlightBackground": "#c0c0f0",
    "editor.wordHighlightStrongBackground": "#bf9fbf",
    "editorLineNumber.foreground": "#6f6877",
    "editorLineNumber.activeForeground": "#87591f",
    "input.placeholderForeground": "#9f4e74",
    "inlineChatInput.placeholderForeground": "#9f4e74",
    "statusBar.background": "#d1b0df",
    "statusBarItem.remoteBackground": "#d1b0df",
    "statusBar.foreground": "#523044",
    "statusBarItem.remoteForeground": "#523044",
    "statusBar.noFolderBackground": "#d9cac8",
    "editorGroup.border": "#c5afb6",
    "editorGroupHeader.tabsBackground": "#e5d6d4",
    "diffEditor.insertedLineBackground": "#b4e9d0",
    "diffEditor.removedLineBackground": "#f8c3bf",
    "diffEditor.insertedTextBackground": "#a4d4c4",
    "diffEditor.removedTextBackground": "#f9a8bd",
    "editorSuggestWidget.background": "#ede4ce",
    "editorSuggestWidget.selectedBackground": "#e9cedd",
    "editorSuggestWidget.highlightForeground": "#87591f",
    "sideBar.background": "#dbd5c9",
    "activityBar.background": "#dbd5c9",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d6d1c4",
    "input.foreground": "#4f204f",
    "inlineChatInput.background": "#d6d1c4",
    "inlineChatInput.foreground": "#4f204f",
    "editorCursor.foreground": "#4f204f"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#475d80"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#475d80"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a04650"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7a5c50"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#97508f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#906045"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a73080"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#97508f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4f60a0"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#456b82"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#9f4e74"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#97508f"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#9f4e74",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#9f4e74"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#426340"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#5059c0"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#0b6e8a"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a04650"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#b21f00"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#0b6e8a"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#0b6e8a"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a05900"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a73080"
      }
    }
  ]
}
