{
  "name": "doom-nord-aurora",
  "type": "dark",
  "colors": {
    "editor.background": "#2e3440",
    "panel.background": "#2e3440",
    "editorGutter.background": "#2e3440",
    "editor.foreground": "#eceff4",
    "editorCursor.background": "#9099ab",
    "editor.selectionBackground": "#434c5e40",
    "editor.findMatchBackground": "#646b7780",
    "editor.selectionHighlightBackground": "#434c5e",
    "editor.findMatchHighlightBackground": "#646b77",
    "editor.wordHighlightStrongBackground": "#373e4c",
    "editorLineNumber.foreground": "#6f7787",
    "editorLineNumber.activeForeground": "#d8dee9",
    "input.placeholderForeground": "#9099ab",
    "inlineChatInput.placeholderForeground": "#9099ab",
    "statusBar.background": "#242832",
    "statusBarItem.remoteBackground": "#242832",
    "statusBar.noFolderBackground": "#292e39",
    "editorGroup.border": "#1c2028",
    "editorGroupHeader.tabsBackground": "#242832",
    "diffEditor.insertedLineBackground": "#272c36",
    "diffEditor.removedLineBackground": "#373e4c",
    "diffEditor.insertedTextBackground": "#272c36",
    "diffEditor.removedTextBackground": "#373e4c",
    "breadcrumb.foreground": "#8fbcbb",
    "gitDecoration.modifiedResourceForeground": "#5d80ae",
    "gitDecoration.addedResourceForeground": "#a3be8c",
    "gitDecoration.renamedResourceForeground": "#d8dee9",
    "gitDecoration.untrackedResourceForeground": "#d8dee9",
    "gitDecoration.ignoredResourceForeground": "#9099ab",
    "editorSuggestWidget.background": "#272c36",
    "editorSuggestWidget.foreground": "#eceff4",
    "editorSuggestWidget.selectedBackground": "#5e81ac",
    "editorSuggestWidget.highlightForeground": "#9099ab",
    "sideBar.background": "#434853",
    "activityBar.background": "#434853",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3f444f",
    "input.foreground": "#eceff4",
    "inlineChatInput.background": "#3f444f",
    "inlineChatInput.foreground": "#eceff4",
    "editorCursor.foreground": "#eceff4",
    "statusBar.foreground": "#eceff4",
    "statusBarItem.remoteForeground": "#eceff4"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9099ab"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9099ab"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#d8dee9"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#bf616a"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#373e4c",
        "background": "#bf616a"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#414754"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    }
  ]
}
