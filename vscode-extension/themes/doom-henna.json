{
  "name": "doom-henna",
  "type": "dark",
  "colors": {
    "editor.background": "#21272e",
    "panel.background": "#21272e",
    "editorGutter.background": "#21272e",
    "editor.foreground": "#f8f8f0",
    "editorCursor.background": "#e74c3c",
    "editor.selectionBackground": "#2e4a5440",
    "editor.findMatchBackground": "#a1352a80",
    "editor.selectionHighlightBackground": "#737c8c",
    "editor.findMatchHighlightBackground": "#a1352a",
    "editor.wordHighlightStrongBackground": "#10151a",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#f8f8f0",
    "input.placeholderForeground": "#e74c3c",
    "inlineChatInput.placeholderForeground": "#e74c3c",
    "statusBar.background": "#161a1d",
    "statusBarItem.remoteBackground": "#161a1d",
    "statusBar.foreground": "#f8f8f0",
    "statusBarItem.remoteForeground": "#f8f8f0",
    "statusBar.noFolderBackground": "#181b1f",
    "editorGroup.border": "#15171b",
    "editorGroupHeader.tabsBackground": "#161a1d",
    "diffEditor.insertedLineBackground": "#1b1f23",
    "diffEditor.removedLineBackground": "#262d35",
    "diffEditor.insertedTextBackground": "#1b1f23",
    "diffEditor.removedTextBackground": "#262d35",
    "breadcrumb.foreground": "#e74c3c",
    "gitDecoration.modifiedResourceForeground": "#ecbe7b",
    "gitDecoration.addedResourceForeground": "#53df83",
    "gitDecoration.renamedResourceForeground": "#606f73",
    "gitDecoration.untrackedResourceForeground": "#9cd230",
    "gitDecoration.ignoredResourceForeground": "#606f73",
    "editorSuggestWidget.background": "#1b1f23",
    "editorSuggestWidget.foreground": "#f8f8f0",
    "editorSuggestWidget.selectedBackground": "#56b6c2",
    "editorSuggestWidget.highlightForeground": "#e74c3c",
    "sideBar.background": "#242b33",
    "activityBar.background": "#242b33",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#242a32",
    "input.foreground": "#f8f8f0",
    "inlineChatInput.background": "#242a32",
    "inlineChatInput.foreground": "#f8f8f0",
    "editorCursor.foreground": "#f8f8f0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606f73"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606f73"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#53df83"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#606f73"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#1abc9c"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1abc9c"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#1abc9c"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#1abc9c"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#1abc9c"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#53df83"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ecbe7b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e74c3c"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#10151a",
        "background": "#e74c3c"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#56b5c2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#30373f"
      }
    }
  ]
}
