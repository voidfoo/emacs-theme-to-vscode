{
  "name": "doom-solarized-light",
  "type": "light",
  "colors": {
    "editor.background": "#fdf6e3",
    "panel.background": "#fdf6e3",
    "editorGutter.background": "#fdf6e3",
    "editor.foreground": "#556b72",
    "editorCursor.background": "#268bd2",
    "editor.selectionBackground": "#d6d0bf40",
    "editor.findMatchBackground": "#bcd5dd80",
    "editor.selectionHighlightBackground": "#e1dbcd",
    "editor.findMatchHighlightBackground": "#bcd5dd",
    "editor.wordHighlightStrongBackground": "#fffbf0",
    "editorLineNumber.foreground": "#96a7a9",
    "editorLineNumber.activeForeground": "#556b72",
    "input.placeholderForeground": "#268bd2",
    "inlineChatInput.placeholderForeground": "#268bd2",
    "statusBar.background": "#f0e9d7",
    "statusBarItem.remoteBackground": "#f0e9d7",
    "statusBar.noFolderBackground": "#f6efdd",
    "editorGroup.border": "#e1dbcd",
    "editorGroupHeader.tabsBackground": "#f0e9d7",
    "diffEditor.insertedLineBackground": "#f2e6ce",
    "diffEditor.removedLineBackground": "#f2e6ce",
    "diffEditor.insertedTextBackground": "#f2e6ce",
    "diffEditor.removedTextBackground": "#f2e6ce",
    "breadcrumb.foreground": "#2aa198",
    "gitDecoration.modifiedResourceForeground": "#6c71c4",
    "gitDecoration.addedResourceForeground": "#859900",
    "gitDecoration.renamedResourceForeground": "#35a69c",
    "gitDecoration.untrackedResourceForeground": "#35a69c",
    "gitDecoration.ignoredResourceForeground": "#96a7a9",
    "editorSuggestWidget.background": "#eee8d5",
    "editorSuggestWidget.foreground": "#556b72",
    "editorSuggestWidget.selectedBackground": "#268bd2",
    "editorSuggestWidget.highlightForeground": "#268bd2",
    "sideBar.background": "#e4ddcc",
    "activityBar.background": "#e4ddcc",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dfd8c8",
    "input.foreground": "#2b3639",
    "inlineChatInput.background": "#dfd8c8",
    "inlineChatInput.foreground": "#2b3639",
    "editorCursor.foreground": "#556b72",
    "statusBar.foreground": "#2b3639",
    "statusBarItem.remoteForeground": "#2b3639"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#96a7a9"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#96a7a9"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#35a69c"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#dc322f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fffbf0",
        "background": "#dc322f"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#f2e7d0"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    }
  ]
}
