{
  "name": "ef-duo-light",
  "type": "light",
  "colors": {
    "editor.background": "#fff8f0",
    "panel.background": "#fff8f0",
    "editorGutter.background": "#fff8f0",
    "editor.foreground": "#222222",
    "editorCursor.background": "#1144ff",
    "editor.selectionBackground": "#caeafa40",
    "editor.findMatchBackground": "#fac20080",
    "editor.selectionHighlightBackground": "#aaeccf",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#afbfef",
    "editorLineNumber.foreground": "#63728f",
    "editorLineNumber.activeForeground": "#4250ef",
    "input.placeholderForeground": "#4250ef",
    "inlineChatInput.placeholderForeground": "#4250ef",
    "statusBar.background": "#f8cf8f",
    "statusBarItem.remoteBackground": "#f8cf8f",
    "statusBar.foreground": "#111133",
    "statusBarItem.remoteForeground": "#111133",
    "statusBar.noFolderBackground": "#e7e0da",
    "editorGroup.border": "#baafba",
    "editorGroupHeader.tabsBackground": "#f6ece8",
    "diffEditor.insertedLineBackground": "#ccefcf",
    "diffEditor.removedLineBackground": "#ffd4d8",
    "diffEditor.insertedTextBackground": "#bae0c0",
    "diffEditor.removedTextBackground": "#ffc0ca",
    "editorSuggestWidget.background": "#f8efef",
    "editorSuggestWidget.selectedBackground": "#fadacf",
    "editorSuggestWidget.highlightForeground": "#4250ef",
    "sideBar.background": "#e6dfd8",
    "activityBar.background": "#e6dfd8",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0dad3",
    "input.foreground": "#222222",
    "inlineChatInput.background": "#e0dad3",
    "inlineChatInput.foreground": "#222222",
    "editorCursor.foreground": "#222222"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a2403f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a2403f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9f4a00"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#406f90"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#af569f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#cc3333"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#1f77bb"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#406f90"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6052cf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#af569f"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6052cf",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6052cf"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#065fff"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#375cd8"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9f4a00"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#dd1100"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#3f70a0"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8a5d00"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cc3333"
      }
    }
  ]
}
