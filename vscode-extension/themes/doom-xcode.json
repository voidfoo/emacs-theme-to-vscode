{
  "name": "doom-xcode",
  "type": "dark",
  "colors": {
    "editor.background": "#292a30",
    "panel.background": "#292a30",
    "editorGutter.background": "#292a30",
    "editor.foreground": "#ffffff",
    "editorCursor.background": "#5dd8ff",
    "editor.selectionBackground": "#3e3f4440",
    "editor.findMatchBackground": "#4197b280",
    "editor.selectionHighlightBackground": "#6c7986",
    "editor.findMatchHighlightBackground": "#4197b2",
    "editor.wordHighlightStrongBackground": "#0d0d0d",
    "editorLineNumber.foreground": "#3f4040",
    "editorLineNumber.activeForeground": "#fd8f3f",
    "input.placeholderForeground": "#5dd8ff",
    "inlineChatInput.placeholderForeground": "#5dd8ff",
    "statusBar.background": "#191a1c",
    "statusBarItem.remoteBackground": "#191a1c",
    "statusBar.foreground": "#ffffff",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBar.noFolderBackground": "#292a30",
    "editorGroup.border": "#161616",
    "editorGroupHeader.tabsBackground": "#191a1c",
    "diffEditor.insertedLineBackground": "#252629",
    "diffEditor.removedLineBackground": "#292b2b",
    "diffEditor.insertedTextBackground": "#252629",
    "diffEditor.removedTextBackground": "#292b2b",
    "breadcrumb.foreground": "#fc6a5d",
    "gitDecoration.modifiedResourceForeground": "#a167e6",
    "gitDecoration.addedResourceForeground": "#67b7a4",
    "gitDecoration.renamedResourceForeground": "#808b96",
    "gitDecoration.untrackedResourceForeground": "#808b96",
    "gitDecoration.ignoredResourceForeground": "#6c7986",
    "editorSuggestWidget.background": "#252629",
    "editorSuggestWidget.foreground": "#ffffff",
    "editorSuggestWidget.selectedBackground": "#3e3f44",
    "editorSuggestWidget.highlightForeground": "#5dd8ff",
    "sideBar.background": "#3e3f45",
    "activityBar.background": "#3e3f45",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3a3b41",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#3a3b41",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c7986"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c7986"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#fc6a5d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#808b96"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#a167e6"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#fc5fa3"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#fd8f3f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#9ef1dd"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d0a8ff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d0a8ff"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#41a1c0"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#41a1c0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#41a1c0"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#41a1c0"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#5dd8ff"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#a167e6"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d0bf68"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#fd8f3f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#fc6a5d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#fd8f3f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#fd8f3f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#fd8f3f"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d0bf68"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fc6a5d"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#fc6a5d"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#0d0d0d",
        "background": "#fc6a5d"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#8abeb7"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#5dd8ff"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#5dd8ff"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#292b2b"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d0a8ff"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#fc6a5d"
      }
    }
  ]
}
