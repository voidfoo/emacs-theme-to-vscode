{
  "name": "ef-frost",
  "type": "light",
  "colors": {
    "editor.background": "#fcffff",
    "panel.background": "#fcffff",
    "editorGutter.background": "#fcffff",
    "editor.foreground": "#232323",
    "editorCursor.background": "#0055bb",
    "editor.selectionBackground": "#d4eaf340",
    "editor.findMatchBackground": "#fac20080",
    "editor.selectionHighlightBackground": "#aae0bf",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#cab0ef",
    "editorLineNumber.foreground": "#66657f",
    "editorLineNumber.activeForeground": "#4244ef",
    "input.placeholderForeground": "#1f6fbf",
    "inlineChatInput.placeholderForeground": "#1f6fbf",
    "statusBar.background": "#9ad0ff",
    "statusBarItem.remoteBackground": "#9ad0ff",
    "statusBar.foreground": "#051524",
    "statusBarItem.remoteForeground": "#051524",
    "statusBar.noFolderBackground": "#d7dbdb",
    "editorGroup.border": "#b0b7c0",
    "editorGroupHeader.tabsBackground": "#eaefef",
    "diffEditor.insertedLineBackground": "#c9ffea",
    "diffEditor.removedLineBackground": "#ffd6e0",
    "diffEditor.insertedTextBackground": "#b3efdf",
    "diffEditor.removedTextBackground": "#f5bfc8",
    "editorSuggestWidget.background": "#eff3f3",
    "editorSuggestWidget.selectedBackground": "#cce7f5",
    "editorSuggestWidget.highlightForeground": "#4244ef",
    "sideBar.background": "#e3e6e6",
    "activityBar.background": "#e3e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dee0e0",
    "input.foreground": "#232323",
    "inlineChatInput.background": "#dee0e0",
    "inlineChatInput.foreground": "#232323",
    "editorCursor.foreground": "#232323"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a5f2f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a5f2f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4244ef"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#605f9f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#605f9f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#004fc0"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#c42d2f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00845f"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#517f3c"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#3a6dd2"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#305f9f"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#3a6dd2",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#3a6dd2"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#7f5ae0"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#065fff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#996c4f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4244ef"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#cf2f4f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#996c4f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#aa44c5"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#996c4f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c42d2f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#fac200"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c42d2f",
        "background": "#ffdfda"
      }
    }
  ]
}
