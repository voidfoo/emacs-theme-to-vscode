{
  "name": "ef-dream",
  "type": "dark",
  "colors": {
    "editor.background": "#232025",
    "panel.background": "#232025",
    "editorGutter.background": "#232025",
    "editor.foreground": "#efd5c5",
    "editorCursor.background": "#f3c09a",
    "editor.selectionBackground": "#544a5040",
    "editor.findMatchBackground": "#8f665f80",
    "editor.selectionHighlightBackground": "#665f7a",
    "editor.findMatchHighlightBackground": "#4f509f",
    "editor.wordHighlightStrongBackground": "#885566",
    "editorLineNumber.foreground": "#8f8886",
    "editorLineNumber.activeForeground": "#deb07a",
    "input.placeholderForeground": "#ffaacf",
    "inlineChatInput.placeholderForeground": "#ffaacf",
    "statusBar.background": "#675072",
    "statusBarItem.remoteBackground": "#675072",
    "statusBar.foreground": "#fedeff",
    "statusBarItem.remoteForeground": "#fedeff",
    "statusBar.noFolderBackground": "#3b393e",
    "editorGroup.border": "#635850",
    "editorGroupHeader.tabsBackground": "#322f34",
    "diffEditor.insertedLineBackground": "#304a4f",
    "diffEditor.removedLineBackground": "#5a3142",
    "diffEditor.insertedTextBackground": "#2f6767",
    "diffEditor.removedTextBackground": "#782a4a",
    "editorSuggestWidget.background": "#2e2a31",
    "editorSuggestWidget.selectedBackground": "#503240",
    "editorSuggestWidget.highlightForeground": "#deb07a",
    "sideBar.background": "#39363b",
    "activityBar.background": "#39363b",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#353236",
    "input.foreground": "#efd5c5",
    "inlineChatInput.background": "#353236",
    "inlineChatInput.foreground": "#efd5c5",
    "editorCursor.foreground": "#efd5c5"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a0cf"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a0cf"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f3a0a0"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#caa89f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#e3b0c0"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#deb07a"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f498c0"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e3b0c0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8fcfd0"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#99bfcf"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ffaacf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e3b0c0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#ffaacf"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#ffaacf"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#a9c99f"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#80aadf"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#65c5a8"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f3a0a0"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#e47980"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#65c5a8"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#65c5a8"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d09950"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f498c0"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#8f665f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f498c0",
        "background": "#501a2d"
      }
    }
  ]
}
