{
  "name": "ef-owl",
  "type": "dark",
  "colors": {
    "editor.background": "#292c2f",
    "panel.background": "#292c2f",
    "editorGutter.background": "#292c2f",
    "editor.foreground": "#d0d0d0",
    "editorCursor.background": "#afe6ef",
    "editor.selectionBackground": "#404f6640",
    "editor.findMatchBackground": "#8f665f80",
    "editor.selectionHighlightBackground": "#415960",
    "editor.findMatchHighlightBackground": "#4f70aa",
    "editor.wordHighlightStrongBackground": "#706069",
    "editorLineNumber.foreground": "#857f8f",
    "editorLineNumber.activeForeground": "#7ac0b9",
    "input.placeholderForeground": "#72aff0",
    "inlineChatInput.placeholderForeground": "#72aff0",
    "statusBar.background": "#5b637e",
    "statusBarItem.remoteBackground": "#5b637e",
    "statusBar.foreground": "#dadfe5",
    "statusBarItem.remoteForeground": "#dadfe5",
    "statusBar.noFolderBackground": "#40474b",
    "editorGroup.border": "#4f5f66",
    "editorGroupHeader.tabsBackground": "#373b3d",
    "diffEditor.insertedLineBackground": "#304a3f",
    "diffEditor.removedLineBackground": "#5a3142",
    "diffEditor.insertedTextBackground": "#2f6757",
    "diffEditor.removedTextBackground": "#782a4a",
    "editorSuggestWidget.background": "#33363a",
    "editorSuggestWidget.selectedBackground": "#354864",
    "editorSuggestWidget.highlightForeground": "#7ac0b9",
    "sideBar.background": "#3e4144",
    "activityBar.background": "#3e4144",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3a3d40",
    "input.foreground": "#d0d0d0",
    "inlineChatInput.background": "#3a3d40",
    "inlineChatInput.foreground": "#d0d0d0",
    "editorCursor.foreground": "#d0d0d0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#aab2df"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#aab2df"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7ac0b9"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9fb3a7"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#e5bbd7"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#99bfd0"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#df885f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#80a4e0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#60bd90"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9fb3a7"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#a0a0ef"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#aab2df"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#a0a0ef",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#a0a0ef"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#cfa0e8"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#cf9f90"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#c09f6f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7ac0b9"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#d67869"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#c09f6f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#98c06f"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d1a45f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#df885f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#8f665f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#df885f",
        "background": "#4f231f"
      }
    }
  ]
}
