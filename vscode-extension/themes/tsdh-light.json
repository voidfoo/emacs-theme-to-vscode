{
  "name": "tsdh-light",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "panel.background": "#fafafa",
    "editorGutter.background": "#fafafa",
    "editor.foreground": "#383a42",
    "editorCursor.background": "#000000",
    "editor.selectionBackground": "#ffec8b40",
    "editor.findMatchBackground": "#cd00cd80",
    "editor.selectionHighlightBackground": "#ffff00",
    "editor.findMatchHighlightBackground": "#afeeee",
    "editor.wordHighlightStrongBackground": "#00ffff",
    "editorLineNumber.foreground": "#7f7f7f",
    "editorLineNumber.activeForeground": "#7f7f7f",
    "input.placeholderForeground": "#0184bc",
    "inlineChatInput.placeholderForeground": "#0184bc",
    "statusBar.background": "#f0f0f1",
    "statusBarItem.remoteBackground": "#f0f0f1",
    "statusBar.noFolderBackground": "#f0f0f1",
    "editorGroupHeader.tabsBackground": "#f0f0f1",
    "diffEditor.insertedLineBackground": "#90ee90",
    "diffEditor.removedLineBackground": "#f4a460",
    "diffEditor.insertedTextBackground": "#bbffbb",
    "diffEditor.removedTextBackground": "#ffcccc",
    "breadcrumb.foreground": "#008b8b",
    "gitDecoration.modifiedResourceForeground": "#8b4513",
    "gitDecoration.addedResourceForeground": "#c18401",
    "gitDecoration.renamedResourceForeground": "#50a14f",
    "gitDecoration.untrackedResourceForeground": "#50a14f",
    "gitDecoration.ignoredResourceForeground": "#a0a1a7",
    "editorSuggestWidget.background": "#fff8dc",
    "editorSuggestWidget.foreground": "#000000",
    "editorSuggestWidget.selectedBackground": "#add8e6",
    "editorSuggestWidget.highlightForeground": "#8b0000",
    "sideBar.background": "#e1e1e1",
    "activityBar.background": "#e1e1e1",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dcdcdc",
    "input.foreground": "#24262b",
    "inlineChatInput.background": "#dcdcdc",
    "inlineChatInput.foreground": "#24262b",
    "editorCursor.foreground": "#383a42",
    "statusBar.foreground": "#27292e",
    "statusBarItem.remoteForeground": "#27292e"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a1a7"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a1a7"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#008b8b"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e44649"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#8b4513"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#8b4513"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8b4513"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#8b4513"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#c18401"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#008b8b"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#e44649"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff0000"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "background": "#ff1493"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#d9d9d9"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#bfbfbf"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#7f7f7f"
      }
    }
  ]
}
