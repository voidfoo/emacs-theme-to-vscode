{
  "name": "doom-ayu-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1017",
    "panel.background": "#0d1017",
    "editorGutter.background": "#0d1017",
    "editor.foreground": "#bfbdb6",
    "editorCursor.background": "#e6b450",
    "editor.selectionBackground": "#21314540",
    "editor.findMatchBackground": "#a17e3780",
    "editor.selectionHighlightBackground": "#090c11",
    "editor.findMatchHighlightBackground": "#a17e37",
    "editor.wordHighlightStrongBackground": "#213145",
    "editorLineNumber.foreground": "#f5faff",
    "editorLineNumber.activeForeground": "#bfbdb6",
    "input.placeholderForeground": "#e6b450",
    "inlineChatInput.placeholderForeground": "#e6b450",
    "statusBar.background": "#080a0f",
    "statusBarItem.remoteBackground": "#080a0f",
    "statusBar.foreground": "#bfbdb6",
    "statusBarItem.remoteForeground": "#bfbdb6",
    "statusBar.noFolderBackground": "#090c11",
    "editorGroup.border": "#07080c",
    "editorGroupHeader.tabsBackground": "#080a0f",
    "diffEditor.insertedLineBackground": "#131721",
    "diffEditor.insertedTextBackground": "#131721",
    "breadcrumb.foreground": "#7fd962",
    "gitDecoration.modifiedResourceForeground": "#dbb7ff",
    "gitDecoration.addedResourceForeground": "#aad94c",
    "gitDecoration.renamedResourceForeground": "#696c71",
    "gitDecoration.untrackedResourceForeground": "#696c71",
    "gitDecoration.ignoredResourceForeground": "#373b42",
    "editorSuggestWidget.background": "#0d1017",
    "editorSuggestWidget.foreground": "#bfbdb6",
    "editorSuggestWidget.selectedBackground": "#090c11",
    "editorSuggestWidget.highlightForeground": "#e6b450",
    "sideBar.background": "#0e1219",
    "activityBar.background": "#0e1219",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#0e1119",
    "input.foreground": "#bfbdb6",
    "inlineChatInput.background": "#0e1119",
    "inlineChatInput.foreground": "#bfbdb6",
    "editorCursor.foreground": "#bfbdb6"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#373b42"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#373b42"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7fd962"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#696c71"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d2a6ff"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff8f40"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#e6b673"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d2a6ff"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7fd962"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d95757"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#f07178"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#2f3238",
        "background": "#f07178"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#39bae6"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#59c2ff"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#191b22"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d2a6ff"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    }
  ]
}
