{
  "name": "doom-meltbus",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "panel.background": "#000000",
    "editorGutter.background": "#000000",
    "editor.foreground": "#dddddd",
    "editorCursor.background": "#cecece",
    "editor.findMatchBackground": "#5e7ab280",
    "editor.selectionHighlightBackground": "#686868",
    "editor.findMatchHighlightBackground": "#5e7ab2",
    "editor.wordHighlightStrongBackground": "#000000",
    "editorLineNumber.foreground": "#8a8a8a",
    "editorLineNumber.activeForeground": "#dddddd",
    "input.placeholderForeground": "#8a8a8a",
    "inlineChatInput.placeholderForeground": "#8a8a8a",
    "statusBar.background": "#000000",
    "statusBarItem.remoteBackground": "#000000",
    "statusBar.foreground": "#dddddd",
    "statusBarItem.remoteForeground": "#dddddd",
    "editorGroup.border": "#111111",
    "editorGroupHeader.tabsBackground": "#000000",
    "diffEditor.insertedTextBackground": "#448844",
    "diffEditor.removedTextBackground": "#f8b0b0",
    "breadcrumb.foreground": "#acacac",
    "gitDecoration.modifiedResourceForeground": "#da8548",
    "gitDecoration.addedResourceForeground": "#448844",
    "gitDecoration.renamedResourceForeground": "#8a8a8a",
    "gitDecoration.untrackedResourceForeground": "#8a8a8a",
    "gitDecoration.ignoredResourceForeground": "#686868",
    "editorSuggestWidget.background": "#000000",
    "editorSuggestWidget.foreground": "#dddddd",
    "editorSuggestWidget.selectedBackground": "#464646",
    "editorSuggestWidget.highlightForeground": "#87afff",
    "sideBar.background": "#000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#000000",
    "input.foreground": "#dddddd",
    "inlineChatInput.background": "#000000",
    "inlineChatInput.foreground": "#dddddd",
    "editorCursor.foreground": "#dddddd",
    "statusBar.noFolderBackground": "#00000040"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686868"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686868"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#acacac"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#acacac"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#acacac"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#da8548"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f8b0b0"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#f8b0b0"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#000000",
        "background": "#f8b0b0"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#dddddd",
        "background": "#464646"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#87afff"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    }
  ]
}
