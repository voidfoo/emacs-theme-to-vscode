{
  "name": "ef-eagle",
  "type": "light",
  "colors": {
    "editor.background": "#f1ecd0",
    "panel.background": "#f1ecd0",
    "editorGutter.background": "#f1ecd0",
    "editor.foreground": "#231a1f",
    "editorCursor.background": "#774400",
    "editor.selectionBackground": "#ddc5af40",
    "editor.findMatchBackground": "#efbf0080",
    "editor.selectionHighlightBackground": "#c5d8a2",
    "editor.findMatchHighlightBackground": "#a0ddd0",
    "editor.wordHighlightStrongBackground": "#9fd0cc",
    "editorLineNumber.foreground": "#685f53",
    "editorLineNumber.activeForeground": "#882000",
    "input.placeholderForeground": "#843300",
    "inlineChatInput.placeholderForeground": "#843300",
    "statusBar.background": "#cfab80",
    "statusBarItem.remoteBackground": "#cfab80",
    "statusBar.foreground": "#2f1005",
    "statusBarItem.remoteForeground": "#2f1005",
    "statusBar.noFolderBackground": "#cec8ae",
    "editorGroup.border": "#7f785f",
    "editorGroupHeader.tabsBackground": "#e4dbc0",
    "diffEditor.insertedLineBackground": "#b0e7b0",
    "diffEditor.removedLineBackground": "#f8c8a6",
    "diffEditor.insertedTextBackground": "#9ad590",
    "diffEditor.removedTextBackground": "#f0aa90",
    "editorSuggestWidget.background": "#ece5bf",
    "editorSuggestWidget.selectedBackground": "#dfc8af",
    "editorSuggestWidget.highlightForeground": "#882000",
    "sideBar.background": "#d9d4bb",
    "activityBar.background": "#d9d4bb",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d4d0b7",
    "input.foreground": "#231a1f",
    "inlineChatInput.background": "#d4d0b7",
    "inlineChatInput.foreground": "#231a1f",
    "editorCursor.foreground": "#231a1f"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a5937"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a5937"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3a7800"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#42573f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#603a6f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#702f1f"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#9a0000"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#775228"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#882000"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#702f1f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#125a7f"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#304f60"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#125a7f"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#125a7f"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#226022"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#006e50"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#960f4f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3a7800"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#960f4f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#9a0000"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#843300"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#9a0000"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#efbf00"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#9a0000",
        "background": "#f2d4b5"
      }
    }
  ]
}
