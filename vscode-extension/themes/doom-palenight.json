{
  "name": "doom-palenight",
  "type": "dark",
  "colors": {
    "editor.background": "#292d3e",
    "panel.background": "#292d3e",
    "editorGutter.background": "#292d3e",
    "editor.foreground": "#eeffff",
    "editorCursor.background": "#c792ea",
    "editor.selectionBackground": "#3c435e40",
    "editor.findMatchBackground": "#4e557980",
    "editor.selectionHighlightBackground": "#676e95",
    "editor.findMatchHighlightBackground": "#4e5579",
    "editor.wordHighlightStrongBackground": "#1c1f2b",
    "editorLineNumber.foreground": "#676e95",
    "editorLineNumber.activeForeground": "#eeffff",
    "input.placeholderForeground": "#c792ea",
    "inlineChatInput.placeholderForeground": "#c792ea",
    "statusBar.background": "#232635",
    "statusBarItem.remoteBackground": "#232635",
    "statusBar.foreground": "#a6accd",
    "statusBarItem.remoteForeground": "#a6accd",
    "statusBar.noFolderBackground": "#282c3d",
    "editorGroup.border": "#232635",
    "editorGroupHeader.tabsBackground": "#232635",
    "diffEditor.insertedLineBackground": "#242837",
    "diffEditor.removedLineBackground": "#3c435e",
    "diffEditor.insertedTextBackground": "#242837",
    "diffEditor.removedTextBackground": "#3c435e",
    "breadcrumb.foreground": "#c3e88d",
    "gitDecoration.modifiedResourceForeground": "#bb80b3",
    "gitDecoration.addedResourceForeground": "#c3e88d",
    "gitDecoration.renamedResourceForeground": "#8d92af",
    "gitDecoration.untrackedResourceForeground": "#8d92af",
    "gitDecoration.ignoredResourceForeground": "#676e95",
    "editorSuggestWidget.background": "#1c202c",
    "editorSuggestWidget.foreground": "#eeffff",
    "editorSuggestWidget.selectedBackground": "#4e5579",
    "editorSuggestWidget.highlightForeground": "#c792ea",
    "sideBar.background": "#3e4251",
    "activityBar.background": "#3e4251",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3a3e4d",
    "input.foreground": "#eeffff",
    "inlineChatInput.background": "#3a3e4d",
    "inlineChatInput.foreground": "#eeffff",
    "editorCursor.foreground": "#eeffff"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#676e95"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#676e95"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8d92af"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff5370"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1c1f2b",
        "background": "#ff5370"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#3c435e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
