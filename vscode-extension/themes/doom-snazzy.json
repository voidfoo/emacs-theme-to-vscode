{
  "name": "doom-snazzy",
  "type": "dark",
  "colors": {
    "editor.background": "#282a36",
    "panel.background": "#282a36",
    "editorGutter.background": "#282a36",
    "editor.foreground": "#f9f9f9",
    "editorCursor.background": "#57c7ff",
    "editor.selectionBackground": "#44464f40",
    "editor.findMatchBackground": "#3c8bb280",
    "editor.selectionHighlightBackground": "#848688",
    "editor.findMatchHighlightBackground": "#3c8bb2",
    "editor.wordHighlightStrongBackground": "#282a36",
    "editorLineNumber.foreground": "#3a3d4d",
    "editorLineNumber.activeForeground": "#f9f9f9",
    "input.placeholderForeground": "#57c7ff",
    "inlineChatInput.placeholderForeground": "#57c7ff",
    "statusBar.background": "#1e2029",
    "statusBarItem.remoteBackground": "#1e2029",
    "statusBar.noFolderBackground": "#20222c",
    "editorGroup.border": "#2e2f37",
    "editorGroupHeader.tabsBackground": "#1e2029",
    "diffEditor.insertedLineBackground": "#242631",
    "diffEditor.removedLineBackground": "#78787e",
    "diffEditor.insertedTextBackground": "#242631",
    "diffEditor.removedTextBackground": "#78787e",
    "editorSuggestWidget.background": "#1c1e27",
    "editorSuggestWidget.foreground": "#f9f9f9",
    "editorSuggestWidget.selectedBackground": "#459fcc",
    "editorSuggestWidget.highlightForeground": "#57c7ff",
    "sideBar.background": "#3e3f4a",
    "activityBar.background": "#3e3f4a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#393b46",
    "input.foreground": "#f9f9f9",
    "inlineChatInput.background": "#393b46",
    "inlineChatInput.foreground": "#f9f9f9",
    "editorCursor.foreground": "#f9f9f9",
    "statusBar.foreground": "#f9f9f9",
    "statusBarItem.remoteForeground": "#f9f9f9"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#fad5eb"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#fad5eb"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#fad5eb"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#fad5eb"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606580"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606580"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f3f99d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#f5fab5"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#5af78e"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff6ac1"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff6ac1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#ff6ac1"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#57c7ff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#87d6fd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ff5c57"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#fcaaa8"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#fcd2a4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#fcd2a4"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9aedfe"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#5af78e"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f3f99d"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff6ac1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f3f99d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff6ac1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff6ac1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff6ac1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f3f99d"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5c57"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff5c57"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#282a36",
        "background": "#ff5c57",
        "fontStyle": "bold"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#9aedfe"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#57c7ff"
      }
    }
  ]
}
