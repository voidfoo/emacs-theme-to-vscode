{
  "name": "doom-miramare",
  "type": "dark",
  "colors": {
    "editor.background": "#2a2426",
    "panel.background": "#2a2426",
    "editorGutter.background": "#2a2426",
    "editor.foreground": "#e6d6ac",
    "editorCursor.background": "#ffffff",
    "editor.selectionBackground": "#50494540",
    "editor.findMatchBackground": "#e39b7b80",
    "editor.selectionHighlightBackground": "#5b5b5b",
    "editor.findMatchHighlightBackground": "#d9bb80",
    "editor.wordHighlightStrongBackground": "#7c6f64",
    "editorLineNumber.foreground": "#7c6f64",
    "editorLineNumber.activeForeground": "#e6d6ac",
    "input.placeholderForeground": "#87c095",
    "inlineChatInput.placeholderForeground": "#87c095",
    "statusBar.background": "#504945",
    "statusBarItem.remoteBackground": "#504945",
    "statusBar.foreground": "#e1d7c0",
    "statusBarItem.remoteForeground": "#e1d7c0",
    "statusBar.noFolderBackground": "#2a2426",
    "editorGroup.border": "#5b5b5b",
    "editorGroupHeader.tabsBackground": "#504945",
    "diffEditor.insertedLineBackground": "#242021",
    "diffEditor.removedLineBackground": "#3c3836",
    "diffEditor.insertedTextBackground": "#242021",
    "diffEditor.removedTextBackground": "#3c3836",
    "breadcrumb.foreground": "#87af87",
    "gitDecoration.modifiedResourceForeground": "#d3a0bc",
    "gitDecoration.addedResourceForeground": "#729472",
    "gitDecoration.renamedResourceForeground": "#e1d7c0",
    "gitDecoration.untrackedResourceForeground": "#e1d7c0",
    "gitDecoration.ignoredResourceForeground": "#5b5b5b",
    "editorSuggestWidget.background": "#242021",
    "editorSuggestWidget.foreground": "#e6d6ac",
    "editorSuggestWidget.selectedBackground": "#504945",
    "editorSuggestWidget.highlightForeground": "#87c095",
    "sideBar.background": "#2e282a",
    "activityBar.background": "#2e282a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2d2729",
    "input.foreground": "#fdebbd",
    "inlineChatInput.background": "#2d2729",
    "inlineChatInput.foreground": "#fdebbd",
    "editorCursor.foreground": "#e6d6ac"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b5b5b"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b5b5b"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#87af87"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#e1d7c0"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d3a0bc"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e68183"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e39b7b"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#d9bb80"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d3a0bc"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3a0bc"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#87af87"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d9bb80"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e68183"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e68183"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "background": "#ff0000"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#87c095"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#89beba"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#d9bb80"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#313131"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#e68183"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#e68183"
      }
    }
  ]
}
