{
  "name": "doom-gruvbox-light",
  "type": "light",
  "colors": {
    "editor.background": "#fbf1c7",
    "panel.background": "#fbf1c7",
    "editorGutter.background": "#fbf1c7",
    "editor.foreground": "#282828",
    "editorCursor.background": "#a89984",
    "editor.selectionBackground": "#d9cea940",
    "editor.findMatchBackground": "#af3a0380",
    "editor.selectionHighlightBackground": "#928374",
    "editor.findMatchHighlightBackground": "#d5c4a1",
    "editor.wordHighlightStrongBackground": "#f0f0f0",
    "editorLineNumber.foreground": "#a89984",
    "editorLineNumber.activeForeground": "#af3a03",
    "input.placeholderForeground": "#a89984",
    "inlineChatInput.placeholderForeground": "#a89984",
    "statusBar.background": "#ebdbb2",
    "statusBarItem.remoteBackground": "#ebdbb2",
    "statusBar.noFolderBackground": "#e1d8b3",
    "editorGroup.border": "#d3c5a0",
    "editorGroupHeader.tabsBackground": "#ebdbb2",
    "diffEditor.insertedLineBackground": "#f2e5bc",
    "diffEditor.insertedTextBackground": "#f2e5bc",
    "breadcrumb.foreground": "#79740e",
    "gitDecoration.modifiedResourceForeground": "#8f3f71",
    "gitDecoration.addedResourceForeground": "#79740e",
    "gitDecoration.renamedResourceForeground": "#79740e",
    "gitDecoration.untrackedResourceForeground": "#79740e",
    "gitDecoration.ignoredResourceForeground": "#a89984",
    "editorSuggestWidget.background": "#f2e5bc",
    "editorSuggestWidget.selectedBackground": "#d5c4a1",
    "editorSuggestWidget.highlightForeground": "#076678",
    "sideBar.background": "#e2d9b3",
    "activityBar.background": "#e2d9b3",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#ddd4af",
    "input.foreground": "#242424",
    "inlineChatInput.background": "#ddd4af",
    "inlineChatInput.foreground": "#242424",
    "editorCursor.foreground": "#282828",
    "statusBar.foreground": "#242424",
    "statusBarItem.remoteForeground": "#242424"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a89984"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a89984"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#79740e"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#79740e"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#8f3f71"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9d0006"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#af3a03"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b57614"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b57614"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#8f3f71"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8f3f71"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8f3f71"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#79740e"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#af3a03"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#9d0006"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#9d0006"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "background": "#9d0006"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#427b58"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#9d0006"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#ebdbb2"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#b16286"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#9d0006"
      }
    }
  ]
}
