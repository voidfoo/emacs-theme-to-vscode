{
  "name": "doom-plain",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "panel.background": "#ffffff",
    "editorGutter.background": "#ffffff",
    "editor.foreground": "#282a2e",
    "editorCursor.background": "#444444",
    "editor.selectionBackground": "#e7e7e740",
    "editor.findMatchBackground": "#c6c6c680",
    "editor.selectionHighlightBackground": "#282a2e",
    "editor.findMatchHighlightBackground": "#c6c6c6",
    "editor.wordHighlightStrongBackground": "#969896",
    "editorLineNumber.foreground": "#cccccc",
    "editorLineNumber.activeForeground": "#444444",
    "input.placeholderForeground": "#444444",
    "inlineChatInput.placeholderForeground": "#444444",
    "statusBar.background": "#cecece",
    "statusBarItem.remoteBackground": "#cecece",
    "statusBar.foreground": "#282a2e",
    "statusBarItem.remoteForeground": "#282a2e",
    "statusBar.noFolderBackground": "#dadada",
    "editorGroup.border": "#c5c8c6",
    "editorGroupHeader.tabsBackground": "#cecece",
    "diffEditor.insertedLineBackground": "#fafafa",
    "diffEditor.removedLineBackground": "#cccccc",
    "diffEditor.insertedTextBackground": "#fafafa",
    "diffEditor.removedTextBackground": "#cccccc",
    "breadcrumb.foreground": "#969896",
    "gitDecoration.modifiedResourceForeground": "#282a2e",
    "gitDecoration.addedResourceForeground": "#bebfc0",
    "gitDecoration.renamedResourceForeground": "#c5c8c6",
    "gitDecoration.untrackedResourceForeground": "#c5c8c6",
    "gitDecoration.ignoredResourceForeground": "#c5c8c6",
    "editorSuggestWidget.background": "#f3f3f3",
    "editorSuggestWidget.foreground": "#282a2e",
    "editorSuggestWidget.selectedBackground": "#f1f3f5",
    "editorSuggestWidget.highlightForeground": "#444444",
    "sideBar.background": "#e6e6e6",
    "activityBar.background": "#e6e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0e0e0",
    "input.foreground": "#282a2e",
    "inlineChatInput.background": "#e0e0e0",
    "inlineChatInput.foreground": "#282a2e",
    "editorCursor.foreground": "#282a2e"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#282a2e"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#969896",
        "background": "#282a2e"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#cccccc"
      }
    }
  ]
}
