{
  "name": "doom-monokai-octagon",
  "type": "dark",
  "colors": {
    "editor.background": "#282a3a",
    "panel.background": "#282a3a",
    "editorGutter.background": "#282a3a",
    "editor.foreground": "#eaf2f1",
    "editorCursor.background": "#eaf2f1",
    "editor.selectionBackground": "#3a3d4b40",
    "editor.findMatchBackground": "#3a3d4b80",
    "editor.selectionHighlightBackground": "#535763",
    "editor.findMatchHighlightBackground": "#3a3d4b",
    "editorLineNumber.foreground": "#535763",
    "editorLineNumber.activeForeground": "#888d94",
    "input.placeholderForeground": "#ffd76d",
    "inlineChatInput.placeholderForeground": "#ffd76d",
    "statusBar.background": "#3a3d4b",
    "statusBarItem.remoteBackground": "#3a3d4b",
    "statusBar.foreground": "#eaf2f1",
    "statusBarItem.remoteForeground": "#eaf2f1",
    "statusBar.noFolderBackground": "#282a3a",
    "editorGroup.border": "#3d3f4d",
    "editorGroupHeader.tabsBackground": "#3a3d4b",
    "diffEditor.insertedLineBackground": "#3a3d4b",
    "diffEditor.removedLineBackground": "#3a3d4b",
    "diffEditor.insertedTextBackground": "#3a3d4b",
    "diffEditor.removedTextBackground": "#3a3d4b",
    "breadcrumb.foreground": "#ffd76d",
    "gitDecoration.modifiedResourceForeground": "#c39ac9",
    "gitDecoration.addedResourceForeground": "#bad761",
    "gitDecoration.renamedResourceForeground": "#ff95be",
    "gitDecoration.untrackedResourceForeground": "#ff95be",
    "gitDecoration.ignoredResourceForeground": "#696d77",
    "editorSuggestWidget.background": "#1e1f2b",
    "editorSuggestWidget.foreground": "#eaf2f1",
    "editorSuggestWidget.selectedBackground": "#2e313d",
    "editorSuggestWidget.highlightForeground": "#ffd76d",
    "sideBar.background": "#2c2e40",
    "activityBar.background": "#2c2e40",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2b2d3f",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#2b2d3f",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#eaf2f1"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#696d77"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#696d77"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffd76d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8e9199"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c39ac9"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9cd1bb"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#c39ac9"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bad761"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bad761"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9cd1bb"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#c39ac9"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#c39ac9"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ffd76d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff95be"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff657a"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#9cd1bb"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#9cd1bb"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffd76d"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#373a45"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#9cd1bb"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff657a"
      }
    }
  ]
}
