{
  "name": "dichromacy",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "panel.background": "#ffffff",
    "editorGutter.background": "#ffffff",
    "editor.foreground": "#000000",
    "editorCursor.background": "#000000",
    "editor.selectionBackground": "#f8ec5940",
    "editor.findMatchBackground": "#d55e0080",
    "editor.selectionHighlightBackground": "#e5e5e5",
    "editor.findMatchHighlightBackground": "#cc79a7",
    "editor.wordHighlightStrongBackground": "#40e0d0",
    "editorLineNumber.foreground": "#7f7f7f",
    "editorLineNumber.activeForeground": "#7f7f7f",
    "input.placeholderForeground": "#0072b2",
    "inlineChatInput.placeholderForeground": "#0072b2",
    "statusBar.background": "#e5e5e5",
    "statusBarItem.remoteBackground": "#e5e5e5",
    "statusBar.foreground": "#000000",
    "statusBarItem.remoteForeground": "#000000",
    "statusBar.noFolderBackground": "#b0b0b0",
    "editorGroupHeader.tabsBackground": "#e6e6e6",
    "diffEditor.insertedLineBackground": "#eeffee",
    "diffEditor.removedLineBackground": "#ffeeee",
    "diffEditor.insertedTextBackground": "#bbffbb",
    "diffEditor.removedTextBackground": "#ffcccc",
    "breadcrumb.foreground": "#d55e00",
    "gitDecoration.modifiedResourceForeground": "#e69f00",
    "gitDecoration.addedResourceForeground": "#0072b2",
    "gitDecoration.renamedResourceForeground": "#848ea9",
    "gitDecoration.untrackedResourceForeground": "#848ea9",
    "gitDecoration.ignoredResourceForeground": "#009e73",
    "editorSuggestWidget.background": "#fff8dc",
    "editorSuggestWidget.foreground": "#000000",
    "editorSuggestWidget.selectedBackground": "#add8e6",
    "editorSuggestWidget.highlightForeground": "#8b0000",
    "sideBar.background": "#e6e6e6",
    "activityBar.background": "#e6e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0e0e0",
    "input.foreground": "#000000",
    "inlineChatInput.background": "#e0e0e0",
    "inlineChatInput.foreground": "#000000",
    "editorCursor.foreground": "#000000"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#009e73"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#009e73"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#848ea9"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#848ea9"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#56b4e9"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#0072b2"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e69f00"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e69f00"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#e69f00"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#e69f00"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#0072b2"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#848ea9"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#0072b2"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#d55e00"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#a020f0"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#d9d9d9"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#bfbfbf"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#d55e00"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#848ea9"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#7f7f7f"
      }
    }
  ]
}
