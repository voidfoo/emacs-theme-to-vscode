{
  "name": "ef-maris-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#131c2b",
    "panel.background": "#131c2b",
    "editorGutter.background": "#131c2b",
    "editor.foreground": "#eaedef",
    "editorCursor.background": "#8fdfff",
    "editor.selectionBackground": "#183c6540",
    "editor.findMatchBackground": "#84702080",
    "editor.selectionHighlightBackground": "#49516a",
    "editor.findMatchHighlightBackground": "#2f5f9f",
    "editor.wordHighlightStrongBackground": "#6c5d54",
    "editorLineNumber.foreground": "#969faf",
    "editorLineNumber.activeForeground": "#12b4ff",
    "input.placeholderForeground": "#70a0ff",
    "inlineChatInput.placeholderForeground": "#70a0ff",
    "statusBar.background": "#2f527b",
    "statusBarItem.remoteBackground": "#2f527b",
    "statusBar.foreground": "#ecf0ff",
    "statusBarItem.remoteForeground": "#ecf0ff",
    "statusBar.noFolderBackground": "#2a3644",
    "editorGroup.border": "#595a63",
    "editorGroupHeader.tabsBackground": "#1d2c39",
    "diffEditor.insertedLineBackground": "#20493f",
    "diffEditor.removedLineBackground": "#5e242f",
    "diffEditor.insertedTextBackground": "#136244",
    "diffEditor.removedTextBackground": "#772a35",
    "editorSuggestWidget.background": "#19263a",
    "editorSuggestWidget.selectedBackground": "#204358",
    "editorSuggestWidget.highlightForeground": "#12b4ff",
    "sideBar.background": "#2b3340",
    "activityBar.background": "#2b3340",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#262e3c",
    "input.foreground": "#eaedef",
    "inlineChatInput.background": "#262e3c",
    "inlineChatInput.foreground": "#eaedef",
    "editorCursor.foreground": "#eaedef"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#eaa4a4"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#eaa4a4"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#65d5a8"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#99bfcf"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d4aaf0"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#70a0ff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff7a5f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#d4aaf0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7fce5f"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a9c99f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#2fd0db"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#99bfcf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#2fd0db"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#2fd0db"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#41bf4f"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#12b4ff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d0d24f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#65d5a8"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff6f6f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#d0d24f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#cf90ff"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f0c060"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7a5f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#847020"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7a5f",
        "background": "#551327"
      }
    }
  ]
}
