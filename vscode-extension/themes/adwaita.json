{
  "name": "adwaita",
  "type": "light",
  "colors": {
    "editor.background": "#ededed",
    "panel.background": "#ededed",
    "editorGutter.background": "#ededed",
    "editor.foreground": "#2e3436",
    "editorCursor.background": "#00bbff",
    "editor.selectionBackground": "#c2d5e940",
    "editor.findMatchBackground": "#77a4dd80",
    "editor.selectionHighlightBackground": "#ffff00",
    "editor.findMatchHighlightBackground": "#afeeee",
    "editor.wordHighlightStrongBackground": "#40e0d0",
    "editorLineNumber.foreground": "#7f7f7f",
    "editorLineNumber.activeForeground": "#7f7f7f",
    "input.placeholderForeground": "#0084c8",
    "inlineChatInput.placeholderForeground": "#0084c8",
    "statusBar.background": "#ffffff",
    "statusBarItem.remoteBackground": "#ffffff",
    "statusBar.foreground": "#2e3436",
    "statusBarItem.remoteForeground": "#2e3436",
    "statusBar.noFolderBackground": "#ffffff",
    "editorGroupHeader.tabsBackground": "#000000",
    "diffEditor.insertedTextBackground": "#bbffbb",
    "diffEditor.removedTextBackground": "#ffcccc",
    "breadcrumb.foreground": "#f5666d",
    "gitDecoration.modifiedResourceForeground": "#0084c8",
    "gitDecoration.addedResourceForeground": "#2f8b58",
    "gitDecoration.renamedResourceForeground": "#4e9a06",
    "gitDecoration.untrackedResourceForeground": "#4e9a06",
    "gitDecoration.ignoredResourceForeground": "#204a87",
    "editorSuggestWidget.background": "#fff8dc",
    "editorSuggestWidget.foreground": "#000000",
    "editorSuggestWidget.selectedBackground": "#add8e6",
    "editorSuggestWidget.highlightForeground": "#8b0000",
    "sideBar.background": "#d5d5d5",
    "activityBar.background": "#d5d5d5",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d1d1d1",
    "input.foreground": "#202426",
    "inlineChatInput.background": "#d1d1d1",
    "inlineChatInput.foreground": "#202426",
    "editorCursor.foreground": "#2e3436"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#204a87"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#204a87"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4e9a06"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#4e9a06"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#f5666d"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a52a2a"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#a020f0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00578e"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00578e"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#0084c8"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#0084c8"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#0084c8"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#0084c8"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#2f8b58"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f5666d"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4e9a06"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#a020f0"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5666d"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b50000"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff0000"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#a020f0"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#d9d9d9"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#bfbfbf"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#00578e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4e9a06"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#7f7f7f"
      }
    }
  ]
}
