{
  "name": "doom-laserwave",
  "type": "dark",
  "colors": {
    "editor.background": "#27212e",
    "panel.background": "#27212e",
    "editorGutter.background": "#27212e",
    "editor.foreground": "#ffffff",
    "editorCursor.background": "#eb64b9",
    "editor.selectionBackground": "#4e2e4940",
    "editor.findMatchBackground": "#8c3c6e80",
    "editor.selectionHighlightBackground": "#4e415c",
    "editor.findMatchHighlightBackground": "#8c3c6e",
    "editor.wordHighlightStrongBackground": "#1f1a24",
    "editorLineNumber.foreground": "#4e415c",
    "editorLineNumber.activeForeground": "#ffffff",
    "input.placeholderForeground": "#eb64b9",
    "inlineChatInput.placeholderForeground": "#eb64b9",
    "statusBar.background": "#ed60ba",
    "statusBarItem.remoteBackground": "#ed60ba",
    "statusBar.foreground": "#1b1720",
    "statusBarItem.remoteForeground": "#1b1720",
    "statusBar.noFolderBackground": "#231d29",
    "editorGroup.border": "#1c1e24",
    "editorGroupHeader.tabsBackground": "#ed60ba",
    "diffEditor.insertedLineBackground": "#1b1720",
    "diffEditor.removedLineBackground": "#3e3549",
    "diffEditor.insertedTextBackground": "#1b1720",
    "diffEditor.removedTextBackground": "#3e3549",
    "breadcrumb.foreground": "#b4dce7",
    "gitDecoration.modifiedResourceForeground": "#b381c5",
    "gitDecoration.addedResourceForeground": "#74dfc4",
    "gitDecoration.renamedResourceForeground": "#919ea7",
    "gitDecoration.untrackedResourceForeground": "#919ea7",
    "gitDecoration.ignoredResourceForeground": "#91889b",
    "editorSuggestWidget.background": "#1b1720",
    "editorSuggestWidget.foreground": "#ffffff",
    "editorSuggestWidget.selectedBackground": "#336a79",
    "editorSuggestWidget.highlightForeground": "#eb64b9",
    "sideBar.background": "#2b2433",
    "activityBar.background": "#2b2433",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2a2432",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#2a2432",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#91889b"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#91889b"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b4dce7"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#919ea7"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#b381c5"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#eb64b9"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#eb64b9"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#eb64b9"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ffe261"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#b381c5"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffb85b"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b4dce7"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffe261"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#964c7b"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#964c7b"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#222228",
        "background": "#964c7b"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#b4dce7"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#40b4c4"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#eb64b9"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#3e3549"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#91889b"
      }
    }
  ]
}
