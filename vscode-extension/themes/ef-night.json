{
  "name": "ef-night",
  "type": "dark",
  "colors": {
    "editor.background": "#000e17",
    "panel.background": "#000e17",
    "editorGutter.background": "#000e17",
    "editor.foreground": "#afbcbf",
    "editorCursor.background": "#00ccff",
    "editor.selectionBackground": "#25314640",
    "editor.findMatchBackground": "#84702080",
    "editor.selectionHighlightBackground": "#493737",
    "editor.findMatchHighlightBackground": "#2f5f9f",
    "editor.wordHighlightStrongBackground": "#664950",
    "editorLineNumber.foreground": "#70819f",
    "editorLineNumber.activeForeground": "#029fff",
    "input.placeholderForeground": "#6fafff",
    "inlineChatInput.placeholderForeground": "#6fafff",
    "statusBar.background": "#003a7f",
    "statusBarItem.remoteBackground": "#003a7f",
    "statusBar.foreground": "#ceeeff",
    "statusBarItem.remoteForeground": "#ceeeff",
    "statusBar.noFolderBackground": "#242e39",
    "editorGroup.border": "#3a4a66",
    "editorGroupHeader.tabsBackground": "#1a202b",
    "diffEditor.insertedLineBackground": "#00371f",
    "diffEditor.removedLineBackground": "#450f1f",
    "diffEditor.insertedTextBackground": "#004c2f",
    "diffEditor.removedTextBackground": "#641426",
    "editorSuggestWidget.background": "#001c2f",
    "editorSuggestWidget.selectedBackground": "#043957",
    "editorSuggestWidget.highlightForeground": "#029fff",
    "sideBar.background": "#1a262e",
    "activityBar.background": "#1a262e",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#14212a",
    "input.foreground": "#afbcbf",
    "inlineChatInput.background": "#14212a",
    "inlineChatInput.foreground": "#afbcbf",
    "editorCursor.foreground": "#afbcbf"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cf9f7f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cf9f7f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#029fff"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#92b4df"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c59fcf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6a88ff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ef656a"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#00a972"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3dc0b0"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#92b4df"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6fafff"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#92b4df"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6fafff",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6fafff"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#c59fcf"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#af8aff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#1fa526"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#029fff"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#e580ea"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#1fa526"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#d56f72"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e6832f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef656a"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#847020"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef656a",
        "background": "#471014"
      }
    }
  ]
}
