{
  "name": "doom-moonlight",
  "type": "dark",
  "colors": {
    "editor.background": "#212337",
    "panel.background": "#212337",
    "editorGutter.background": "#1f2033",
    "editor.foreground": "#c8d3f5",
    "editorCursor.background": "#82aaff",
    "editor.selectionBackground": "#383e5c40",
    "editor.findMatchBackground": "#2f334d80",
    "editor.selectionHighlightBackground": "#444a73",
    "editor.findMatchHighlightBackground": "#2f334d",
    "editor.wordHighlightStrongBackground": "#161a2a",
    "editorLineNumber.foreground": "#444a73",
    "editorLineNumber.activeForeground": "#c8d3f5",
    "input.placeholderForeground": "#82aaff",
    "inlineChatInput.placeholderForeground": "#82aaff",
    "statusBar.background": "#1b1c2b",
    "statusBarItem.remoteBackground": "#1b1c2b",
    "statusBar.foreground": "#b4c2f0",
    "statusBarItem.remoteForeground": "#b4c2f0",
    "statusBar.noFolderBackground": "#1d1f31",
    "editorGroup.border": "#161a2a",
    "editorGroupHeader.tabsBackground": "#1b1c2b",
    "diffEditor.insertedLineBackground": "#2f334d",
    "diffEditor.removedLineBackground": "#222436",
    "diffEditor.insertedTextBackground": "#2f334d",
    "diffEditor.removedTextBackground": "#222436",
    "breadcrumb.foreground": "#c3e88d",
    "gitDecoration.modifiedResourceForeground": "#82aaff",
    "gitDecoration.addedResourceForeground": "#77e0c6",
    "gitDecoration.renamedResourceForeground": "#9ba5db",
    "gitDecoration.untrackedResourceForeground": "#9ba5db",
    "gitDecoration.ignoredResourceForeground": "#7a88cf",
    "editorSuggestWidget.background": "#161a2a",
    "editorSuggestWidget.foreground": "#c8d3f5",
    "editorSuggestWidget.selectedBackground": "#383e5c",
    "editorSuggestWidget.highlightForeground": "#82aaff",
    "sideBar.background": "#24273d",
    "activityBar.background": "#24273d",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#24263b",
    "input.foreground": "#dce8ff",
    "inlineChatInput.background": "#24263b",
    "inlineChatInput.foreground": "#dce8ff",
    "editorCursor.foreground": "#c8d3f5"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a88cf"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a88cf"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9ba5db"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#ff995e"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c099ff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#86e1fc"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#c099ff"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ff98a4"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ff98a4"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#ff98a4"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#ff98a4"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ffc777"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff995e"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff995e"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#86e1fc"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#86e1fc"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#86e1fc"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#86e1fc"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffc777"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff757f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff757f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#161a2a",
        "background": "#ff757f"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#b4f9f8"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffc777"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#222436"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ff995e"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff757f"
      }
    }
  ]
}
