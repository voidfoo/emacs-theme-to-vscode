{
  "name": "tango-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#2e3436",
    "panel.background": "#2e3436",
    "editorGutter.background": "#2e3436",
    "editor.foreground": "#eeeeec",
    "editorCursor.background": "#fce94f",
    "editor.selectionBackground": "#55575340",
    "editor.findMatchBackground": "#ce5c0080",
    "editor.selectionHighlightBackground": "#204a87",
    "editor.findMatchHighlightBackground": "#8f5902",
    "editor.wordHighlightStrongBackground": "#4f94cd",
    "editorLineNumber.foreground": "#b3b3b3",
    "editorLineNumber.activeForeground": "#b3b3b3",
    "input.placeholderForeground": "#b4fa70",
    "inlineChatInput.placeholderForeground": "#b4fa70",
    "statusBar.background": "#d3d7cf",
    "statusBarItem.remoteBackground": "#d3d7cf",
    "statusBar.foreground": "#2e3436",
    "statusBarItem.remoteForeground": "#2e3436",
    "statusBar.noFolderBackground": "#555753",
    "editorGroupHeader.tabsBackground": "#666666",
    "diffEditor.insertedLineBackground": "#33553340",
    "diffEditor.removedLineBackground": "#55333340",
    "diffEditor.insertedTextBackground": "#2288224d",
    "diffEditor.removedTextBackground": "#8822224d",
    "editorSuggestWidget.background": "#424242",
    "editorSuggestWidget.selectedBackground": "#4f4f4f",
    "editorSuggestWidget.highlightForeground": "#afeeee",
    "sideBar.background": "#43484a",
    "activityBar.background": "#43484a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3f4446",
    "input.foreground": "#eeeeec",
    "inlineChatInput.background": "#3f4446",
    "inlineChatInput.foreground": "#eeeeec",
    "editorCursor.foreground": "#eeeeec"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#73d216"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#73d216"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e9b96e"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#e9b96e"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#e9b2e3"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b4fa70"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#e090d7"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#fce94f"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fce94f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#fcaf3e"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#fcaf3e"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#fcaf3e",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#fcaf3e"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#8cc4ff"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e9b2e3"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e9b96e"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#e090d7"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff4b4b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff4b4b"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#737373"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#999999",
        "fontStyle": "bold"
      }
    },
    {
      "name": "diff-added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "background": "#335533"
      }
    },
    {
      "name": "diff-removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "background": "#553333"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#fce94f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#e9b96e"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#b3b3b3"
      }
    }
  ]
}
