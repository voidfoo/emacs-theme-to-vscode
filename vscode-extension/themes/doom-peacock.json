{
  "name": "doom-peacock",
  "type": "dark",
  "colors": {
    "editor.background": "#2b2a27",
    "panel.background": "#2b2a27",
    "editorGutter.background": "#2b2a27",
    "editor.foreground": "#ede0ce",
    "editorCursor.background": "#ff5d38",
    "editor.selectionBackground": "#403f3e40",
    "editor.findMatchBackground": "#b2412780",
    "editor.selectionHighlightBackground": "#3f444a",
    "editor.findMatchHighlightBackground": "#b24127",
    "editor.wordHighlightStrongBackground": "#2b2a27",
    "editorLineNumber.foreground": "#3f444a",
    "editorLineNumber.activeForeground": "#9ca0a4",
    "input.placeholderForeground": "#ff5d38",
    "inlineChatInput.placeholderForeground": "#ff5d38",
    "statusBar.background": "#1b1b1a",
    "statusBarItem.remoteBackground": "#1b1b1a",
    "statusBar.noFolderBackground": "#262523",
    "editorGroup.border": "#403f3c",
    "editorGroupHeader.tabsBackground": "#1b1b1a",
    "diffEditor.insertedLineBackground": "#1f1e1d",
    "diffEditor.removedLineBackground": "#23272e",
    "diffEditor.insertedTextBackground": "#1f1e1d",
    "diffEditor.removedTextBackground": "#23272e",
    "breadcrumb.foreground": "#bcd42a",
    "gitDecoration.modifiedResourceForeground": "#a9a1e1",
    "gitDecoration.addedResourceForeground": "#98be65",
    "gitDecoration.renamedResourceForeground": "#83898d",
    "gitDecoration.untrackedResourceForeground": "#83898d",
    "gitDecoration.ignoredResourceForeground": "#5b6268",
    "editorSuggestWidget.background": "#1f1e1d",
    "editorSuggestWidget.foreground": "#ede0ce",
    "editorSuggestWidget.selectedBackground": "#a60033",
    "editorSuggestWidget.highlightForeground": "#ff5d38",
    "sideBar.background": "#403f3d",
    "activityBar.background": "#403f3d",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3c3b38",
    "input.foreground": "#ede0ce",
    "inlineChatInput.background": "#3c3b38",
    "inlineChatInput.foreground": "#ede0ce",
    "editorCursor.foreground": "#ede0ce",
    "statusBar.foreground": "#ede0ce",
    "statusBarItem.remoteForeground": "#ede0ce"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b6268"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b6268"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#bcd42a"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#83898d"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#26a6a6"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bcd42a"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bcd42a"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f8f8f0"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#f8f8f0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#f8f8f0"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#f8f8f0"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#f8f8f0"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#bcd42a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#bcd42a"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff5d38"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#2b2a27",
        "background": "#ff5d38"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#46d9ff"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#51afef"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#2e3138"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff5d38"
      }
    }
  ]
}
