{
  "name": "doom-shades-of-purple",
  "type": "dark",
  "colors": {
    "editor.background": "#2d2b55",
    "panel.background": "#2d2b55",
    "editorGutter.background": "#2d2b55",
    "editor.foreground": "#e3e9fa",
    "editorCursor.background": "#82aaff",
    "editor.selectionBackground": "#b362ff40",
    "editor.findMatchBackground": "#b362ff80",
    "editor.selectionHighlightBackground": "#444a73",
    "editor.findMatchHighlightBackground": "#b362ff",
    "editor.wordHighlightStrongBackground": "#161a2a",
    "editorLineNumber.foreground": "#444a73",
    "editorLineNumber.activeForeground": "#e3e9fa",
    "input.placeholderForeground": "#82aaff",
    "inlineChatInput.placeholderForeground": "#82aaff",
    "statusBar.background": "#1b1b38",
    "statusBarItem.remoteBackground": "#1b1b38",
    "statusBar.foreground": "#b4c2f0",
    "statusBarItem.remoteForeground": "#b4c2f0",
    "statusBar.noFolderBackground": "#28264c",
    "editorGroup.border": "#1e1e3f",
    "editorGroupHeader.tabsBackground": "#1b1b38",
    "diffEditor.insertedLineBackground": "#1e1e3f",
    "diffEditor.removedLineBackground": "#222436",
    "diffEditor.insertedTextBackground": "#1e1e3f",
    "diffEditor.removedTextBackground": "#222436",
    "breadcrumb.foreground": "#a5ff90",
    "gitDecoration.modifiedResourceForeground": "#82aaff",
    "gitDecoration.addedResourceForeground": "#00ff00",
    "gitDecoration.renamedResourceForeground": "#c589ff",
    "gitDecoration.untrackedResourceForeground": "#c589ff",
    "gitDecoration.ignoredResourceForeground": "#b362ff",
    "editorSuggestWidget.background": "#161a2a",
    "editorSuggestWidget.foreground": "#e3e9fa",
    "editorSuggestWidget.selectedBackground": "#b362ff",
    "editorSuggestWidget.highlightForeground": "#82aaff",
    "sideBar.background": "#424066",
    "activityBar.background": "#424066",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3e3c63",
    "input.foreground": "#e3e9fa",
    "inlineChatInput.background": "#3e3c63",
    "inlineChatInput.foreground": "#e3e9fa",
    "editorCursor.foreground": "#e3e9fa"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b362ff"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b362ff"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a5ff90"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#c589ff"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#fb94ff"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fad726"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fad726"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#37fea1"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#37fea1"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#37fea1"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#37fea1"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#3ad900"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fb94ff"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a5ff90"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#fad000"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff000d"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff000d"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#161a2a",
        "background": "#ff000d"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#ff628c"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#fad000"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#222436"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ff9d00"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff000d"
      }
    }
  ]
}
