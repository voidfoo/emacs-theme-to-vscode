{
  "name": "doom-old-hope",
  "type": "dark",
  "colors": {
    "editor.background": "#1c1d20",
    "panel.background": "#1c1d20",
    "editorGutter.background": "#1c1d20",
    "editor.foreground": "#cbccd1",
    "editorCursor.background": "#fedd38",
    "editor.selectionBackground": "#38383b40",
    "editor.findMatchBackground": "#b19a2780",
    "editor.selectionHighlightBackground": "#3f444a",
    "editor.findMatchHighlightBackground": "#b19a27",
    "editor.wordHighlightStrongBackground": "#1b2229",
    "editorLineNumber.foreground": "#3f444a",
    "editorLineNumber.activeForeground": "#cbccd1",
    "input.placeholderForeground": "#fedd38",
    "inlineChatInput.placeholderForeground": "#fedd38",
    "statusBar.background": "#0d0e10",
    "statusBarItem.remoteBackground": "#0d0e10",
    "statusBar.foreground": "#cbccd1",
    "statusBarItem.remoteForeground": "#cbccd1",
    "statusBar.noFolderBackground": "#1b1c1f",
    "editorGroup.border": "#32363b",
    "editorGroupHeader.tabsBackground": "#0d0e10",
    "diffEditor.insertedLineBackground": "#151619",
    "diffEditor.removedLineBackground": "#23272e",
    "diffEditor.insertedTextBackground": "#151619",
    "diffEditor.removedTextBackground": "#23272e",
    "breadcrumb.foreground": "#4fb3d8",
    "gitDecoration.modifiedResourceForeground": "#b978ab",
    "gitDecoration.addedResourceForeground": "#78bd65",
    "gitDecoration.renamedResourceForeground": "#7bc5e1",
    "gitDecoration.untrackedResourceForeground": "#7bc5e1",
    "gitDecoration.ignoredResourceForeground": "#5b6268",
    "editorSuggestWidget.background": "#151619",
    "editorSuggestWidget.foreground": "#cbccd1",
    "editorSuggestWidget.selectedBackground": "#ea3d54",
    "editorSuggestWidget.highlightForeground": "#fedd38",
    "sideBar.background": "#333436",
    "activityBar.background": "#333436",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2e2f32",
    "input.foreground": "#cbccd1",
    "inlineChatInput.background": "#2e2f32",
    "inlineChatInput.foreground": "#cbccd1",
    "editorCursor.foreground": "#cbccd1"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b6268"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b6268"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4fb3d8"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7bc5e1"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#ee7b29"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ea3d54"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#78bd65"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#fedd38"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fedd38"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fedd38"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ee7b29"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ee7b29"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ee7b29"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#78bd65"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4fb3d8"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#78bd65"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#78bd65"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#78bd65"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#fedd38"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ea3d54"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ea3d54"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1b2229",
        "background": "#ea3d54"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#4fb3d8"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#4fb3d8"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ea3d54"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#2e3138"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#b978ab"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#78bd65"
      }
    }
  ]
}
