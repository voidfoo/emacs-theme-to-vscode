{
  "name": "doom-tomorrow-night",
  "type": "dark",
  "colors": {
    "editor.background": "#1d1f21",
    "panel.background": "#1d1f21",
    "editorGutter.background": "#1d1f21",
    "editor.foreground": "#c5c8c6",
    "editorCursor.background": "#81a2be",
    "editor.selectionBackground": "#33353740",
    "editor.findMatchBackground": "#5a718580",
    "editor.selectionHighlightBackground": "#5a5b5a",
    "editor.findMatchHighlightBackground": "#5a7185",
    "editor.wordHighlightStrongBackground": "#0d0d0d",
    "editorLineNumber.foreground": "#3f4040",
    "editorLineNumber.activeForeground": "#81a2be",
    "input.placeholderForeground": "#81a2be",
    "inlineChatInput.placeholderForeground": "#81a2be",
    "statusBar.background": "#0f1011",
    "statusBarItem.remoteBackground": "#0f1011",
    "statusBar.foreground": "#ffffff",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBar.noFolderBackground": "#1d1f21",
    "editorGroup.border": "#0d0d0d",
    "editorGroupHeader.tabsBackground": "#0f1011",
    "diffEditor.insertedLineBackground": "#161719",
    "diffEditor.removedLineBackground": "#292b2b",
    "diffEditor.insertedTextBackground": "#161719",
    "diffEditor.removedTextBackground": "#292b2b",
    "breadcrumb.foreground": "#b5bd68",
    "gitDecoration.modifiedResourceForeground": "#b294bb",
    "gitDecoration.addedResourceForeground": "#b5bd68",
    "gitDecoration.renamedResourceForeground": "#717171",
    "gitDecoration.untrackedResourceForeground": "#717171",
    "gitDecoration.ignoredResourceForeground": "#5a5b5a",
    "editorSuggestWidget.background": "#161719",
    "editorSuggestWidget.foreground": "#c5c8c6",
    "editorSuggestWidget.selectedBackground": "#333537",
    "editorSuggestWidget.highlightForeground": "#81a2be",
    "sideBar.background": "#343537",
    "activityBar.background": "#343537",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2f3133",
    "input.foreground": "#c5c8c6",
    "inlineChatInput.background": "#2f3133",
    "inlineChatInput.foreground": "#c5c8c6",
    "editorCursor.foreground": "#c5c8c6"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a5b5a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a5b5a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b5bd68"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#717171"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#de935f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b294bb"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#f0c674"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#de935f"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#de935f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b5bd68"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f0c674"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#cc6666"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#0d0d0d",
        "background": "#cc6666"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#8abeb7"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#292b2b"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#c9b4cf"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    }
  ]
}
