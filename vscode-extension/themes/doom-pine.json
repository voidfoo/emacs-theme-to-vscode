{
  "name": "doom-pine",
  "type": "dark",
  "colors": {
    "editor.background": "#0c1400",
    "panel.background": "#0c1400",
    "editorGutter.background": "#0c1400",
    "editor.foreground": "#d5c9b0",
    "editorCursor.background": "#85897f",
    "editor.selectionBackground": "#222b1440",
    "editor.findMatchBackground": "#fe801980",
    "editor.selectionHighlightBackground": "#1d290c",
    "editor.findMatchHighlightBackground": "#e5aa2b",
    "editor.wordHighlightStrongBackground": "#49503d",
    "editorLineNumber.foreground": "#49503d",
    "editorLineNumber.activeForeground": "#d5c9b0",
    "input.placeholderForeground": "#8ec07c",
    "inlineChatInput.placeholderForeground": "#8ec07c",
    "statusBar.background": "#222b14",
    "statusBarItem.remoteBackground": "#222b14",
    "statusBar.foreground": "#353e29",
    "statusBarItem.remoteForeground": "#353e29",
    "statusBar.noFolderBackground": "#121e00",
    "editorGroup.border": "#222b14",
    "editorGroupHeader.tabsBackground": "#222b14",
    "diffEditor.insertedLineBackground": "#121e0040",
    "diffEditor.removedLineBackground": "#121e0040",
    "diffEditor.insertedTextBackground": "#121e004d",
    "diffEditor.removedTextBackground": "#121e004d",
    "editorSuggestWidget.background": "#121e00",
    "editorSuggestWidget.foreground": "#d5c9b0",
    "editorSuggestWidget.selectedBackground": "#222b14",
    "editorSuggestWidget.highlightForeground": "#8ec07c",
    "sideBar.background": "#242c1a",
    "activityBar.background": "#242c1a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#1f2714",
    "input.foreground": "#d5c9b0",
    "inlineChatInput.background": "#1f2714",
    "inlineChatInput.foreground": "#d5c9b0",
    "editorCursor.foreground": "#d5c9b0"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#c3c6a3"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#c3c6a3"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#c3c6a3"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#c3c6a3"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#49503d"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#49503d"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#86914e"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#dfd2b8"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ce4e2b"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a3c28b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#b1c496"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#d07f60",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#d07f60"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#e5aa2b"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#86914e"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e5aa2b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ce4e2b"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "name": "diff-added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#86914e",
        "background": "#121e00"
      }
    },
    {
      "name": "diff-removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ce4e2b",
        "background": "#121e00"
      }
    },
    {
      "name": "diff-changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#d5c4a1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#161e0b"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ce4e2b"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ce4e2b"
      }
    }
  ]
}
