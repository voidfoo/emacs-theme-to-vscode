{
  "name": "ef-light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "panel.background": "#ffffff",
    "editorGutter.background": "#ffffff",
    "editor.foreground": "#202020",
    "editorCursor.background": "#0033cc",
    "editor.selectionBackground": "#bfefff40",
    "editor.findMatchBackground": "#fac20080",
    "editor.selectionHighlightBackground": "#ccbfff",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#dfa0f3",
    "editorLineNumber.foreground": "#68759f",
    "editorLineNumber.activeForeground": "#4250ef",
    "input.placeholderForeground": "#008858",
    "inlineChatInput.placeholderForeground": "#008858",
    "statusBar.background": "#b7c7ff",
    "statusBarItem.remoteBackground": "#b7c7ff",
    "statusBar.foreground": "#151515",
    "statusBarItem.remoteForeground": "#151515",
    "statusBar.noFolderBackground": "#dbdbdb",
    "editorGroup.border": "#bfc4da",
    "editorGroupHeader.tabsBackground": "#efefef",
    "diffEditor.insertedLineBackground": "#d0f0d0",
    "diffEditor.removedLineBackground": "#ffd8d5",
    "diffEditor.insertedTextBackground": "#b2e8be",
    "diffEditor.removedTextBackground": "#f3b5af",
    "editorSuggestWidget.background": "#f3f3f3",
    "editorSuggestWidget.selectedBackground": "#bfe8ff",
    "editorSuggestWidget.highlightForeground": "#4250ef",
    "sideBar.background": "#e6e6e6",
    "activityBar.background": "#e6e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0e0e0",
    "input.foreground": "#202020",
    "inlineChatInput.background": "#e0e0e0",
    "inlineChatInput.foreground": "#202020",
    "editorCursor.foreground": "#202020"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a65f6a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a65f6a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#af5a80"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6052cf"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#e00033"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#ba35af"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#cf25aa"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#af5a80"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1f77bb"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#1f77bb",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#1f77bb"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#008858"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#065fff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#008858"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ba35af"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#008858"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#d3303a"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b6532f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e00033"
      }
    }
  ]
}
