{
  "name": "doom-zenburn",
  "type": "dark",
  "colors": {
    "editor.background": "#3f3f3f",
    "panel.background": "#3f3f3f",
    "editorGutter.background": "#3f3f3f",
    "editor.foreground": "#dcdcdc",
    "editorCursor.background": "#ffffef",
    "editorCursor.foreground": "#dcdcdc",
    "editor.selectionBackground": "#2b2b2b40",
    "editor.findMatchBackground": "#5f5f5f80",
    "editor.selectionHighlightBackground": "#494949",
    "editor.findMatchHighlightBackground": "#383838",
    "editor.wordHighlightStrongBackground": "#3f3f3f",
    "editorLineNumber.foreground": "#6f6f6f",
    "editorLineNumber.activeForeground": "#d0bf8f",
    "input.placeholderForeground": "#f0dfaf",
    "inlineChatInput.placeholderForeground": "#f0dfaf",
    "statusBar.background": "#2b2b2b",
    "statusBarItem.remoteBackground": "#2b2b2b",
    "statusBar.foreground": "#8fb28f",
    "statusBarItem.remoteForeground": "#8fb28f",
    "statusBar.noFolderBackground": "#353535",
    "editorGroup.border": "#656555",
    "editorGroupHeader.tabsBackground": "#2b2b2b",
    "diffEditor.insertedLineBackground": "#383838",
    "diffEditor.removedLineBackground": "#383838",
    "diffEditor.insertedTextBackground": "#383838",
    "diffEditor.removedTextBackground": "#383838",
    "editorSuggestWidget.background": "#4f4f4f",
    "editorSuggestWidget.foreground": "#dcdcdc",
    "editorSuggestWidget.selectedBackground": "#5f5f5f",
    "editorSuggestWidget.highlightForeground": "#8cd0d3",
    "sideBar.background": "#525252",
    "activityBar.background": "#525252",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#4e4e4e",
    "input.foreground": "#dcdcdc",
    "inlineChatInput.background": "#4e4e4e",
    "inlineChatInput.foreground": "#dcdcdc"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#c8d9d9"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#c8d9d9"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#c8d9d9"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#c8d9d9"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f9f7f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f7f5f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#cc9393"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9fc59f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#bfebbf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f0dfaf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8cd0d3"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#8cd0d3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#93e0e3"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a8dee0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#dfaf8f"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ddc5b5"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#e8ddc1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#e8ddc1"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#7cb8bb"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#bfebbf"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8cd0d3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#cc9393"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#8cd0d3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#8cd0d3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#8cd0d3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e0cf9f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cc9393"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#93e0e3"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#8cd0d3"
      }
    }
  ]
}
