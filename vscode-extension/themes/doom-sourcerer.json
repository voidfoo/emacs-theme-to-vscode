{
  "name": "doom-sourcerer",
  "type": "dark",
  "colors": {
    "editor.background": "#171717",
    "panel.background": "#171717",
    "editorGutter.background": "#171717",
    "editor.foreground": "#c2c2b0",
    "editorCursor.background": "#87afd7",
    "editor.selectionBackground": "#32353f40",
    "editor.findMatchBackground": "#5e90a480",
    "editor.selectionHighlightBackground": "#686858",
    "editor.findMatchHighlightBackground": "#5e90a4",
    "editor.wordHighlightStrongBackground": "#1d2127",
    "editorLineNumber.foreground": "#494952",
    "editorLineNumber.activeForeground": "#87afd7",
    "input.placeholderForeground": "#87ceeb",
    "inlineChatInput.placeholderForeground": "#87ceeb",
    "statusBar.background": "#32353f",
    "statusBarItem.remoteBackground": "#32353f",
    "statusBar.foreground": "#bbc2cf",
    "statusBarItem.remoteForeground": "#bbc2cf",
    "statusBar.noFolderBackground": "#222222",
    "editorGroup.border": "#1d2127",
    "editorGroupHeader.tabsBackground": "#32353f",
    "diffEditor.insertedLineBackground": "#222222",
    "diffEditor.removedLineBackground": "#32353f",
    "diffEditor.insertedTextBackground": "#222222",
    "diffEditor.removedTextBackground": "#32353f",
    "breadcrumb.foreground": "#87875f",
    "gitDecoration.modifiedResourceForeground": "#8181a6",
    "gitDecoration.addedResourceForeground": "#87875f",
    "gitDecoration.renamedResourceForeground": "#5d5d4f",
    "gitDecoration.untrackedResourceForeground": "#5d5d4f",
    "gitDecoration.ignoredResourceForeground": "#686858",
    "editorSuggestWidget.background": "#222222",
    "editorSuggestWidget.foreground": "#c2c2b0",
    "editorSuggestWidget.selectedBackground": "#32353f",
    "editorSuggestWidget.highlightForeground": "#87ceeb",
    "sideBar.background": "#2e2e2e",
    "activityBar.background": "#2e2e2e",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2a2a2a",
    "input.foreground": "#c2c2b0",
    "inlineChatInput.background": "#2a2a2a",
    "inlineChatInput.foreground": "#c2c2b0",
    "editorCursor.foreground": "#c2c2b0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686858"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686858"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#87875f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5d5d4f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#578f8f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#87afd7"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#719611"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#87afd7"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#faf4c6"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#faf4c6"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#faf4c6"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#faf4c6"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#faf4c6"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#faf4c6"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#8181a6"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#578f8f"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#cc8800"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#719611"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#87875f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#719611"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#719611"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#719611"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#aa4450"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#aa4450"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1d2127",
        "background": "#aa4450"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#87ceeb"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#87afd7"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#aa4450"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#32353f"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8787af"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#aa4450"
      }
    }
  ]
}
