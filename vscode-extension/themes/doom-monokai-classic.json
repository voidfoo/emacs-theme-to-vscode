{
  "name": "doom-monokai-classic",
  "type": "dark",
  "colors": {
    "editor.background": "#272822",
    "panel.background": "#272822",
    "editorGutter.background": "#272822",
    "editor.foreground": "#f8f8f2",
    "editorCursor.background": "#f92660",
    "editor.selectionBackground": "#4e4e4e40",
    "editor.findMatchBackground": "#a6e22e80",
    "editor.selectionHighlightBackground": "#525254",
    "editor.findMatchHighlightBackground": "#9c91e4",
    "editor.wordHighlightStrongBackground": "#1b2229",
    "editorLineNumber.foreground": "#555556",
    "editorLineNumber.activeForeground": "#cfc0c5",
    "input.placeholderForeground": "#fd971f",
    "inlineChatInput.placeholderForeground": "#fd971f",
    "statusBar.background": "#161613",
    "statusBarItem.remoteBackground": "#161613",
    "statusBar.noFolderBackground": "#171819",
    "editorGroup.border": "#3c3d38",
    "editorGroupHeader.tabsBackground": "#161613",
    "diffEditor.insertedLineBackground": "#1d1e19",
    "diffEditor.removedLineBackground": "#2d2e2e",
    "diffEditor.insertedTextBackground": "#1d1e19",
    "diffEditor.removedTextBackground": "#2d2e2e",
    "breadcrumb.foreground": "#e6db74",
    "gitDecoration.modifiedResourceForeground": "#9c91e4",
    "gitDecoration.addedResourceForeground": "#8dc027",
    "gitDecoration.renamedResourceForeground": "#7f7f80",
    "gitDecoration.untrackedResourceForeground": "#7f7f80",
    "gitDecoration.ignoredResourceForeground": "#555556",
    "editorSuggestWidget.background": "#1d1e19",
    "editorSuggestWidget.foreground": "#f8f8f2",
    "editorSuggestWidget.selectedBackground": "#555556",
    "editorSuggestWidget.highlightForeground": "#fd971f",
    "sideBar.background": "#2b2c25",
    "activityBar.background": "#2b2c25",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2a2b25",
    "input.foreground": "#f8f8f2",
    "inlineChatInput.background": "#2a2b25",
    "inlineChatInput.foreground": "#f8f8f2",
    "editorCursor.foreground": "#f8f8f2",
    "statusBar.foreground": "#f8f8f2",
    "statusBarItem.remoteForeground": "#f8f8f2"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#555556"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#555556"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7f7f80"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#9c91e4"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#fd971f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#9c91e4"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9c91e4"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e74c3c"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1b2229",
        "background": "#e74c3c"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#fd971f"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#27292a"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#f92660"
      }
    }
  ]
}
