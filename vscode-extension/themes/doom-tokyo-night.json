{
  "name": "doom-tokyo-night",
  "type": "dark",
  "colors": {
    "editor.background": "#1a1b26",
    "panel.background": "#1a1b26",
    "editorGutter.background": "#191a25",
    "editor.foreground": "#a9b1d6",
    "editorCursor.background": "#b4f9f8",
    "editor.selectionBackground": "#41486840",
    "editor.findMatchBackground": "#7eaead80",
    "editor.selectionHighlightBackground": "#8189af",
    "editor.findMatchHighlightBackground": "#7eaead",
    "editor.wordHighlightStrongBackground": "#414868",
    "editorLineNumber.foreground": "#51587a",
    "editorLineNumber.activeForeground": "#c0caf5",
    "input.placeholderForeground": "#b4f9f8",
    "inlineChatInput.placeholderForeground": "#b4f9f8",
    "statusBar.background": "#161620",
    "statusBarItem.remoteBackground": "#161620",
    "statusBar.noFolderBackground": "#171822",
    "editorGroup.border": "#252630",
    "editorGroupHeader.tabsBackground": "#161620",
    "diffEditor.insertedLineBackground": "#13141c",
    "diffEditor.removedLineBackground": "#71799d",
    "diffEditor.insertedTextBackground": "#13141c",
    "diffEditor.removedTextBackground": "#71799d",
    "breadcrumb.foreground": "#bb9af7",
    "gitDecoration.modifiedResourceForeground": "#73daca",
    "gitDecoration.addedResourceForeground": "#73daca",
    "gitDecoration.renamedResourceForeground": "#e0af68",
    "gitDecoration.untrackedResourceForeground": "#7c819b",
    "gitDecoration.ignoredResourceForeground": "#51587a",
    "editorSuggestWidget.background": "#13141c",
    "editorSuggestWidget.foreground": "#a9b1d6",
    "editorSuggestWidget.selectedBackground": "#414868",
    "editorSuggestWidget.highlightForeground": "#b4f9f8",
    "sideBar.background": "#1d1e2a",
    "activityBar.background": "#1d1e2a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#1c1d29",
    "input.foreground": "#bac3eb",
    "inlineChatInput.background": "#1c1d29",
    "inlineChatInput.foreground": "#bac3eb",
    "editorCursor.foreground": "#a9b1d6",
    "statusBar.foreground": "#a9b1d6",
    "statusBarItem.remoteForeground": "#a9b1d6"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#51587a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#51587a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7c819b"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#f7768e"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#414868",
        "background": "#f7768e"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#b4f9f8"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#7dcfff",
        "background": "#23242e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    }
  ]
}
