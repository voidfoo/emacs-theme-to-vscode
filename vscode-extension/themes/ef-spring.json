{
  "name": "ef-spring",
  "type": "light",
  "colors": {
    "editor.background": "#f6fff9",
    "panel.background": "#f6fff9",
    "editorGutter.background": "#f6fff9",
    "editor.foreground": "#34494a",
    "editorCursor.background": "#bf005f",
    "editor.selectionBackground": "#d0e6ff40",
    "editor.findMatchBackground": "#efcf0080",
    "editor.selectionHighlightBackground": "#f0bfff",
    "editor.findMatchHighlightBackground": "#afdfff",
    "editor.wordHighlightStrongBackground": "#7fddd0",
    "editorLineNumber.foreground": "#777294",
    "editorLineNumber.activeForeground": "#1a870f",
    "input.placeholderForeground": "#1a870f",
    "inlineChatInput.placeholderForeground": "#1a870f",
    "statusBar.background": "#90e8b0",
    "statusBarItem.remoteBackground": "#90e8b0",
    "statusBar.foreground": "#243228",
    "statusBarItem.remoteForeground": "#243228",
    "statusBar.noFolderBackground": "#e0e6e3",
    "editorGroup.border": "#b4c4c0",
    "editorGroupHeader.tabsBackground": "#e8f0f0",
    "diffEditor.insertedLineBackground": "#c9ffda",
    "diffEditor.removedLineBackground": "#ffd6e0",
    "diffEditor.insertedTextBackground": "#b3efcf",
    "diffEditor.removedTextBackground": "#f5bfc8",
    "editorSuggestWidget.background": "#edf2e9",
    "editorSuggestWidget.selectedBackground": "#d3e4f0",
    "editorSuggestWidget.highlightForeground": "#1a870f",
    "sideBar.background": "#dde6e0",
    "activityBar.background": "#dde6e0",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d8e0db",
    "input.foreground": "#34494a",
    "inlineChatInput.background": "#d8e0db",
    "inlineChatInput.foreground": "#34494a",
    "editorCursor.foreground": "#34494a"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#876450"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#876450"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b6540f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#a04360"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#a04360"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#007f68"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d03003"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#1a870f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4a7d00"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#61756c"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#5f6abf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9435b4"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d03003"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b6540f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#cb26a0"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#cb26a0"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a45f22"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d03003"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#efcf00"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d03003",
        "background": "#ffe8e0"
      }
    }
  ]
}
