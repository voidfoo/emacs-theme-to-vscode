{
  "name": "doom-monokai-pro",
  "type": "dark",
  "colors": {
    "editor.background": "#2d2a2e",
    "panel.background": "#2d2a2e",
    "editorGutter.background": "#2d2a2e",
    "editor.foreground": "#fcfcfa",
    "editorCursor.background": "#fcfcfa",
    "editor.selectionBackground": "#4c4a4d40",
    "editor.findMatchBackground": "#2b2b2b80",
    "editor.selectionHighlightBackground": "#727072",
    "editor.findMatchHighlightBackground": "#2b2b2b",
    "editor.wordHighlightStrongBackground": "#19181a",
    "editorLineNumber.foreground": "#4c4a4d",
    "editorLineNumber.activeForeground": "#ffd866",
    "input.placeholderForeground": "#fcfcfa",
    "inlineChatInput.placeholderForeground": "#fcfcfa",
    "statusBar.background": "#221f22",
    "statusBarItem.remoteBackground": "#221f22",
    "statusBar.foreground": "#939293",
    "statusBarItem.remoteForeground": "#939293",
    "statusBar.noFolderBackground": "#2d2a2e",
    "editorGroup.border": "#413f42",
    "editorGroupHeader.tabsBackground": "#221f22",
    "diffEditor.insertedLineBackground": "#221f22",
    "diffEditor.removedLineBackground": "#2b2b2b",
    "diffEditor.insertedTextBackground": "#221f22",
    "diffEditor.removedTextBackground": "#2b2b2b",
    "breadcrumb.foreground": "#ffd866",
    "gitDecoration.modifiedResourceForeground": "#ab9df2",
    "gitDecoration.addedResourceForeground": "#a9dc76",
    "gitDecoration.renamedResourceForeground": "#ffd866",
    "gitDecoration.untrackedResourceForeground": "#ffd866",
    "gitDecoration.ignoredResourceForeground": "#727072",
    "editorSuggestWidget.background": "#212122",
    "editorSuggestWidget.foreground": "#939293",
    "editorSuggestWidget.selectedBackground": "#4c4a4d",
    "editorSuggestWidget.highlightForeground": "#fcfcfa",
    "sideBar.background": "#322e33",
    "activityBar.background": "#322e33",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#312d32",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#312d32",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#fcfcfa"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#727072"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#727072"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#78dce8"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a9dc76"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a9dc76"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#78dce8"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#cc6666"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#19181a",
        "background": "#cc6666"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#78dce8"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#78dce8"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#2b2b2b"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#cc6666"
      }
    }
  ]
}
