{
  "name": "ef-tritanopia-light",
  "type": "light",
  "colors": {
    "editor.background": "#fff9f9",
    "panel.background": "#fff9f9",
    "editorGutter.background": "#fff9f9",
    "editor.foreground": "#1a1a1a",
    "editorCursor.background": "#bb0000",
    "editor.selectionBackground": "#dadadf40",
    "editor.findMatchBackground": "#ffa2a080",
    "editor.selectionHighlightBackground": "#eda9dc",
    "editor.findMatchHighlightBackground": "#7bcfcf",
    "editor.wordHighlightStrongBackground": "#8fc0cf",
    "editorLineNumber.foreground": "#756275",
    "editorLineNumber.activeForeground": "#2070af",
    "input.placeholderForeground": "#2070af",
    "inlineChatInput.placeholderForeground": "#2070af",
    "statusBar.background": "#ff99aa",
    "statusBarItem.remoteBackground": "#ff99aa",
    "statusBar.foreground": "#1a0a0f",
    "statusBarItem.remoteForeground": "#1a0a0f",
    "statusBar.noFolderBackground": "#ddd9d9",
    "editorGroup.border": "#adadad",
    "editorGroupHeader.tabsBackground": "#efecec",
    "diffEditor.insertedLineBackground": "#c9efea",
    "diffEditor.removedLineBackground": "#ffd6e0",
    "diffEditor.insertedTextBackground": "#b3dfdf",
    "diffEditor.removedTextBackground": "#f5bfc8",
    "editorSuggestWidget.background": "#f2e9e9",
    "editorSuggestWidget.selectedBackground": "#ffcada",
    "editorSuggestWidget.highlightForeground": "#2070af",
    "sideBar.background": "#e6e0e0",
    "activityBar.background": "#e6e0e0",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0dbdb",
    "input.foreground": "#1a1a1a",
    "inlineChatInput.background": "#e0dbdb",
    "inlineChatInput.foreground": "#1a1a1a",
    "editorCursor.foreground": "#1a1a1a"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#92454f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#92454f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2070af"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5f6a90"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#7f4580"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#aa0010"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#dd0000"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#aa357f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#af40af"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7f4580"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#007faa"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#5f6a90"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#007faa"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#007faa"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#2f5faf"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#c50f4f"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#2f5faf"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2070af"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#dd0000"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#2f5faf"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#af40af"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#aa357f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dd0000"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ffa2a0"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dd0000",
        "background": "#ffbfca"
      }
    }
  ]
}
