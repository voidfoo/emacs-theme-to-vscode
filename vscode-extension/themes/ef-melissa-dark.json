{
  "name": "ef-melissa-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#352718",
    "panel.background": "#352718",
    "editorGutter.background": "#352718",
    "editor.foreground": "#e8e4b1",
    "editorCursor.background": "#f9cf7a",
    "editor.selectionBackground": "#443a4f40",
    "editor.findMatchBackground": "#8f504080",
    "editor.selectionHighlightBackground": "#5a661f",
    "editor.findMatchHighlightBackground": "#4648d0",
    "editor.wordHighlightStrongBackground": "#5f6f1f",
    "editorLineNumber.foreground": "#90918a",
    "editorLineNumber.activeForeground": "#ffa21f",
    "input.placeholderForeground": "#a0d13a",
    "inlineChatInput.placeholderForeground": "#a0d13a",
    "statusBar.background": "#704f00",
    "statusBarItem.remoteBackground": "#704f00",
    "statusBar.foreground": "#f8efd8",
    "statusBarItem.remoteForeground": "#f8efd8",
    "statusBar.noFolderBackground": "#59463f",
    "editorGroup.border": "#6f5f58",
    "editorGroupHeader.tabsBackground": "#483426",
    "diffEditor.insertedLineBackground": "#2f491f",
    "diffEditor.removedLineBackground": "#622a1f",
    "diffEditor.insertedTextBackground": "#3f6234",
    "diffEditor.removedTextBackground": "#7f3325",
    "editorSuggestWidget.background": "#44321e",
    "editorSuggestWidget.selectedBackground": "#66421f",
    "editorSuggestWidget.highlightForeground": "#ffa21f",
    "sideBar.background": "#493d2f",
    "activityBar.background": "#493d2f",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#45382a",
    "input.foreground": "#e8e4b1",
    "inlineChatInput.background": "#45382a",
    "inlineChatInput.foreground": "#e8e4b1",
    "editorCursor.foreground": "#e8e4b1"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#eab780"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#eab780"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffa21f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#e89a88"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#dfcfe0"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e4b53f"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff7f4f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#e7a06f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6fd560"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a0d26f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6fcad0"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#99bfcf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6fcad0",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6fcad0"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#65d590"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#98bfff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6fd560"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ffa21f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#c6a2fe"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#6fd560"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff7f4f"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffa21f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7f4f"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#483426"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#e4b53f"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#90918a"
      }
    }
  ]
}
