{
  "name": "doom-monokai-machine",
  "type": "dark",
  "colors": {
    "editor.background": "#273136",
    "panel.background": "#273136",
    "editorGutter.background": "#273136",
    "editor.foreground": "#f2fffc",
    "editorCursor.background": "#f2fffc",
    "editor.selectionBackground": "#3a444940",
    "editor.findMatchBackground": "#3a444980",
    "editor.selectionHighlightBackground": "#545f62",
    "editor.findMatchHighlightBackground": "#3a4449",
    "editorLineNumber.foreground": "#545f62",
    "editorLineNumber.activeForeground": "#8b9798",
    "input.placeholderForeground": "#ffed72",
    "inlineChatInput.placeholderForeground": "#ffed72",
    "statusBar.background": "#3a4449",
    "statusBarItem.remoteBackground": "#3a4449",
    "statusBar.foreground": "#f2fffc",
    "statusBarItem.remoteForeground": "#f2fffc",
    "statusBar.noFolderBackground": "#273136",
    "editorGroup.border": "#3c454a",
    "editorGroupHeader.tabsBackground": "#3a4449",
    "diffEditor.insertedLineBackground": "#3a4449",
    "diffEditor.removedLineBackground": "#3a4449",
    "diffEditor.insertedTextBackground": "#3a4449",
    "diffEditor.removedTextBackground": "#3a4449",
    "breadcrumb.foreground": "#ffed72",
    "gitDecoration.modifiedResourceForeground": "#baa0f8",
    "gitDecoration.addedResourceForeground": "#a2e57b",
    "gitDecoration.renamedResourceForeground": "#ffb270",
    "gitDecoration.untrackedResourceForeground": "#ffb270",
    "gitDecoration.ignoredResourceForeground": "#6b7678",
    "editorSuggestWidget.background": "#1e2528",
    "editorSuggestWidget.foreground": "#f2fffc",
    "editorSuggestWidget.selectedBackground": "#2e363b",
    "editorSuggestWidget.highlightForeground": "#ffed72",
    "sideBar.background": "#3d464a",
    "activityBar.background": "#3d464a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#384146",
    "input.foreground": "#f2fffc",
    "inlineChatInput.background": "#384146",
    "inlineChatInput.foreground": "#f2fffc",
    "editorCursor.foreground": "#f2fffc"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b7678"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b7678"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffed72"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#909899"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#baa0f8"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7cd5f1"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#baa0f8"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a2e57b"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a2e57b"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#7cd5f1"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#baa0f8"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#baa0f8"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ffed72"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffb270"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff6d7e"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#7cd5f1"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#7cd5f1"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffed72"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#373f43"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#7cd5f1"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff6d7e"
      }
    }
  ]
}
