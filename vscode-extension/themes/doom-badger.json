{
  "name": "doom-badger",
  "type": "dark",
  "colors": {
    "editor.background": "#171717",
    "panel.background": "#171717",
    "editorGutter.background": "#171717",
    "editor.foreground": "#f6f3e8",
    "editorCursor.background": "#8ac6f2",
    "editor.selectionBackground": "#43434340",
    "editor.findMatchBackground": "#608aa980",
    "editor.selectionHighlightBackground": "#433f4f",
    "editor.findMatchHighlightBackground": "#608aa9",
    "editor.wordHighlightStrongBackground": "#1d1d1d",
    "editorLineNumber.foreground": "#656868",
    "editorLineNumber.activeForeground": "#f6f3e8",
    "input.placeholderForeground": "#8ac6f2",
    "inlineChatInput.placeholderForeground": "#8ac6f2",
    "statusBar.background": "#272727",
    "statusBarItem.remoteBackground": "#272727",
    "statusBar.foreground": "#f6f3e8",
    "statusBarItem.remoteForeground": "#f6f3e8",
    "statusBar.noFolderBackground": "#2a2a2a",
    "editorGroup.border": "#3c3847",
    "editorGroupHeader.tabsBackground": "#272727",
    "diffEditor.insertedLineBackground": "#2f2f2f",
    "diffEditor.removedLineBackground": "#23272e",
    "diffEditor.insertedTextBackground": "#2f2f2f",
    "diffEditor.removedTextBackground": "#23272e",
    "editorSuggestWidget.background": "#2f2f2f",
    "editorSuggestWidget.foreground": "#f6f3e8",
    "editorSuggestWidget.selectedBackground": "#2257a0",
    "editorSuggestWidget.highlightForeground": "#8ac6f2",
    "sideBar.background": "#2e2e2e",
    "activityBar.background": "#2e2e2e",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2a2a2a",
    "input.foreground": "#f6f3e8",
    "inlineChatInput.background": "#2a2a2a",
    "inlineChatInput.foreground": "#f6f3e8",
    "editorCursor.foreground": "#f6f3e8"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#eae2d4"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#eae2d4"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#eae2d4"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#eae2d4"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#656868"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#656868"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#86b187"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8b8d8d"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#635770"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8ac6f2"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c7b299"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#c7b299",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f28b86"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ea9847"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#edb377",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#bf93c3"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#dac3d5"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#b5d8ee",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#b5d8ee"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#c7b299"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#635770"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#c7b299",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#86b187"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#c7b299",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#c7b299",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#c7b299",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e0d063"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e2434c"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e2434c"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1d1d1d",
        "background": "#e2434c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#00ffff"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#8ac6f2"
      }
    }
  ]
}
