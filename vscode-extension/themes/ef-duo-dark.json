{
  "name": "ef-duo-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#070019",
    "panel.background": "#070019",
    "editorGutter.background": "#070019",
    "editor.foreground": "#d0d0d0",
    "editorCursor.background": "#ef6f11",
    "editor.selectionBackground": "#042a5040",
    "editor.findMatchBackground": "#8f504080",
    "editor.selectionHighlightBackground": "#264f4a",
    "editor.findMatchHighlightBackground": "#4648d0",
    "editor.wordHighlightStrongBackground": "#2f608e",
    "editorLineNumber.foreground": "#857f8f",
    "editorLineNumber.activeForeground": "#6f80ff",
    "input.placeholderForeground": "#c48702",
    "inlineChatInput.placeholderForeground": "#c48702",
    "statusBar.background": "#352487",
    "statusBarItem.remoteBackground": "#352487",
    "statusBar.foreground": "#dedeff",
    "statusBarItem.remoteForeground": "#dedeff",
    "statusBar.noFolderBackground": "#2a2739",
    "editorGroup.border": "#545f6f",
    "editorGroupHeader.tabsBackground": "#1d1a26",
    "diffEditor.insertedLineBackground": "#002d1f",
    "diffEditor.removedLineBackground": "#3d091f",
    "diffEditor.insertedTextBackground": "#003b2f",
    "diffEditor.removedTextBackground": "#5b0f26",
    "editorSuggestWidget.background": "#0d0031",
    "editorSuggestWidget.selectedBackground": "#2f2469",
    "editorSuggestWidget.highlightForeground": "#6f80ff",
    "sideBar.background": "#201a30",
    "activityBar.background": "#201a30",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#1b142b",
    "input.foreground": "#d0d0d0",
    "inlineChatInput.background": "#1b142b",
    "inlineChatInput.foreground": "#d0d0d0",
    "editorCursor.foreground": "#d0d0d0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d08f72"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d08f72"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#df805f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8a9fdf"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c57faf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6f80ff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ef656a"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#5faaef"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0dafdf"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#af85ff"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c57faf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#af85ff",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#af85ff"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#029fff"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#379cf6"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#af85ff"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#df805f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#379cf6"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#af85ff"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#7fafff"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#c48702"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef656a"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#1d1a26"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#7fafff"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#857f8f"
      }
    }
  ]
}
