{
  "name": "doom-homage-black",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "panel.background": "#000000",
    "editorGutter.background": "#000000",
    "editor.foreground": "#bbc2cf",
    "editorCursor.background": "#0170bf",
    "editor.selectionBackground": "#00365a40",
    "editor.findMatchBackground": "#004e8580",
    "editor.selectionHighlightBackground": "#1b2229",
    "editor.findMatchHighlightBackground": "#004e85",
    "editor.wordHighlightStrongBackground": "#1b2229",
    "editorLineNumber.foreground": "#5b6065",
    "editorLineNumber.activeForeground": "#dfdfdf",
    "input.placeholderForeground": "#0170bf",
    "inlineChatInput.placeholderForeground": "#0170bf",
    "statusBar.background": "#1e2126",
    "statusBarItem.remoteBackground": "#1e2126",
    "statusBar.noFolderBackground": "#000000",
    "editorGroup.border": "#1c1f24",
    "editorGroupHeader.tabsBackground": "#1e2126",
    "diffEditor.insertedLineBackground": "#001c2f",
    "diffEditor.removedLineBackground": "#23272e",
    "diffEditor.insertedTextBackground": "#001c2f",
    "diffEditor.removedTextBackground": "#23272e",
    "editorSuggestWidget.background": "#1c1f24",
    "editorSuggestWidget.foreground": "#bbc2cf",
    "editorSuggestWidget.selectedBackground": "#003c64",
    "editorSuggestWidget.highlightForeground": "#0170bf",
    "sideBar.background": "#1a1a1a",
    "activityBar.background": "#1a1a1a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#141414",
    "input.foreground": "#bbc2cf",
    "inlineChatInput.background": "#141414",
    "inlineChatInput.foreground": "#bbc2cf",
    "editorCursor.foreground": "#bbc2cf",
    "statusBar.foreground": "#bbc2cf",
    "statusBarItem.remoteForeground": "#bbc2cf"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#98be65"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#98be65"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b4916d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#81a155",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#dfdfdf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#bbc2cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#dfdfdf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#dfdfdf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3888c3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#bbc2cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#dfdfdf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#b4916d"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#bbc2cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b4916d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#bbc2cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#bbc2cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#bbc2cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ecbe7b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6c6b"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#46d9ff"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#0170bf"
      }
    }
  ]
}
