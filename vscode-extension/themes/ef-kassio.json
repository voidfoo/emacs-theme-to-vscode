{
  "name": "ef-kassio",
  "type": "light",
  "colors": {
    "editor.background": "#fff7f7",
    "panel.background": "#fff7f7",
    "editorGutter.background": "#fff7f7",
    "editor.foreground": "#201f36",
    "editorCursor.background": "#d06f30",
    "editor.selectionBackground": "#dfe4f440",
    "editor.findMatchBackground": "#fac20080",
    "editor.selectionHighlightBackground": "#efd5ff",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#b0dffa",
    "editorLineNumber.foreground": "#776f79",
    "editorLineNumber.activeForeground": "#3c3bbe",
    "input.placeholderForeground": "#4250ef",
    "inlineChatInput.placeholderForeground": "#4250ef",
    "statusBar.background": "#e0bfba",
    "statusBarItem.remoteBackground": "#e0bfba",
    "statusBar.foreground": "#151515",
    "statusBarItem.remoteForeground": "#151515",
    "statusBar.noFolderBackground": "#e0dbdb",
    "editorGroup.border": "#bab7bc",
    "editorGroupHeader.tabsBackground": "#efe7e7",
    "diffEditor.insertedLineBackground": "#c2efcf",
    "diffEditor.removedLineBackground": "#ffcfda",
    "diffEditor.insertedTextBackground": "#bae0c8",
    "diffEditor.removedTextBackground": "#ffb9c9",
    "editorSuggestWidget.background": "#f0ebde",
    "editorSuggestWidget.selectedBackground": "#f2d5c9",
    "editorSuggestWidget.highlightForeground": "#3c3bbe",
    "sideBar.background": "#e6dede",
    "activityBar.background": "#e6dede",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0d9d9",
    "input.foreground": "#201f36",
    "inlineChatInput.background": "#e0d9d9",
    "inlineChatInput.foreground": "#201f36",
    "editorCursor.foreground": "#201f36"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a04646"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#954f90"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#954f90"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3c3bbe"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#e00033"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#a01f64"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9f248a"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#954f90"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#6060d0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#4250ef",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#b00234"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#7022bf"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#1077ab"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a04646"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#d5305f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#1077ab"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#3f6faf"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b6530f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e00033"
      }
    }
  ]
}
