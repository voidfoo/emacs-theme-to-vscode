{
  "name": "spacemacs-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#292b2e",
    "panel.background": "#292b2e",
    "editorGutter.background": "#212026",
    "editor.foreground": "#b2b2b2",
    "editorCursor.background": "#e3dedd",
    "editor.selectionBackground": "#44415540",
    "editor.findMatchBackground": "#86dc2f80",
    "editor.selectionHighlightBackground": "#100a14",
    "editor.findMatchHighlightBackground": "#29422d",
    "editorLineNumber.foreground": "#44505c",
    "editorLineNumber.activeForeground": "#b2b2b2",
    "input.placeholderForeground": "#4f97d7",
    "inlineChatInput.placeholderForeground": "#4f97d7",
    "statusBar.background": "#222226",
    "statusBarItem.remoteBackground": "#222226",
    "statusBar.foreground": "#b2b2b2",
    "statusBarItem.remoteForeground": "#b2b2b2",
    "statusBar.noFolderBackground": "#292b2e",
    "editorGroup.border": "#5d4d7a",
    "editorGroupHeader.tabsBackground": "#212026",
    "diffEditor.insertedLineBackground": "#293235",
    "diffEditor.removedLineBackground": "#3c2a2c",
    "diffEditor.insertedTextBackground": "#29422d",
    "diffEditor.removedTextBackground": "#512e31",
    "breadcrumb.foreground": "#a45bad",
    "gitDecoration.modifiedResourceForeground": "#4f97d7",
    "gitDecoration.addedResourceForeground": "#67b11d",
    "gitDecoration.renamedResourceForeground": "#9f8766",
    "gitDecoration.untrackedResourceForeground": "#2d9574",
    "gitDecoration.ignoredResourceForeground": "#b1951d",
    "editorSuggestWidget.background": "#34323e",
    "editorSuggestWidget.foreground": "#9a9aba",
    "editorSuggestWidget.selectedBackground": "#5e5079",
    "editorSuggestWidget.highlightForeground": "#4f97d7",
    "sideBar.background": "#2d2f33",
    "activityBar.background": "#2d2f33",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#2c2e32",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#2c2e32",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#b2b2b2"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2aa1ae",
        "background": "#292e34"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2aa1ae",
        "background": "#292e34"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2d9574"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9f8766"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#a45bad"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4f97d7"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a45bad"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#4f97d7"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bc6ec5"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bc6ec5"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#7590db"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#7590db"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7590db"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#7590db"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ce537a"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#a45bad"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2d9574"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#bc6ec5"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#dc752f",
        "background": "#292b2e"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e0211d"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e0211d"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e0211d"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#bc6ec5",
        "background": "#373040"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#cbc1d5",
        "background": "#373040"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#bc6ec5"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#2d9574"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#686868"
      }
    }
  ]
}
