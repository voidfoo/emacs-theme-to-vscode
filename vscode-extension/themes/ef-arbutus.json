{
  "name": "ef-arbutus",
  "type": "light",
  "colors": {
    "editor.background": "#ffead8",
    "panel.background": "#ffead8",
    "editorGutter.background": "#ffead8",
    "editor.foreground": "#393330",
    "editorCursor.background": "#208f10",
    "editor.selectionBackground": "#dbe0c040",
    "editor.findMatchBackground": "#efbf0080",
    "editor.selectionHighlightBackground": "#f5bfc5",
    "editor.findMatchHighlightBackground": "#afbeff",
    "editor.wordHighlightStrongBackground": "#efafbf",
    "editorLineNumber.foreground": "#6e678f",
    "editorLineNumber.activeForeground": "#007000",
    "input.placeholderForeground": "#8f2f30",
    "inlineChatInput.placeholderForeground": "#8f2f30",
    "statusBar.background": "#e9a0a0",
    "statusBarItem.remoteBackground": "#e9a0a0",
    "statusBar.foreground": "#40231f",
    "statusBarItem.remoteForeground": "#40231f",
    "statusBar.noFolderBackground": "#e7d2cb",
    "editorGroup.border": "#c0b4a6",
    "editorGroupHeader.tabsBackground": "#f0d8cf",
    "diffEditor.insertedLineBackground": "#d0e6b0",
    "diffEditor.removedLineBackground": "#f8c6b6",
    "diffEditor.insertedTextBackground": "#bbd799",
    "diffEditor.removedTextBackground": "#f0aaa9",
    "breadcrumb.foreground": "#007000",
    "gitDecoration.modifiedResourceForeground": "#906200",
    "gitDecoration.addedResourceForeground": "#007000",
    "gitDecoration.untrackedResourceForeground": "#007000",
    "gitDecoration.ignoredResourceForeground": "#6e678f",
    "editorSuggestWidget.background": "#f0d8cf",
    "editorSuggestWidget.selectedBackground": "#f3c4c4",
    "editorSuggestWidget.highlightForeground": "#007000",
    "sideBar.background": "#e6d3c2",
    "activityBar.background": "#e6d3c2",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0cebe",
    "input.foreground": "#393330",
    "inlineChatInput.background": "#e0cebe",
    "inlineChatInput.foreground": "#393330",
    "editorCursor.foreground": "#393330"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e678f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e678f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#557000"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8d6068"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#845592"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8f2f30"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#b20f00"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#00704f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#007000"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3f712f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#aa184f"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#8f2f30"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#3f69af"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#3f69af"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#b0000f"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#a23ea4"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#a23ea4"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#557000"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#0f7688"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#a23ea4"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#0f7688"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#906200"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b20f00"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#efbf00"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b20f00",
        "background": "#ffd4b5"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#f0d8cf"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8a5f4a"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#6e678f"
      }
    }
  ]
}
