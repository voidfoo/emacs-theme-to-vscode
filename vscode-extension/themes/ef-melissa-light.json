{
  "name": "ef-melissa-light",
  "type": "light",
  "colors": {
    "editor.background": "#fff6d8",
    "panel.background": "#fff6d8",
    "editorGutter.background": "#fff6d8",
    "editor.foreground": "#484431",
    "editorCursor.background": "#a07f00",
    "editor.selectionBackground": "#f0d4d840",
    "editor.findMatchBackground": "#efbf0080",
    "editor.selectionHighlightBackground": "#c4d47a",
    "editor.findMatchHighlightBackground": "#cfceff",
    "editor.wordHighlightStrongBackground": "#afcf8f",
    "editorLineNumber.foreground": "#68708a",
    "editorLineNumber.activeForeground": "#ba5205",
    "input.placeholderForeground": "#5a7400",
    "inlineChatInput.placeholderForeground": "#5a7400",
    "statusBar.background": "#f3cf72",
    "statusBarItem.remoteBackground": "#f3cf72",
    "statusBar.foreground": "#403328",
    "statusBarItem.remoteForeground": "#403328",
    "statusBar.noFolderBackground": "#e7d7c6",
    "editorGroup.border": "#c5baa6",
    "editorGroupHeader.tabsBackground": "#f5e9cb",
    "diffEditor.insertedLineBackground": "#d7ecb0",
    "diffEditor.removedLineBackground": "#f8d0b6",
    "diffEditor.insertedTextBackground": "#c9dda0",
    "diffEditor.removedTextBackground": "#f0bba9",
    "editorSuggestWidget.background": "#ffeed0",
    "editorSuggestWidget.selectedBackground": "#f9dfa8",
    "editorSuggestWidget.highlightForeground": "#ba5205",
    "sideBar.background": "#e6ddc2",
    "activityBar.background": "#e6ddc2",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0d8be",
    "input.foreground": "#484431",
    "inlineChatInput.background": "#e0d8be",
    "inlineChatInput.foreground": "#484431",
    "editorCursor.foreground": "#484431"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f6f1a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f6f1a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#c74400"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#b05350"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#905ea0"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a26310"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#c74400"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#946830"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5a7400"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#61756c"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#0f708a"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#4f6f8f"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#0f708a",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#0f708a"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#008250"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#3f60af"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#007a0a"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c74400"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#6448ca"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#007a0a"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ba5205"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ba5205"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c74400"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#f5e9cb"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a26310"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#68708a"
      }
    }
  ]
}
