{
  "name": "modus-operandi-tritanopia",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "panel.background": "#ffffff",
    "editorGutter.background": "#f2f2f2",
    "editor.foreground": "#000000",
    "editorCursor.background": "#d00000",
    "editor.selectionBackground": "#bdbdbd40",
    "editor.selectionForeground": "#000000",
    "editor.findMatchBackground": "#ff8f8880",
    "editor.selectionHighlightBackground": "#abdfdd",
    "editor.findMatchHighlightBackground": "#a4d5f9",
    "editor.wordHighlightStrongBackground": "#5fcfff",
    "editorLineNumber.foreground": "#595959",
    "editorLineNumber.activeForeground": "#000000",
    "input.placeholderForeground": "#005f5f",
    "inlineChatInput.placeholderForeground": "#005f5f",
    "statusBar.background": "#afe0f2",
    "statusBarItem.remoteBackground": "#afe0f2",
    "statusBar.foreground": "#000000",
    "statusBarItem.remoteForeground": "#000000",
    "statusBar.noFolderBackground": "#e6e6e6",
    "editorGroup.border": "#9f9f9f",
    "editorGroupHeader.tabsBackground": "#f2f2f2",
    "diffEditor.insertedLineBackground": "#b5e7ff",
    "diffEditor.removedLineBackground": "#ffd8d5",
    "diffEditor.insertedTextBackground": "#9adcef",
    "diffEditor.removedTextBackground": "#f3b5af",
    "editorSuggestWidget.background": "#f3f3f3",
    "editorSuggestWidget.selectedBackground": "#afdfef",
    "editorSuggestWidget.highlightForeground": "#005e8b",
    "sideBar.background": "#e6e6e6",
    "activityBar.background": "#e6e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0e0e0",
    "input.foreground": "#000000",
    "inlineChatInput.background": "#e0e0e0",
    "inlineChatInput.foreground": "#000000",
    "editorCursor.foreground": "#000000"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#702000"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#702000"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#005e8b"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#224960"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#7c318f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a0132f"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#b21100"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3f578f"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4a3a8a"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#005f5f"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#104860"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#005f5f",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#005f5f"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#3548cf"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#00663f"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#005e8b"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#a60000"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#b21100"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b21100"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff8f88"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#000000",
        "background": "#ff8f88"
      }
    }
  ]
}
