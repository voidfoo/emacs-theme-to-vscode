{
  "name": "ef-elea-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#222524",
    "panel.background": "#222524",
    "editorGutter.background": "#222524",
    "editor.foreground": "#eaf2ef",
    "editorCursor.background": "#ef7fa8",
    "editor.selectionBackground": "#54304040",
    "editor.findMatchBackground": "#84702080",
    "editor.selectionHighlightBackground": "#425d4a",
    "editor.findMatchHighlightBackground": "#2f5f9f",
    "editor.wordHighlightStrongBackground": "#3f6f5f",
    "editorLineNumber.foreground": "#969faf",
    "editorLineNumber.activeForeground": "#50cf89",
    "input.placeholderForeground": "#cfaaff",
    "inlineChatInput.placeholderForeground": "#cfaaff",
    "statusBar.background": "#35605d",
    "statusBarItem.remoteBackground": "#35605d",
    "statusBar.foreground": "#ecf0ff",
    "statusBarItem.remoteForeground": "#ecf0ff",
    "statusBar.noFolderBackground": "#3e4140",
    "editorGroup.border": "#5d5f63",
    "editorGroupHeader.tabsBackground": "#303332",
    "diffEditor.insertedLineBackground": "#20493f",
    "diffEditor.removedLineBackground": "#5e242f",
    "diffEditor.insertedTextBackground": "#136244",
    "diffEditor.removedTextBackground": "#772a35",
    "editorSuggestWidget.background": "#2c302f",
    "editorSuggestWidget.selectedBackground": "#37493f",
    "editorSuggestWidget.highlightForeground": "#50cf89",
    "sideBar.background": "#383b3a",
    "activityBar.background": "#383b3a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#343636",
    "input.foreground": "#eaf2ef",
    "inlineChatInput.background": "#343636",
    "inlineChatInput.foreground": "#eaf2ef",
    "editorCursor.foreground": "#eaf2ef"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cac89f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cac89f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#50cf89"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#99bfcf"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d0b9f0"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#eba8a8"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff7a5f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#d0b9f0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7fca5a"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a9c99f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f59acf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#d0b9f0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#f59acf",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#f59acf"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#6fcfd2"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#cfaaff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#cfaaff"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#50cf89"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff656a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#cfaaff"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#fa90ea"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e0b02f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7a5f"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#303332"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#7fca5a"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#969faf"
      }
    }
  ]
}
