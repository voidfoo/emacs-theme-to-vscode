{
  "name": "doom-oceanic-next",
  "type": "dark",
  "colors": {
    "editor.background": "#1b2b34",
    "panel.background": "#1b2b34",
    "editorGutter.background": "#1b2b34",
    "editor.foreground": "#d8dee9",
    "editorCursor.background": "#fac863",
    "editor.selectionBackground": "#4f5b6640",
    "editor.findMatchBackground": "#ae8b4580",
    "editor.selectionHighlightBackground": "#a7adba",
    "editor.findMatchHighlightBackground": "#ae8b45",
    "editor.wordHighlightStrongBackground": "#1b2b34",
    "editorLineNumber.foreground": "#a7adba",
    "editorLineNumber.activeForeground": "#d8dee9",
    "input.placeholderForeground": "#fac863",
    "inlineChatInput.placeholderForeground": "#fac863",
    "statusBar.background": "#121f28",
    "statusBarItem.remoteBackground": "#121f28",
    "statusBar.noFolderBackground": "#14232d",
    "editorGroup.border": "#1a1e23",
    "editorGroupHeader.tabsBackground": "#121f28",
    "diffEditor.insertedLineBackground": "#14232d",
    "diffEditor.removedLineBackground": "#65737e",
    "diffEditor.insertedTextBackground": "#1b2b34",
    "diffEditor.removedTextBackground": "#1b2b34",
    "breadcrumb.foreground": "#99c794",
    "gitDecoration.modifiedResourceForeground": "#c594c5",
    "gitDecoration.addedResourceForeground": "#99c794",
    "gitDecoration.renamedResourceForeground": "#8b969e",
    "gitDecoration.untrackedResourceForeground": "#8b969e",
    "gitDecoration.ignoredResourceForeground": "#65737e",
    "editorSuggestWidget.background": "#14232d",
    "editorSuggestWidget.foreground": "#d8dee9",
    "editorSuggestWidget.selectedBackground": "#4f5b66",
    "editorSuggestWidget.highlightForeground": "#fac863",
    "sideBar.background": "#1e2f39",
    "activityBar.background": "#1e2f39",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#1d2e38",
    "input.foreground": "#eef4ff",
    "inlineChatInput.background": "#1d2e38",
    "inlineChatInput.foreground": "#eef4ff",
    "editorCursor.foreground": "#d8dee9",
    "statusBar.foreground": "#d8dee9",
    "statusBarItem.remoteForeground": "#d8dee9"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#65737e"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#65737e"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#99c794"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8b969e"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c594c5"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#5fb3b3"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#ec5f67"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6699cc"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6699cc"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#fac863"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f99157"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#5fb3b3"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#99c794"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#5fb3b3"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#5fb3b3"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#5fb3b3"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#fac863"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ec5f67"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ec5f67"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1b2b34",
        "background": "#ec5f67"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#5fb3b3"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#6699cc"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6699cc"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#26353e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#e27e8d"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ec5f67"
      }
    }
  ]
}
