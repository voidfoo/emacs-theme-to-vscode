{
  "name": "doom-winter-is-coming-light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "panel.background": "#ffffff",
    "editorGutter.background": "#ffffff",
    "editor.foreground": "#1857a4",
    "editorCursor.background": "#2f86d2",
    "editor.selectionBackground": "#cbcdcb40",
    "editor.findMatchBackground": "#c0daf180",
    "editor.selectionHighlightBackground": "#8195b0",
    "editor.findMatchHighlightBackground": "#c0daf1",
    "editor.wordHighlightStrongBackground": "#ffffff",
    "editorLineNumber.foreground": "#cccccc",
    "editorLineNumber.activeForeground": "#cccccc",
    "input.placeholderForeground": "#2f86d2",
    "inlineChatInput.placeholderForeground": "#2f86d2",
    "statusBar.background": "#eff2ef",
    "statusBarItem.remoteBackground": "#eff2ef",
    "statusBar.foreground": "#1857a4",
    "statusBarItem.remoteForeground": "#1857a4",
    "statusBar.noFolderBackground": "#eff2ef",
    "editorGroup.border": "#e1e6ec",
    "editorGroupHeader.tabsBackground": "#eff2ef",
    "diffEditor.insertedLineBackground": "#eff2ef",
    "diffEditor.removedLineBackground": "#9fafc4",
    "diffEditor.insertedTextBackground": "#eff2ef",
    "diffEditor.removedTextBackground": "#9fafc4",
    "breadcrumb.foreground": "#a44185",
    "gitDecoration.modifiedResourceForeground": "#a44185",
    "gitDecoration.addedResourceForeground": "#357b42",
    "gitDecoration.renamedResourceForeground": "#60a8a1",
    "gitDecoration.untrackedResourceForeground": "#60a8a1",
    "gitDecoration.ignoredResourceForeground": "#8195b0",
    "editorSuggestWidget.background": "#eff2ef",
    "editorSuggestWidget.foreground": "#1857a4",
    "editorSuggestWidget.selectedBackground": "#f7ecb5",
    "editorSuggestWidget.highlightForeground": "#2f86d2",
    "sideBar.background": "#e6e6e6",
    "activityBar.background": "#e6e6e6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0e0e0",
    "input.foreground": "#1857a4",
    "inlineChatInput.background": "#e0e0e0",
    "inlineChatInput.foreground": "#1857a4",
    "editorCursor.foreground": "#1857a4"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8195b0"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8195b0"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a44185"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#60a8a1"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#2f86d2"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#dc3eb7"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#dc3eb7"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#dc3eb7"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#dc3eb7"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#2f86d2"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a44185"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#fa841d"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ef5350"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#ef5350"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#219fd5"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#2f86d2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#a3b3c6"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#dc3eb7"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    }
  ]
}
