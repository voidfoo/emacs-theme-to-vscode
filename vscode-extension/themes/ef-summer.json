{
  "name": "ef-summer",
  "type": "light",
  "colors": {
    "editor.background": "#fff2f3",
    "panel.background": "#fff2f3",
    "editorGutter.background": "#fff2f3",
    "editor.foreground": "#4f4073",
    "editorCursor.background": "#cf0090",
    "editor.selectionBackground": "#eecfff40",
    "editor.findMatchBackground": "#ffc20080",
    "editor.selectionHighlightBackground": "#aaeccf",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#9fc0ef",
    "editorLineNumber.foreground": "#786e74",
    "editorLineNumber.activeForeground": "#8e44f3",
    "input.placeholderForeground": "#cb1aaa",
    "inlineChatInput.placeholderForeground": "#cb1aaa",
    "statusBar.background": "#ffa4dc",
    "statusBarItem.remoteBackground": "#ffa4dc",
    "statusBar.foreground": "#341f58",
    "statusBarItem.remoteForeground": "#341f58",
    "statusBar.noFolderBackground": "#efd3e4",
    "editorGroup.border": "#c6bbc6",
    "editorGroupHeader.tabsBackground": "#f2e4ea",
    "diffEditor.insertedLineBackground": "#caf4da",
    "diffEditor.removedLineBackground": "#ffcee0",
    "diffEditor.insertedTextBackground": "#bae9cf",
    "diffEditor.removedTextBackground": "#f5b6c8",
    "editorSuggestWidget.background": "#ffe3ec",
    "editorSuggestWidget.selectedBackground": "#f4cfef",
    "editorSuggestWidget.highlightForeground": "#8e44f3",
    "sideBar.background": "#e6dadb",
    "activityBar.background": "#e6dadb",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0d5d6",
    "input.foreground": "#4f4073",
    "inlineChatInput.background": "#e0d5d6",
    "inlineChatInput.foreground": "#4f4073",
    "editorCursor.foreground": "#4f4073"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9a5f6a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9a5f6a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b6532f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5f60bf"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#a45392"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8e44f3"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#e00033"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#ba35af"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#cb1aaa"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a45392"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#5250ef"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#6060d0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#5250ef",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#5250ef"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#3f6faf"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d50f7f"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#0f7b8f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b6532f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#d50f7f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#0f7b8f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#007f68"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a45f22"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e00033"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#f2e4ea"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#375ce6"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#786e74"
      }
    }
  ]
}
