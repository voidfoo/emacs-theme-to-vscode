{
  "name": "doom-winter-is-coming-dark-blue",
  "type": "dark",
  "colors": {
    "editor.background": "#011627",
    "panel.background": "#011627",
    "editorGutter.background": "#011627",
    "editor.foreground": "#a7dbf7",
    "editorCursor.background": "#4373c2",
    "editor.selectionBackground": "#2b4d7240",
    "editor.findMatchBackground": "#2e508780",
    "editor.selectionHighlightBackground": "#5c7485",
    "editor.findMatchHighlightBackground": "#2e5087",
    "editor.wordHighlightStrongBackground": "#00101d",
    "editorLineNumber.foreground": "#0c4994",
    "editorLineNumber.activeForeground": "#0c4994",
    "input.placeholderForeground": "#4373c2",
    "inlineChatInput.placeholderForeground": "#4373c2",
    "statusBar.background": "#052951",
    "statusBarItem.remoteBackground": "#052951",
    "statusBar.foreground": "#a7dbf7",
    "statusBarItem.remoteForeground": "#a7dbf7",
    "statusBar.noFolderBackground": "#062e5a",
    "editorGroup.border": "#15232f",
    "editorGroupHeader.tabsBackground": "#052951",
    "diffEditor.insertedLineBackground": "#062e5a",
    "diffEditor.removedLineBackground": "#445969",
    "diffEditor.insertedTextBackground": "#062e5a",
    "diffEditor.removedTextBackground": "#445969",
    "breadcrumb.foreground": "#8dec95",
    "gitDecoration.modifiedResourceForeground": "#7e57c2",
    "gitDecoration.addedResourceForeground": "#6bff81",
    "gitDecoration.renamedResourceForeground": "#4876ae",
    "gitDecoration.untrackedResourceForeground": "#4876ae",
    "gitDecoration.ignoredResourceForeground": "#0c4994",
    "editorSuggestWidget.background": "#062e5a",
    "editorSuggestWidget.foreground": "#a7dbf7",
    "editorSuggestWidget.selectedBackground": "#0c4994",
    "editorSuggestWidget.highlightForeground": "#4373c2",
    "sideBar.background": "#01182b",
    "activityBar.background": "#01182b",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#01182a",
    "input.foreground": "#a7dbf7",
    "inlineChatInput.background": "#01182a",
    "inlineChatInput.foreground": "#a7dbf7",
    "editorCursor.foreground": "#a7dbf7"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#0c4994"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#0c4994"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8dec95"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#4876ae"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#d29ffc"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f7ecb5"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8dec95"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffca28"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ef5350"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#00101d",
        "background": "#ef5350"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#00bff9"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#4373c2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#4d6170"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d29ffc"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    }
  ]
}
