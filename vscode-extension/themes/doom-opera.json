{
  "name": "doom-opera",
  "type": "dark",
  "colors": {
    "editor.background": "#323334",
    "panel.background": "#323334",
    "editorGutter.background": "#323334",
    "editor.foreground": "#eceff4",
    "editorCursor.background": "#80a0c2",
    "editor.selectionBackground": "#3f3f3f40",
    "editor.findMatchBackground": "#596f8780",
    "editor.selectionHighlightBackground": "#3f3f3f",
    "editor.findMatchHighlightBackground": "#596f87",
    "editor.wordHighlightStrongBackground": "#000000",
    "editorLineNumber.foreground": "#727269",
    "editorLineNumber.activeForeground": "#eceff4",
    "input.placeholderForeground": "#80a0c2",
    "inlineChatInput.placeholderForeground": "#80a0c2",
    "statusBar.background": "#1e1e20",
    "statusBarItem.remoteBackground": "#1e1e20",
    "statusBar.noFolderBackground": "#222224",
    "editorGroup.border": "#181818",
    "editorGroupHeader.tabsBackground": "#1e1e20",
    "diffEditor.insertedLineBackground": "#22222440",
    "diffEditor.removedLineBackground": "#26262640",
    "diffEditor.insertedTextBackground": "#2222244d",
    "diffEditor.removedTextBackground": "#2626264d",
    "editorSuggestWidget.background": "#222224",
    "editorSuggestWidget.foreground": "#eceff4",
    "editorSuggestWidget.selectedBackground": "#5c748e",
    "editorSuggestWidget.highlightForeground": "#80a0c2",
    "sideBar.background": "#474748",
    "activityBar.background": "#474748",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#424344",
    "input.foreground": "#eceff4",
    "inlineChatInput.background": "#424344",
    "inlineChatInput.foreground": "#eceff4",
    "editorCursor.foreground": "#eceff4",
    "statusBar.foreground": "#eceff4",
    "statusBarItem.remoteForeground": "#eceff4"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#d1dbe7"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d1dbe7"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#d1dbe7"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#d1dbe7"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#747474"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#747474"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a2bf8a"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7d7d7d"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#b58dae"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#80a0c2"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#80a0c2"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#80a0c2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#8ebcbb"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8ebcbb"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#aacbcc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#dac6d6"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e3dae5"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#abbfd6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#abbfd6"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#eccc87"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#b58dae"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#b58dae"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#80a0c2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a2bf8a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#80a0c2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#80a0c2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#80a0c2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eccc87"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c16069"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#86c0d1"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#80a0c2"
      }
    },
    {
      "name": "diff-added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a2bf8a",
        "background": "#222224"
      }
    },
    {
      "name": "diff-removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#c16069",
        "background": "#262626"
      }
    },
    {
      "name": "diff-changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#5d80ae"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#80a0c2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#262626"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#b58dae"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#c16069"
      }
    }
  ]
}
