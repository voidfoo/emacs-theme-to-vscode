{
  "name": "doom-plain-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#222222",
    "panel.background": "#222222",
    "editorGutter.background": "#222222",
    "editor.foreground": "#d7d5d1",
    "editorCursor.background": "#bbbbbb",
    "editor.selectionBackground": "#0e0c0a40",
    "editor.findMatchBackground": "#82828280",
    "editor.selectionHighlightBackground": "#d7d5d1",
    "editor.findMatchHighlightBackground": "#828282",
    "editor.wordHighlightStrongBackground": "#838083",
    "editorLineNumber.foreground": "#444444",
    "editorLineNumber.activeForeground": "#bbbbbb",
    "input.placeholderForeground": "#bbbbbb",
    "inlineChatInput.placeholderForeground": "#bbbbbb",
    "statusBar.background": "#383838",
    "statusBarItem.remoteBackground": "#383838",
    "statusBar.noFolderBackground": "#323232",
    "editorGroup.border": "#d7d5d1",
    "editorGroupHeader.tabsBackground": "#383838",
    "diffEditor.insertedLineBackground": "#050505",
    "diffEditor.removedLineBackground": "#444444",
    "diffEditor.insertedTextBackground": "#050505",
    "diffEditor.removedTextBackground": "#444444",
    "editorSuggestWidget.background": "#434343",
    "editorSuggestWidget.foreground": "#d7d5d1",
    "editorSuggestWidget.selectedBackground": "#0e0c0a",
    "editorSuggestWidget.highlightForeground": "#bbbbbb",
    "sideBar.background": "#383838",
    "activityBar.background": "#383838",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#343434",
    "input.foreground": "#d7d5d1",
    "inlineChatInput.background": "#343434",
    "inlineChatInput.foreground": "#d7d5d1",
    "editorCursor.foreground": "#d7d5d1",
    "statusBar.foreground": "#d7d5d1",
    "statusBarItem.remoteForeground": "#d7d5d1"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#545053",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#545053",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#838083"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#545053",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#838083",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#838083"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#838083"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#adaaaa"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#838083",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#838083"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#838083"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#d7d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#d7d5d1"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#838083",
        "background": "#d7d5d1",
        "fontStyle": "bold"
      }
    }
  ]
}
