{
  "name": "doom-flatwhite",
  "type": "light",
  "colors": {
    "editor.background": "#f7f3ee",
    "panel.background": "#f7f3ee",
    "editorGutter.background": "#f7f3ee",
    "editor.foreground": "#605a52",
    "editorCursor.background": "#7382a0",
    "editor.selectionBackground": "#d8d4cd40",
    "editor.findMatchBackground": "#e8e4ff80",
    "editor.selectionHighlightBackground": "#b9a992",
    "editor.findMatchHighlightBackground": "#e8e4ff",
    "editor.wordHighlightStrongBackground": "#f1ece4",
    "editorLineNumber.foreground": "#a39582",
    "editorLineNumber.activeForeground": "#1b2229",
    "input.placeholderForeground": "#7382a0",
    "inlineChatInput.placeholderForeground": "#7382a0",
    "statusBar.background": "#e4ddd2",
    "statusBarItem.remoteBackground": "#e4ddd2",
    "statusBar.noFolderBackground": "#dedad6",
    "editorGroup.border": "#c6bdb2",
    "editorGroupHeader.tabsBackground": "#e4ddd2",
    "diffEditor.insertedLineBackground": "#f1ece4",
    "diffEditor.removedLineBackground": "#f6cfcb",
    "diffEditor.insertedTextBackground": "#f1ece4",
    "diffEditor.removedTextBackground": "#f6cfcb",
    "editorSuggestWidget.background": "#f1ece4",
    "editorSuggestWidget.foreground": "#605a52",
    "editorSuggestWidget.selectedBackground": "#e8e4ff",
    "editorSuggestWidget.highlightForeground": "#7382a0",
    "sideBar.background": "#dedbd6",
    "activityBar.background": "#dedbd6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d9d6d1",
    "input.foreground": "#605a52",
    "inlineChatInput.background": "#d9d6d1",
    "inlineChatInput.foreground": "#605a52",
    "editorCursor.foreground": "#605a52",
    "statusBar.foreground": "#605a52",
    "statusBarItem.remoteForeground": "#605a52"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#646465"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#646465"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#646465"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#646465"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b9a992"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b9a992"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#525643",
        "background": "#e2e9c1"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9d8f7c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#465953",
        "background": "#d2ebe3"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#614c61",
        "background": "#f1ddf1"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7382a0"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#f7f3ee"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#605a52",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#605a52",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8a6b85",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#4c5361",
        "background": "#dde4f2"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#61515a",
        "background": "#dde4f2"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#7f5d59",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#7f5d59"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#f7f3ee"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#465953",
        "background": "#d2ebe3"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#957f5f"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#f7f3ee"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#525643",
        "background": "#e2e9c1"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#f7f3ee"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#f7f3ee"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#f7f3ee"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#5b4343",
        "background": "#f6cfcb"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#955f5f"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#5f8c7d"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#7382a0"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#614c61",
        "background": "#f1ddf1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#5b5143",
        "background": "#f7e0c3"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4c5361",
        "background": "#dde4f2"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#605a52",
        "fontStyle": "bold"
      }
    }
  ]
}
