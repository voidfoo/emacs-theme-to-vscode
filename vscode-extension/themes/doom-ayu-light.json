{
  "name": "doom-ayu-light",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "panel.background": "#fafafa",
    "editorGutter.background": "#fafafa",
    "editor.foreground": "#575f66",
    "editorCursor.background": "#ff9940",
    "editor.selectionBackground": "#bce1f340",
    "editor.findMatchBackground": "#fbdcc280",
    "editor.selectionHighlightBackground": "#abb0b6",
    "editor.findMatchHighlightBackground": "#fbdcc2",
    "editor.wordHighlightStrongBackground": "#d9c2c6",
    "editorLineNumber.foreground": "#ede3e5",
    "editorLineNumber.activeForeground": "#575f66",
    "input.placeholderForeground": "#ff9940",
    "inlineChatInput.placeholderForeground": "#ff9940",
    "statusBar.background": "#fafafa",
    "statusBarItem.remoteBackground": "#fafafa",
    "statusBar.foreground": "#ba9199",
    "statusBarItem.remoteForeground": "#ba9199",
    "statusBar.noFolderBackground": "#fafafa",
    "editorGroup.border": "#fcfcfc",
    "editorGroupHeader.tabsBackground": "#fafafa",
    "diffEditor.insertedLineBackground": "#fafafa",
    "diffEditor.insertedTextBackground": "#fafafa",
    "breadcrumb.foreground": "#86b300",
    "gitDecoration.modifiedResourceForeground": "#b594d6",
    "gitDecoration.addedResourceForeground": "#99bf4d",
    "gitDecoration.renamedResourceForeground": "#d2d5d6",
    "gitDecoration.untrackedResourceForeground": "#d2d5d6",
    "gitDecoration.ignoredResourceForeground": "#c4c7c9",
    "editorSuggestWidget.background": "#fafafa",
    "editorSuggestWidget.foreground": "#575f66",
    "editorSuggestWidget.selectedBackground": "#e8e8e8",
    "editorSuggestWidget.highlightForeground": "#ff9940",
    "sideBar.background": "#e1e1e1",
    "activityBar.background": "#e1e1e1",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dcdcdc",
    "input.foreground": "#2c3033",
    "inlineChatInput.background": "#dcdcdc",
    "inlineChatInput.foreground": "#2c3033",
    "editorCursor.foreground": "#575f66"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c4c7c9"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c4c7c9"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#86b300"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#d2d5d6"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#a37acc"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#fa8d3e"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ed9366"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f2ae49"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#f2ae49"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#f2ae49"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#e6ba7e"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#a37acc"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f2ae49"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ed9366"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#86b300"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ed9366"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ed9366"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ed9366"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f2ae49"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f51818"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#f07171"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d9c2c6",
        "background": "#f07171"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#55b4d4"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#399ee6"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f07171"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#fafafa"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a37acc"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#f07171"
      }
    }
  ]
}
