{
  "name": "ef-winter",
  "type": "dark",
  "colors": {
    "editor.background": "#0f0b15",
    "panel.background": "#0f0b15",
    "editorGutter.background": "#0f0b15",
    "editor.foreground": "#b8c6d5",
    "editorCursor.background": "#ff6ff0",
    "editor.selectionBackground": "#34246440",
    "editor.findMatchBackground": "#8f504080",
    "editor.selectionHighlightBackground": "#44196f",
    "editor.findMatchHighlightBackground": "#4648d0",
    "editor.wordHighlightStrongBackground": "#2f608e",
    "editorLineNumber.foreground": "#807c9f",
    "editorLineNumber.activeForeground": "#af85ea",
    "input.placeholderForeground": "#e580e0",
    "inlineChatInput.placeholderForeground": "#e580e0",
    "statusBar.background": "#5f1f5f",
    "statusBarItem.remoteBackground": "#5f1f5f",
    "statusBar.foreground": "#dedeff",
    "statusBarItem.remoteForeground": "#dedeff",
    "statusBar.noFolderBackground": "#2a2f42",
    "editorGroup.border": "#4a4955",
    "editorGroupHeader.tabsBackground": "#1d202f",
    "diffEditor.insertedLineBackground": "#00371f",
    "diffEditor.removedLineBackground": "#450f1f",
    "diffEditor.insertedTextBackground": "#004c2f",
    "diffEditor.removedTextBackground": "#641426",
    "editorSuggestWidget.background": "#1a1324",
    "editorSuggestWidget.selectedBackground": "#2f2a7a",
    "editorSuggestWidget.highlightForeground": "#af85ea",
    "sideBar.background": "#27232c",
    "activityBar.background": "#27232c",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#221f28",
    "input.foreground": "#b8c6d5",
    "inlineChatInput.background": "#221f28",
    "inlineChatInput.foreground": "#b8c6d5",
    "editorCursor.foreground": "#b8c6d5"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c0a38a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c0a38a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#df9080"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c57faf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#af85ea"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ef6560"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#e580e0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#35afbf"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#7a94df"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6a9fff",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#4fbaef"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d369af"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#29a444"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#df9080"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#3f95f6"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#29a444"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff6a7a"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b58a52"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef6560"
      }
    }
  ]
}
