{
  "name": "doom-feather-light",
  "type": "light",
  "colors": {
    "editor.background": "#f0edf4",
    "panel.background": "#f0edf4",
    "editorGutter.background": "#f0edf4",
    "editor.foreground": "#4a3b5e",
    "editorCursor.background": "#9783b1",
    "editor.selectionBackground": "#d0cdd640",
    "editor.findMatchBackground": "#d5cddf80",
    "editor.selectionHighlightBackground": "#b4a5c7",
    "editor.findMatchHighlightBackground": "#d5cddf",
    "editor.wordHighlightStrongBackground": "#e8e4ee",
    "editorLineNumber.foreground": "#bfb2cf",
    "editorLineNumber.activeForeground": "#9783b1",
    "input.placeholderForeground": "#9783b1",
    "inlineChatInput.placeholderForeground": "#9783b1",
    "statusBar.background": "#e1dbe9",
    "statusBarItem.remoteBackground": "#e1dbe9",
    "statusBar.foreground": "#4a3b5e",
    "statusBarItem.remoteForeground": "#4a3b5e",
    "statusBar.noFolderBackground": "#d8d5db",
    "editorGroup.border": "#c3bdcc",
    "editorGroupHeader.tabsBackground": "#e1dbe9",
    "diffEditor.insertedLineBackground": "#e8e4ee",
    "diffEditor.removedLineBackground": "#c3b7d2",
    "diffEditor.insertedTextBackground": "#e8e4ee",
    "diffEditor.removedTextBackground": "#c3b7d2",
    "editorSuggestWidget.background": "#e1dbe9",
    "editorSuggestWidget.foreground": "#4a3b5e",
    "editorSuggestWidget.selectedBackground": "#2257a0",
    "editorSuggestWidget.highlightForeground": "#9783b1",
    "sideBar.background": "#d8d5dc",
    "activityBar.background": "#d8d5dc",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d3d1d7",
    "input.foreground": "#4a3b5e",
    "inlineChatInput.background": "#d3d1d7",
    "inlineChatInput.foreground": "#4a3b5e",
    "editorCursor.foreground": "#4a3b5e"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#74456d"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#74456d"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#74456d"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#74456d"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b4a5c7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b4a5c7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5f8700"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#998ca9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#008070"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#875faf"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f4649b"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f4649b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#007daf"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#007daf"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#166996",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#513969"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#4d3a63"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6e508e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6e508e"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#f4649b"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#008070"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#008070"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f4649b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5f8700"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#f4649b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#f4649b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#f4649b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a07000"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#dc322f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e8e4ee",
        "background": "#dc322f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#008ea1"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#007daf"
      }
    }
  ]
}
