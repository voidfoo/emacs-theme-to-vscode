{
  "name": "ef-rosa",
  "type": "dark",
  "colors": {
    "editor.background": "#322023",
    "panel.background": "#322023",
    "editorGutter.background": "#322023",
    "editor.foreground": "#e4d3e1",
    "editorCursor.background": "#ef607a",
    "editor.selectionBackground": "#45524a40",
    "editor.findMatchBackground": "#84702080",
    "editor.selectionHighlightBackground": "#6a4f5f",
    "editor.findMatchHighlightBackground": "#2f5f9f",
    "editor.wordHighlightStrongBackground": "#7c454f",
    "editorLineNumber.foreground": "#9d9d9d",
    "editorLineNumber.activeForeground": "#8ad05a",
    "input.placeholderForeground": "#80dfbf",
    "inlineChatInput.placeholderForeground": "#80dfbf",
    "statusBar.background": "#814558",
    "statusBarItem.remoteBackground": "#814558",
    "statusBar.foreground": "#e8e5e7",
    "statusBarItem.remoteForeground": "#e8e5e7",
    "statusBar.noFolderBackground": "#4a3842",
    "editorGroup.border": "#6f5f58",
    "editorGroupHeader.tabsBackground": "#432e32",
    "diffEditor.insertedLineBackground": "#2f4735",
    "diffEditor.removedLineBackground": "#5f252f",
    "diffEditor.insertedTextBackground": "#1d6044",
    "diffEditor.removedTextBackground": "#792d35",
    "breadcrumb.foreground": "#8ad05a",
    "gitDecoration.modifiedResourceForeground": "#f2a85f",
    "gitDecoration.addedResourceForeground": "#5fbb5f",
    "gitDecoration.untrackedResourceForeground": "#5fbb5f",
    "gitDecoration.ignoredResourceForeground": "#9d9d9d",
    "editorSuggestWidget.background": "#432e32",
    "editorSuggestWidget.selectedBackground": "#6e425f",
    "editorSuggestWidget.highlightForeground": "#8ad05a",
    "sideBar.background": "#372327",
    "activityBar.background": "#372327",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#362326",
    "input.foreground": "#fbe8f8",
    "inlineChatInput.background": "#362326",
    "inlineChatInput.foreground": "#fbe8f8",
    "editorCursor.foreground": "#e4d3e1"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9aba8b"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9aba8b"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8ad05a"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#d8c09f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c59fdf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffb2d6"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff7f5f"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#cfb1ff"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#f28fdf"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c59fdf"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#80dfbf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#99bfcf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#5fc0dc"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#5fc0dc"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#7fc5df"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#49d081"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ffb2d6"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8ad05a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#62cff7"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ffb2d6"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#f0888f"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f2a85f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7f5f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#847020"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7f5f",
        "background": "#551a07"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#432e32"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#96c4af"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#9d9d9d"
      }
    }
  ]
}
