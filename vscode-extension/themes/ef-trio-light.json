{
  "name": "ef-trio-light",
  "type": "light",
  "colors": {
    "editor.background": "#f8f5ff",
    "panel.background": "#f8f5ff",
    "editorGutter.background": "#f8f5ff",
    "editor.foreground": "#4f3363",
    "editorCursor.background": "#4f45ff",
    "editor.selectionBackground": "#eed0ff40",
    "editor.findMatchBackground": "#ffc20080",
    "editor.selectionHighlightBackground": "#b4cfff",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#dfadaf",
    "editorLineNumber.foreground": "#786e74",
    "editorLineNumber.activeForeground": "#c035aa",
    "input.placeholderForeground": "#065fbf",
    "inlineChatInput.placeholderForeground": "#065fbf",
    "statusBar.background": "#ddb4ff",
    "statusBarItem.remoteBackground": "#ddb4ff",
    "statusBar.foreground": "#241f48",
    "statusBarItem.remoteForeground": "#241f48",
    "statusBar.noFolderBackground": "#e3e0e9",
    "editorGroup.border": "#c6bac5",
    "editorGroupHeader.tabsBackground": "#ebe7f1",
    "diffEditor.insertedLineBackground": "#caf4da",
    "diffEditor.removedLineBackground": "#ffcee0",
    "diffEditor.insertedTextBackground": "#bae9cf",
    "diffEditor.removedTextBackground": "#f5b6c8",
    "breadcrumb.foreground": "#c035aa",
    "gitDecoration.modifiedResourceForeground": "#b8532f",
    "gitDecoration.addedResourceForeground": "#057800",
    "gitDecoration.untrackedResourceForeground": "#057800",
    "gitDecoration.ignoredResourceForeground": "#786e74",
    "editorSuggestWidget.background": "#ebe7f1",
    "editorSuggestWidget.selectedBackground": "#f4cfff",
    "editorSuggestWidget.highlightForeground": "#c035aa",
    "sideBar.background": "#dfdde6",
    "activityBar.background": "#dfdde6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dad8e0",
    "input.foreground": "#2f1f3b",
    "inlineChatInput.background": "#dad8e0",
    "inlineChatInput.foreground": "#2f1f3b",
    "editorCursor.foreground": "#4f3363"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a05b5f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a05b5f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#007f6f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#804fb0"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#804fb0"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ad45ba"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d03033"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#705ae3"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5165e4"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6060d0"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#3f6faf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#5f60bf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#0f7a9d"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#c035aa"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ad45ba"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#007f6f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#c3303a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ad45ba"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#c01f5f"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b8532f"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d03033"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ffc200"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d03033",
        "background": "#ffdfe6"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#ebe7f1"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#3f7668"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#786e74"
      }
    }
  ]
}
