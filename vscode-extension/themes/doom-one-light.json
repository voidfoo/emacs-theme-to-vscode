{
  "name": "doom-one-light",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "panel.background": "#fafafa",
    "editorGutter.background": "#fafafa",
    "editor.foreground": "#383a42",
    "editorCursor.background": "#4078f2",
    "editor.selectionBackground": "#d8d8d840",
    "editor.findMatchBackground": "#c2d3f780",
    "editor.selectionHighlightBackground": "#9ca0a4",
    "editor.findMatchHighlightBackground": "#c2d3f7",
    "editor.wordHighlightStrongBackground": "#f0f0f0",
    "editorLineNumber.foreground": "#aaaeb1",
    "editorLineNumber.activeForeground": "#1b2229",
    "input.placeholderForeground": "#4078f2",
    "inlineChatInput.placeholderForeground": "#4078f2",
    "statusBar.background": "#e7e7e7",
    "statusBarItem.remoteBackground": "#e7e7e7",
    "statusBar.foreground": "#383a42",
    "statusBarItem.remoteForeground": "#383a42",
    "statusBar.noFolderBackground": "#e1e1e1",
    "editorGroup.border": "#c8c8c8",
    "editorGroupHeader.tabsBackground": "#e7e7e7",
    "diffEditor.insertedLineBackground": "#f0f0f0",
    "diffEditor.removedLineBackground": "#c6c7c7",
    "diffEditor.insertedTextBackground": "#f0f0f0",
    "diffEditor.removedTextBackground": "#c6c7c7",
    "breadcrumb.foreground": "#50a14f",
    "gitDecoration.modifiedResourceForeground": "#b751b6",
    "gitDecoration.addedResourceForeground": "#50a14f",
    "gitDecoration.renamedResourceForeground": "#84888b",
    "gitDecoration.untrackedResourceForeground": "#84888b",
    "gitDecoration.ignoredResourceForeground": "#9ca0a4",
    "editorSuggestWidget.background": "#e7e7e7",
    "editorSuggestWidget.foreground": "#383a42",
    "editorSuggestWidget.selectedBackground": "#a0bcf8",
    "editorSuggestWidget.highlightForeground": "#4078f2",
    "sideBar.background": "#e1e1e1",
    "activityBar.background": "#e1e1e1",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dcdcdc",
    "input.foreground": "#383a42",
    "inlineChatInput.background": "#dcdcdc",
    "inlineChatInput.foreground": "#383a42",
    "editorCursor.foreground": "#383a42"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9ca0a4"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9ca0a4"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#84888b"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#b751b6"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6a1868"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#6a1868"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6a1868"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6a1868"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#986801"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#b751b6"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#da8548"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#986801"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e45649"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "background": "#e45649"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#e7e7e7"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    }
  ]
}
