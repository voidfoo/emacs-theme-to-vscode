{
  "name": "ef-symbiosis",
  "type": "dark",
  "colors": {
    "editor.background": "#130911",
    "panel.background": "#130911",
    "editorGutter.background": "#130911",
    "editor.foreground": "#d0d0d0",
    "editorCursor.background": "#f0af7f",
    "editor.selectionBackground": "#3f2f4040",
    "editor.findMatchBackground": "#8f504080",
    "editor.selectionHighlightBackground": "#5f3f3a",
    "editor.findMatchHighlightBackground": "#4648d0",
    "editor.wordHighlightStrongBackground": "#005f4a",
    "editorLineNumber.foreground": "#857f8f",
    "editorLineNumber.activeForeground": "#4fbaef",
    "input.placeholderForeground": "#4fbaef",
    "inlineChatInput.placeholderForeground": "#4fbaef",
    "statusBar.background": "#583435",
    "statusBarItem.remoteBackground": "#583435",
    "statusBar.foreground": "#ffe5f0",
    "statusBarItem.remoteForeground": "#ffe5f0",
    "statusBar.noFolderBackground": "#372d32",
    "editorGroup.border": "#4d4a4b",
    "editorGroupHeader.tabsBackground": "#221920",
    "diffEditor.insertedLineBackground": "#233b0f",
    "diffEditor.removedLineBackground": "#4e111f",
    "diffEditor.insertedTextBackground": "#2f512f",
    "diffEditor.removedTextBackground": "#751a1f",
    "editorSuggestWidget.background": "#23101f",
    "editorSuggestWidget.selectedBackground": "#213953",
    "editorSuggestWidget.highlightForeground": "#4fbaef",
    "sideBar.background": "#2b2229",
    "activityBar.background": "#2b2229",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#261d24",
    "input.foreground": "#d0d0d0",
    "inlineChatInput.background": "#261d24",
    "inlineChatInput.foreground": "#d0d0d0",
    "editorCursor.foreground": "#d0d0d0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#857f8f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#857f8f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#df8a5a"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#cf9f8f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c58faf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6aad0f"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff7355"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#3f95f6"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#af85ff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c58faf"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#7a94df"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6a9fff",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#1dbfcf"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#df8a5a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ef6360"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ef6360"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#bf9032"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7355"
      }
    }
  ]
}
