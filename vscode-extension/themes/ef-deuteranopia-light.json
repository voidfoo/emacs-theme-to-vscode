{
  "name": "ef-deuteranopia-light",
  "type": "light",
  "colors": {
    "editor.background": "#f5f5ff",
    "panel.background": "#f5f5ff",
    "editorGutter.background": "#f5f5ff",
    "editor.foreground": "#1a1a2f",
    "editorCursor.background": "#0000bb",
    "editor.selectionBackground": "#dadadf40",
    "editor.findMatchBackground": "#fac20080",
    "editor.selectionHighlightBackground": "#afafef",
    "editor.findMatchHighlightBackground": "#cbcfff",
    "editor.wordHighlightStrongBackground": "#8fc0cf",
    "editorLineNumber.foreground": "#70627f",
    "editorLineNumber.activeForeground": "#065fff",
    "input.placeholderForeground": "#375cd8",
    "inlineChatInput.placeholderForeground": "#375cd8",
    "statusBar.background": "#99c7ff",
    "statusBarItem.remoteBackground": "#99c7ff",
    "statusBar.foreground": "#0a0a1f",
    "statusBarItem.remoteForeground": "#0a0a1f",
    "statusBar.noFolderBackground": "#d3d3e0",
    "editorGroup.border": "#bcbcd0",
    "editorGroupHeader.tabsBackground": "#e8e8ea",
    "diffEditor.insertedLineBackground": "#dbdbff",
    "diffEditor.removedLineBackground": "#fff0af",
    "diffEditor.insertedTextBackground": "#c0c0ef",
    "diffEditor.removedTextBackground": "#f0da88",
    "editorSuggestWidget.background": "#ececf0",
    "editorSuggestWidget.selectedBackground": "#f0dacf",
    "editorSuggestWidget.highlightForeground": "#065fff",
    "sideBar.background": "#dddde6",
    "activityBar.background": "#dddde6",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d8d8e0",
    "input.foreground": "#1a1a2f",
    "inlineChatInput.background": "#d8d8e0",
    "inlineChatInput.foreground": "#1a1a2f",
    "editorCursor.foreground": "#1a1a2f"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77604a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77604a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#965000"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#9f5080"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#965000"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#1f6fbf"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#065fff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6060d0"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1477b2"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#1477b2",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#1477b2"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#805d00"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#765040"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#965000"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#4250ef"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#506fa0"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#6052cf"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#765040"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#965000"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#fac200"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#965000",
        "background": "#f0e0a0"
      }
    }
  ]
}
