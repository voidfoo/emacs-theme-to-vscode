{
  "name": "ef-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "panel.background": "#000000",
    "editorGutter.background": "#000000",
    "editor.foreground": "#d0d0d0",
    "editorCursor.background": "#ff76ff",
    "editor.selectionBackground": "#2a234a40",
    "editor.findMatchBackground": "#8f504080",
    "editor.selectionHighlightBackground": "#551f5a",
    "editor.findMatchHighlightBackground": "#4648d0",
    "editor.wordHighlightStrongBackground": "#20577a",
    "editorLineNumber.foreground": "#857f8f",
    "editorLineNumber.activeForeground": "#3f95f6",
    "input.placeholderForeground": "#00a692",
    "inlineChatInput.placeholderForeground": "#00a692",
    "statusBar.background": "#2a2a75",
    "statusBarItem.remoteBackground": "#2a2a75",
    "statusBar.foreground": "#e0e0ff",
    "statusBarItem.remoteForeground": "#e0e0ff",
    "statusBar.noFolderBackground": "#2b2b2b",
    "editorGroup.border": "#4f4f5f",
    "editorGroupHeader.tabsBackground": "#1a1a1a",
    "diffEditor.insertedLineBackground": "#00381f",
    "diffEditor.removedLineBackground": "#4f1119",
    "diffEditor.insertedTextBackground": "#034f2f",
    "diffEditor.removedTextBackground": "#781a1f",
    "editorSuggestWidget.background": "#0c0c0c",
    "editorSuggestWidget.selectedBackground": "#0f2d4a",
    "editorSuggestWidget.highlightForeground": "#3f95f6",
    "sideBar.background": "#1a1a1a",
    "activityBar.background": "#1a1a1a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#141414",
    "input.foreground": "#d0d0d0",
    "inlineChatInput.background": "#141414",
    "inlineChatInput.foreground": "#d0d0d0",
    "editorCursor.foreground": "#d0d0d0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cf9f8f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cf9f8f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#c58faf"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#af85ff"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f47360"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#d369af"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#e580ea"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c58faf"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1dbfcf"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#8aa0df"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#1dbfcf",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#1dbfcf"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#029fff"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6aad0f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ef6560"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#6aad0f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ef6560"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#bf9032"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f47360"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#8f5040"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f47360",
        "background": "#461210"
      }
    }
  ]
}
