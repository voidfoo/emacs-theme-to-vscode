{
  "name": "tango",
  "type": "light",
  "colors": {
    "editor.background": "#eeeeec",
    "panel.background": "#eeeeec",
    "editorGutter.background": "#eeeeec",
    "editor.foreground": "#2e3436",
    "editorCursor.background": "#204a87",
    "editor.selectionBackground": "#babdb640",
    "editor.findMatchBackground": "#ce5c0080",
    "editor.selectionHighlightBackground": "#8cc4ff",
    "editor.findMatchHighlightBackground": "#e9b96e",
    "editor.wordHighlightStrongBackground": "#40e0d0",
    "editorLineNumber.foreground": "#7f7f7f",
    "editorLineNumber.activeForeground": "#7f7f7f",
    "input.placeholderForeground": "#204a87",
    "inlineChatInput.placeholderForeground": "#204a87",
    "statusBar.background": "#d3d7cf",
    "statusBarItem.remoteBackground": "#d3d7cf",
    "statusBar.foreground": "#2e3436",
    "statusBarItem.remoteForeground": "#2e3436",
    "statusBar.noFolderBackground": "#888a85",
    "editorGroupHeader.tabsBackground": "#e6e6e6",
    "diffEditor.insertedLineBackground": "#eeffee",
    "diffEditor.removedLineBackground": "#ffeeee",
    "diffEditor.insertedTextBackground": "#bbffbb",
    "diffEditor.removedTextBackground": "#ffcccc",
    "editorSuggestWidget.background": "#f8f8ff",
    "editorSuggestWidget.foreground": "#000000",
    "editorSuggestWidget.selectedBackground": "#e6e6fa",
    "editorSuggestWidget.highlightForeground": "#8b0000",
    "sideBar.background": "#d6d6d4",
    "activityBar.background": "#d6d6d4",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d1d1d0",
    "input.foreground": "#2e3436",
    "inlineChatInput.background": "#d1d1d0",
    "inlineChatInput.foreground": "#2e3436",
    "editorCursor.foreground": "#2e3436"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f615c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f615c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5c3566"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5c3566"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#204a87",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#346604"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#75507b"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a40000"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a40000"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#b35000"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#b35000"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#b35000"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#b35000"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#204a87"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#204a87",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5c3566"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#75507b"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a40000"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a40000"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ef2929"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#a020f0"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#d9d9d9"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#bfbfbf",
        "fontStyle": "bold"
      }
    }
  ]
}
