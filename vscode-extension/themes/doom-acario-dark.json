{
  "name": "doom-acario-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d0e16",
    "panel.background": "#0d0e16",
    "editorGutter.background": "#0d0e16",
    "editor.foreground": "#cedbe5",
    "editorCursor.background": "#d85f00",
    "editor.selectionBackground": "#1e1e3340",
    "editor.findMatchBackground": "#97420080",
    "editor.selectionHighlightBackground": "#767676",
    "editor.findMatchHighlightBackground": "#974200",
    "editor.wordHighlightStrongBackground": "#0f1019",
    "editorLineNumber.foreground": "#585c6c",
    "editorLineNumber.activeForeground": "#d85f00",
    "input.placeholderForeground": "#d85f00",
    "inlineChatInput.placeholderForeground": "#d85f00",
    "statusBar.background": "#464a56",
    "statusBarItem.remoteBackground": "#464a56",
    "statusBar.noFolderBackground": "#030306",
    "editorGroup.border": "#0f1019",
    "editorGroupHeader.tabsBackground": "#464a56",
    "diffEditor.insertedLineBackground": "#040408",
    "diffEditor.removedLineBackground": "#464a56",
    "diffEditor.insertedTextBackground": "#040408",
    "diffEditor.removedTextBackground": "#464a56",
    "editorSuggestWidget.background": "#040408",
    "editorSuggestWidget.foreground": "#cedbe5",
    "editorSuggestWidget.selectedBackground": "#0c213e",
    "editorSuggestWidget.highlightForeground": "#d85f00",
    "sideBar.background": "#25262d",
    "activityBar.background": "#25262d",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#202129",
    "input.foreground": "#cedbe5",
    "inlineChatInput.background": "#202129",
    "inlineChatInput.foreground": "#cedbe5",
    "editorCursor.foreground": "#cedbe5",
    "statusBar.foreground": "#cedbe5",
    "statusBarItem.remoteForeground": "#cedbe5"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#a8c2e1"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a8c2e1"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a8c2e1"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a8c2e1"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767676",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767676",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#79d836"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9ae168",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#8041d8"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d83441"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#3679d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d8b941"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d5c372",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#86e7d7"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#aae1de"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#d37682",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#d37682"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8041d8"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d85f00"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3679d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#79d836"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#3679d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#3679d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#3679d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d85f00"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d83441"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#36d8bd"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    }
  ]
}
