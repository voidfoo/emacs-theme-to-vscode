{
  "name": "doom-acario-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d0e16",
    "panel.background": "#0d0e16",
    "editorGutter.background": "#0d0e16",
    "editor.foreground": "#cedbe5",
    "editorCursor.background": "#d85f00",
    "editor.selectionBackground": "#1e1e3340",
    "editor.findMatchBackground": "#97420080",
    "editor.selectionHighlightBackground": "#767676",
    "editor.findMatchHighlightBackground": "#974200",
    "editor.wordHighlightStrongBackground": "#0f1019",
    "editorLineNumber.foreground": "#585c6c",
    "editorLineNumber.activeForeground": "#d85f00",
    "input.placeholderForeground": "#d85f00",
    "inlineChatInput.placeholderForeground": "#d85f00",
    "statusBar.background": "#464a56",
    "statusBarItem.remoteBackground": "#464a56",
    "statusBar.noFolderBackground": "#030306",
    "editorGroup.border": "#0f1019",
    "editorGroupHeader.tabsBackground": "#464a56",
    "diffEditor.insertedLineBackground": "#040408",
    "diffEditor.removedLineBackground": "#464a56",
    "diffEditor.insertedTextBackground": "#040408",
    "diffEditor.removedTextBackground": "#464a56",
    "breadcrumb.foreground": "#79d836",
    "gitDecoration.modifiedResourceForeground": "#ab11d8",
    "gitDecoration.addedResourceForeground": "#79d836",
    "gitDecoration.renamedResourceForeground": "#9ae168",
    "gitDecoration.untrackedResourceForeground": "#9ae168",
    "gitDecoration.ignoredResourceForeground": "#767676",
    "editorSuggestWidget.background": "#040408",
    "editorSuggestWidget.foreground": "#cedbe5",
    "editorSuggestWidget.selectedBackground": "#0c213e",
    "editorSuggestWidget.highlightForeground": "#d85f00",
    "sideBar.background": "#0e0f18",
    "activityBar.background": "#0e0f18",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#0e0f18",
    "input.foreground": "#cedbe5",
    "inlineChatInput.background": "#0e0f18",
    "inlineChatInput.foreground": "#cedbe5",
    "editorCursor.foreground": "#cedbe5",
    "statusBar.foreground": "#ffffff",
    "statusBarItem.remoteForeground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767676"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767676"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#79d836"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9ae168"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#8041d8"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d83441"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d8b941"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d8b941"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#86e7d7"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#86e7d7"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#86e7d7"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#86e7d7"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8041d8"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d85f00"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#79d836"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d85f00"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d83441"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#d83441"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#0f1019",
        "background": "#d83441"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#36d8bd"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#3679d8"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#d83441"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#4f535e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8041d8"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#d83441"
      }
    }
  ]
}
