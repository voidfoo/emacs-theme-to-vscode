{
  "name": "misterioso",
  "type": "dark",
  "colors": {
    "editor.background": "#2d3743",
    "panel.background": "#2d3743",
    "editorGutter.background": "#2d3743",
    "editor.foreground": "#e1e1e0",
    "editorCursor.background": "#415160",
    "editor.selectionBackground": "#2d494840",
    "editor.selectionForeground": "#e1e1e0",
    "editor.findMatchBackground": "#fcffad80",
    "editor.selectionHighlightBackground": "#4a708b",
    "editor.findMatchHighlightBackground": "#338f86",
    "editor.wordHighlightStrongBackground": "#4f94cd",
    "editorLineNumber.foreground": "#b3b3b3",
    "editorLineNumber.activeForeground": "#b3b3b3",
    "input.placeholderForeground": "#729fcf",
    "inlineChatInput.placeholderForeground": "#729fcf",
    "statusBar.background": "#212931",
    "statusBarItem.remoteBackground": "#212931",
    "statusBar.foreground": "#eeeeec",
    "statusBarItem.remoteForeground": "#eeeeec",
    "statusBar.noFolderBackground": "#878787",
    "editorGroupHeader.tabsBackground": "#808080",
    "diffEditor.insertedLineBackground": "#335533",
    "diffEditor.removedLineBackground": "#553333",
    "diffEditor.insertedTextBackground": "#22aa22",
    "diffEditor.removedTextBackground": "#aa2222",
    "breadcrumb.foreground": "#008b8b",
    "gitDecoration.modifiedResourceForeground": "#dbdb95",
    "gitDecoration.addedResourceForeground": "#34cae2",
    "gitDecoration.renamedResourceForeground": "#e67128",
    "gitDecoration.untrackedResourceForeground": "#e67128",
    "gitDecoration.ignoredResourceForeground": "#74af68",
    "editorSuggestWidget.background": "#424242",
    "editorSuggestWidget.selectedBackground": "#4f4f4f",
    "editorSuggestWidget.highlightForeground": "#afeeee",
    "sideBar.background": "#424b56",
    "activityBar.background": "#424b56",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3e4752",
    "input.foreground": "#e1e1e0",
    "inlineChatInput.background": "#3e4752",
    "inlineChatInput.foreground": "#e1e1e0",
    "editorCursor.foreground": "#e1e1e0"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#74af68"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#74af68"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e67128"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#e67128"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#008b8b"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffad29"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#23d7d7"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00ede1"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00ede1"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#dbdb95"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#dbdb95"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#dbdb95"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#dbdb95"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#34cae2"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#008b8b"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e67128"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#23d7d7"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff4242"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffc0cb"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#ff4242"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#a020f0"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "background": "#737373"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "background": "#999999"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#00ede1"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#e67128"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#b3b3b3"
      }
    }
  ]
}
