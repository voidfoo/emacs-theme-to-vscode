{
  "name": "doom-solarized-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#002b36",
    "panel.background": "#002b36",
    "editorGutter.background": "#002b36",
    "editor.foreground": "#839496",
    "editorCursor.background": "#268bd2",
    "editor.selectionBackground": "#07364240",
    "editor.findMatchBackground": "#1a619380",
    "editor.selectionHighlightBackground": "#56697a",
    "editor.findMatchHighlightBackground": "#1a6193",
    "editor.wordHighlightStrongBackground": "#073642",
    "editorLineNumber.foreground": "#56697a",
    "editorLineNumber.activeForeground": "#839496",
    "input.placeholderForeground": "#268bd2",
    "inlineChatInput.placeholderForeground": "#268bd2",
    "statusBar.background": "#002630",
    "statusBarItem.remoteBackground": "#002630",
    "statusBar.noFolderBackground": "#00212b",
    "editorGroup.border": "#011417",
    "editorGroupHeader.tabsBackground": "#002630",
    "diffEditor.insertedLineBackground": "#00212b",
    "diffEditor.removedLineBackground": "#13383c",
    "diffEditor.insertedTextBackground": "#00212b",
    "diffEditor.removedTextBackground": "#13383c",
    "breadcrumb.foreground": "#2aa198",
    "gitDecoration.modifiedResourceForeground": "#6c71c4",
    "gitDecoration.addedResourceForeground": "#859900",
    "gitDecoration.renamedResourceForeground": "#35a69c",
    "gitDecoration.untrackedResourceForeground": "#35a69c",
    "gitDecoration.ignoredResourceForeground": "#405a61",
    "editorSuggestWidget.background": "#00212b",
    "editorSuggestWidget.foreground": "#839496",
    "editorSuggestWidget.selectedBackground": "#204052",
    "editorSuggestWidget.highlightForeground": "#268bd2",
    "sideBar.background": "#002f3b",
    "activityBar.background": "#002f3b",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#002e3a",
    "input.foreground": "#c5dee1",
    "inlineChatInput.background": "#002e3a",
    "inlineChatInput.foreground": "#c5dee1",
    "editorCursor.foreground": "#839496",
    "statusBar.foreground": "#aac0c3",
    "statusBarItem.remoteForeground": "#aac0c3"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#405a61"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#405a61"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#35a69c"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#dc322f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#073642",
        "background": "#dc322f"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#13383c"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#35a69c"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    }
  ]
}
