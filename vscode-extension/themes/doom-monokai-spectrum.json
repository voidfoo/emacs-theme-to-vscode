{
  "name": "doom-monokai-spectrum",
  "type": "dark",
  "colors": {
    "editor.background": "#222222",
    "panel.background": "#222222",
    "editorGutter.background": "#222222",
    "editor.foreground": "#f7f1ff",
    "editorCursor.background": "#f7f1ff",
    "editor.selectionBackground": "#36353740",
    "editor.findMatchBackground": "#36353780",
    "editor.selectionHighlightBackground": "#525053",
    "editor.findMatchHighlightBackground": "#363537",
    "editorLineNumber.foreground": "#525053",
    "editorLineNumber.activeForeground": "#8b888f",
    "input.placeholderForeground": "#fce566",
    "inlineChatInput.placeholderForeground": "#fce566",
    "statusBar.background": "#363537",
    "statusBarItem.remoteBackground": "#363537",
    "statusBar.foreground": "#f7f1ff",
    "statusBarItem.remoteForeground": "#f7f1ff",
    "statusBar.noFolderBackground": "#222222",
    "editorGroup.border": "#383838",
    "editorGroupHeader.tabsBackground": "#363537",
    "diffEditor.insertedLineBackground": "#363537",
    "diffEditor.removedLineBackground": "#363537",
    "diffEditor.insertedTextBackground": "#363537",
    "diffEditor.removedTextBackground": "#363537",
    "editorSuggestWidget.background": "#191919",
    "editorSuggestWidget.foreground": "#f7f1ff",
    "editorSuggestWidget.selectedBackground": "#2c2c2d",
    "editorSuggestWidget.highlightForeground": "#fce566",
    "sideBar.background": "#383838",
    "activityBar.background": "#383838",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#343434",
    "input.foreground": "#f7f1ff",
    "inlineChatInput.background": "#343434",
    "inlineChatInput.foreground": "#f7f1ff",
    "editorCursor.foreground": "#f7f1ff"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#f8cce2"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#f8cce2"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#f8cce2"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#f8cce2"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#69676c"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#69676c"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#fce566"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8e8d90"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#948ae3"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5ad4e6"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#fc618d"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#fc618d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#948ae3"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7bd88f"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a0dfb0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#98dff0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#98dff0"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#5ad4e6"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#948ae3"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#948ae3"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#fc618d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#fce566"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#fc618d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#fc618d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#fc618d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#fd9353"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fc618d"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#5ad4e6"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#5ad4e6"
      }
    }
  ]
}
