{
  "name": "modus-vivendi-tritanopia",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "panel.background": "#000000",
    "editorGutter.background": "#1e1e1e",
    "editor.foreground": "#ffffff",
    "editorCursor.background": "#ff5f5f",
    "editor.selectionBackground": "#5a5a5a40",
    "editor.selectionForeground": "#ffffff",
    "editor.findMatchBackground": "#9d1f1f80",
    "editor.selectionHighlightBackground": "#204853",
    "editor.findMatchHighlightBackground": "#2266ae",
    "editor.wordHighlightStrongBackground": "#2f7f9f",
    "editorLineNumber.foreground": "#989898",
    "editorLineNumber.activeForeground": "#ffffff",
    "input.placeholderForeground": "#6ae4b9",
    "inlineChatInput.placeholderForeground": "#6ae4b9",
    "statusBar.background": "#003c52",
    "statusBarItem.remoteBackground": "#003c52",
    "statusBar.foreground": "#f0f0f0",
    "statusBarItem.remoteForeground": "#f0f0f0",
    "statusBar.noFolderBackground": "#2d2d2d",
    "editorGroup.border": "#646464",
    "editorGroupHeader.tabsBackground": "#1e1e1e",
    "diffEditor.insertedLineBackground": "#004254",
    "diffEditor.removedLineBackground": "#4f1119",
    "diffEditor.insertedTextBackground": "#004f7f",
    "diffEditor.removedTextBackground": "#781a1f",
    "breadcrumb.foreground": "#00d3d0",
    "gitDecoration.modifiedResourceForeground": "#feacd0",
    "gitDecoration.addedResourceForeground": "#00d3d0",
    "gitDecoration.untrackedResourceForeground": "#00d3d0",
    "gitDecoration.ignoredResourceForeground": "#989898",
    "editorSuggestWidget.background": "#1e1e1e",
    "editorSuggestWidget.selectedBackground": "#004253",
    "editorSuggestWidget.highlightForeground": "#00d3d0",
    "sideBar.background": "#1a1a1a",
    "activityBar.background": "#1a1a1a",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#141414",
    "input.foreground": "#ffffff",
    "inlineChatInput.background": "#141414",
    "inlineChatInput.foreground": "#ffffff",
    "editorCursor.foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ff9070"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ff9070"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#a0d7f2"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#caa6df"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff7f86"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff6740"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4ae2ff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9099d9"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#76afbf"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#88ca9f"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff5f59"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff6740"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6740"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#9d1f1f"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#9d1f1f"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#1e1e1e"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a0d7f2"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#989898"
      }
    }
  ]
}
