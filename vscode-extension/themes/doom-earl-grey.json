{
  "name": "doom-earl-grey",
  "type": "light",
  "colors": {
    "editor.background": "#fcfbf9",
    "panel.background": "#fcfbf9",
    "editorGutter.background": "#fcfbf9",
    "editor.foreground": "#605a52",
    "editorCursor.background": "#7686a9",
    "editor.selectionBackground": "#f4eaee40",
    "editor.selectionForeground": "#605a52",
    "editor.findMatchBackground": "#ecd9e280",
    "editor.selectionHighlightBackground": "#9e9a95",
    "editor.findMatchHighlightBackground": "#ecd9e2",
    "editor.wordHighlightStrongBackground": "#ecebe8",
    "editorLineNumber.foreground": "#aeaba6",
    "editorLineNumber.activeForeground": "#8f8a84",
    "input.placeholderForeground": "#7686a9",
    "inlineChatInput.placeholderForeground": "#7686a9",
    "statusBar.background": "#dddbd8",
    "statusBarItem.remoteBackground": "#dddbd8",
    "statusBar.noFolderBackground": "#ecebe8",
    "editorGroup.border": "#cdcbc7",
    "editorGroupHeader.tabsBackground": "#dddbd8",
    "diffEditor.insertedLineBackground": "#f7f3ee",
    "diffEditor.removedLineBackground": "#bebbb6",
    "diffEditor.insertedTextBackground": "#747b4d",
    "diffEditor.removedTextBackground": "#9a6763",
    "breadcrumb.foreground": "#747b4d",
    "gitDecoration.modifiedResourceForeground": "#83577d",
    "gitDecoration.addedResourceForeground": "#8f956f",
    "gitDecoration.renamedResourceForeground": "#9e9a95",
    "gitDecoration.untrackedResourceForeground": "#9e9a95",
    "gitDecoration.ignoredResourceForeground": "#9e9a95",
    "editorSuggestWidget.background": "#f7f3ee",
    "editorSuggestWidget.foreground": "#605a52",
    "editorSuggestWidget.selectedBackground": "#f0ebed",
    "editorSuggestWidget.highlightForeground": "#83577d",
    "sideBar.background": "#e3e2e0",
    "activityBar.background": "#e3e2e0",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dedddb",
    "input.foreground": "#605a52",
    "inlineChatInput.background": "#dedddb",
    "inlineChatInput.foreground": "#605a52",
    "editorCursor.foreground": "#605a52",
    "statusBar.foreground": "#605a52",
    "statusBarItem.remoteForeground": "#605a52"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9e9a95"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9e9a95"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#747b4d"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9e9a95"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#477a7b"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#83577d"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#886a44",
        "background": "#fcfbf9"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#556995"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#556995"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#556995"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#556995"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#477a7b"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#477a7b"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#fcfbf9"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#747b4d"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#fcfbf9"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#605a52",
        "background": "#fcfbf9"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#886a44",
        "background": "#fcfbf9"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8f5652"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#8f5652"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#8f5652"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#bebbb6",
        "background": "#8f5652"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#477a7b"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#556995"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#83577d"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#886a44"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#556995"
      }
    }
  ]
}
