{
  "name": "doom-solarized-dark-high-contrast",
  "type": "dark",
  "colors": {
    "editor.background": "#002732",
    "panel.background": "#002732",
    "editorGutter.background": "#002732",
    "editor.foreground": "#8d9fa1",
    "editorCursor.background": "#3c98e0",
    "editor.selectionBackground": "#01323d40",
    "editor.findMatchBackground": "#2a6a9c80",
    "editor.selectionHighlightBackground": "#56697a",
    "editor.findMatchHighlightBackground": "#2a6a9c",
    "editor.wordHighlightStrongBackground": "#01323d",
    "editorLineNumber.foreground": "#56697a",
    "editorLineNumber.activeForeground": "#8d9fa1",
    "input.placeholderForeground": "#3c98e0",
    "inlineChatInput.placeholderForeground": "#3c98e0",
    "statusBar.background": "#00212a",
    "statusBarItem.remoteBackground": "#00212a",
    "statusBar.noFolderBackground": "#00232d",
    "editorGroup.border": "#011417",
    "editorGroupHeader.tabsBackground": "#00212a",
    "diffEditor.insertedLineBackground": "#00212b",
    "diffEditor.removedLineBackground": "#13383c",
    "diffEditor.insertedTextBackground": "#00212b",
    "diffEditor.removedTextBackground": "#13383c",
    "editorSuggestWidget.background": "#00212b",
    "editorSuggestWidget.foreground": "#8d9fa1",
    "editorSuggestWidget.selectedBackground": "#03373f",
    "editorSuggestWidget.highlightForeground": "#3c98e0",
    "sideBar.background": "#1a3d47",
    "activityBar.background": "#1a3d47",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#143842",
    "input.foreground": "#8d9fa1",
    "inlineChatInput.background": "#143842",
    "inlineChatInput.foreground": "#8d9fa1",
    "editorCursor.foreground": "#8d9fa1",
    "statusBar.foreground": "#8d9fa1",
    "statusBarItem.remoteForeground": "#8d9fa1"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#a08d81"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a08d81"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a08d81"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a08d81"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#62787f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#62787f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#93a61a"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#35a69c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#3c98e0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#93a61a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#db5823"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#db5823",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#3c98e0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3c98e0"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#549acd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#90a350",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#90a350"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#c49619",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#3c98e0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#7a7ed2"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#db5823",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#93a61a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#db5823",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#db5823",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#db5823",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#c49619"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ec423a"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#3cafa5"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#3c98e0"
      }
    }
  ]
}
