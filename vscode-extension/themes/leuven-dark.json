{
  "name": "leuven-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#25202a",
    "panel.background": "#25202a",
    "editorGutter.background": "#25202a",
    "editor.foreground": "#cfccd2",
    "editorCursor.background": "#e1420b",
    "editor.selectionBackground": "#752c0b40",
    "editor.findMatchBackground": "#aa8b5e80",
    "editor.selectionHighlightBackground": "#0601ff",
    "editor.findMatchHighlightBackground": "#0601ff",
    "editor.wordHighlightStrongBackground": "#7b4b98",
    "editorLineNumber.foreground": "#848088",
    "editorLineNumber.activeForeground": "#848088",
    "input.placeholderForeground": "#ffffff",
    "inlineChatInput.placeholderForeground": "#ffffff",
    "statusBar.background": "#cfa161",
    "statusBarItem.remoteBackground": "#cfa161",
    "statusBar.foreground": "#7e311e",
    "statusBarItem.remoteForeground": "#7e311e",
    "statusBar.noFolderBackground": "#696371",
    "editorGroupHeader.tabsBackground": "#322d37",
    "diffEditor.insertedLineBackground": "#442049",
    "diffEditor.removedLineBackground": "#25353e",
    "diffEditor.insertedTextBackground": "#6d0d73",
    "diffEditor.removedTextBackground": "#06494f",
    "breadcrumb.foreground": "#34c8d8",
    "gitDecoration.modifiedResourceForeground": "#4ac964",
    "gitDecoration.addedResourceForeground": "#9fcb66",
    "gitDecoration.renamedResourceForeground": "#fd95fa",
    "gitDecoration.untrackedResourceForeground": "#ff7fff",
    "gitDecoration.ignoredResourceForeground": "#767283",
    "editorSuggestWidget.background": "#372a2a",
    "editorSuggestWidget.foreground": "#ffffff",
    "editorSuggestWidget.selectedBackground": "#ffad65",
    "editorSuggestWidget.highlightForeground": "#54ff59",
    "sideBar.background": "#29232e",
    "activityBar.background": "#29232e",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#28232d",
    "input.foreground": "#e4e0e7",
    "inlineChatInput.background": "#28232d",
    "inlineChatInput.foreground": "#e4e0e7",
    "editorCursor.foreground": "#cfccd2"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767283"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767283"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ff7fff"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#fd95fa"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#34c8d8"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffff0b"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#ff9029"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ff996f"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ff996f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#4ac964"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#4ac964"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#4ac964"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#4ac964"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9fcb66"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#34c8d8"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ff7fff"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#837f87"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#06ffff"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#06ffff"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#3a353f",
        "background": "#252076"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#065a64"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#83ffff",
        "background": "#252073"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#83ffff",
        "background": "#252073"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ff996f"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ff925a"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#848088"
      }
    }
  ]
}
