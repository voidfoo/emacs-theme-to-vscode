{
  "name": "doom-outrun-electric",
  "type": "dark",
  "colors": {
    "editor.background": "#0c0a20",
    "panel.background": "#0c0a20",
    "editorGutter.background": "#0c0a20",
    "editor.foreground": "#f2f3f7",
    "editorCursor.background": "#1ea8fc",
    "editor.selectionBackground": "#1f114740",
    "editor.findMatchBackground": "#1575b080",
    "editor.selectionHighlightBackground": "#546a90",
    "editor.findMatchHighlightBackground": "#1575b0",
    "editor.wordHighlightStrongBackground": "#131033",
    "editorLineNumber.foreground": "#2d2844",
    "editorLineNumber.activeForeground": "#f2f3f7",
    "input.placeholderForeground": "#1ea8fc",
    "inlineChatInput.placeholderForeground": "#1ea8fc",
    "statusBar.background": "#0a091c",
    "statusBarItem.remoteBackground": "#0a091c",
    "statusBar.noFolderBackground": "#0c0a20",
    "editorGroup.border": "#ba45a3",
    "editorGroupHeader.tabsBackground": "#0a091c",
    "diffEditor.insertedLineBackground": "#09081940",
    "diffEditor.removedLineBackground": "#3b416740",
    "diffEditor.insertedTextBackground": "#0908194d",
    "diffEditor.removedTextBackground": "#3b41674d",
    "editorSuggestWidget.background": "#090819",
    "editorSuggestWidget.foreground": "#f2f3f7",
    "editorSuggestWidget.selectedBackground": "#204052",
    "editorSuggestWidget.highlightForeground": "#ff2afc",
    "sideBar.background": "#242336",
    "activityBar.background": "#242336",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#1f1e32",
    "input.foreground": "#f2f3f7",
    "inlineChatInput.background": "#1f1e32",
    "inlineChatInput.foreground": "#f2f3f7",
    "editorCursor.foreground": "#f2f3f7",
    "statusBar.foreground": "#f2f3f7",
    "statusBarItem.remoteForeground": "#f2f3f7"
  },
  "tokenColors": [
    {
      "name": "font-lock-punctuation-face",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#f5c0f8"
      }
    },
    {
      "name": "font-lock-bracket-face",
      "scope": [
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#f5c0f8"
      }
    },
    {
      "name": "font-lock-delimiter-face",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#f5c0f8"
      }
    },
    {
      "name": "font-lock-misc-punctuation-face",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#f5c0f8"
      }
    },
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#546a90"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#546a90"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7984d1"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#a875ff"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#df85ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff2afc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-operator-face",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff2afc"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff2afc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#1ea8fc"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#42c6ff"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#76d3fc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#df85ff"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e8bcfb"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#f97afa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#f97afa"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ffd400"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#df85ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffd400"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff2afc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7984d1"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#ff2afc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ff2afc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ff2afc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffd400"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e61f44"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#42c6ff"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#1ea8fc"
      }
    },
    {
      "name": "diff-added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a7da1e",
        "background": "#090819"
      }
    },
    {
      "name": "diff-removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e61f44",
        "background": "#3b4167"
      }
    },
    {
      "name": "diff-changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#df85ff"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#e61f44",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#3b4167"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a875ff"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#e61f44"
      }
    }
  ]
}
