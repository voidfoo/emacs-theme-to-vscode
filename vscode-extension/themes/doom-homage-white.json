{
  "name": "doom-homage-white",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "panel.background": "#fafafa",
    "editorGutter.background": "#fafafa",
    "editor.foreground": "#383a42",
    "editorCursor.background": "#014980",
    "editor.selectionBackground": "#d8d8d840",
    "editor.findMatchBackground": "#afc4d580",
    "editor.selectionHighlightBackground": "#f0f0f0",
    "editor.findMatchHighlightBackground": "#afc4d5",
    "editor.wordHighlightStrongBackground": "#f0f0f0",
    "editorLineNumber.foreground": "#aaaeb1",
    "editorLineNumber.activeForeground": "#1b2229",
    "input.placeholderForeground": "#014980",
    "inlineChatInput.placeholderForeground": "#014980",
    "statusBar.background": "#d3d3d3",
    "statusBarItem.remoteBackground": "#d3d3d3",
    "statusBar.noFolderBackground": "#e1e1e1",
    "editorGroup.border": "#c8c8c8",
    "editorGroupHeader.tabsBackground": "#d3d3d3",
    "diffEditor.insertedLineBackground": "#f0f0f0",
    "diffEditor.removedLineBackground": "#c6c7c7",
    "diffEditor.insertedTextBackground": "#f0f0f0",
    "diffEditor.removedTextBackground": "#c6c7c7",
    "breadcrumb.foreground": "#8a3b3c",
    "gitDecoration.modifiedResourceForeground": "#b751b6",
    "gitDecoration.addedResourceForeground": "#556b2f",
    "gitDecoration.renamedResourceForeground": "#485a27",
    "gitDecoration.untrackedResourceForeground": "#485a27",
    "gitDecoration.ignoredResourceForeground": "#556b2f",
    "editorSuggestWidget.background": "#e7e7e7",
    "editorSuggestWidget.foreground": "#383a42",
    "editorSuggestWidget.selectedBackground": "#c6c7c7",
    "editorSuggestWidget.highlightForeground": "#014980",
    "sideBar.background": "#e1e1e1",
    "activityBar.background": "#e1e1e1",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dcdcdc",
    "input.foreground": "#383a42",
    "inlineChatInput.background": "#dcdcdc",
    "inlineChatInput.foreground": "#383a42",
    "editorCursor.foreground": "#383a42",
    "statusBar.foreground": "#383a42",
    "statusBarItem.remoteForeground": "#383a42"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#556b2f"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#556b2f"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8a3b3c"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#485a27"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8a3b3c"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8a3b3c"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#986801"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "trailing-whitespace",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "background": "#e45649"
      }
    },
    {
      "name": "show-paren-mismatch",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "background": "#e45649"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#014980"
      }
    },
    {
      "name": "markdown-header-face",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#e7e7e7"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    }
  ]
}
