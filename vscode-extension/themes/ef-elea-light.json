{
  "name": "ef-elea-light",
  "type": "light",
  "colors": {
    "editor.background": "#edf5e2",
    "panel.background": "#edf5e2",
    "editorGutter.background": "#edf5e2",
    "editor.foreground": "#221321",
    "editorCursor.background": "#770080",
    "editor.selectionBackground": "#d9d2ef40",
    "editor.findMatchBackground": "#efbf0080",
    "editor.selectionHighlightBackground": "#b5dfbf",
    "editor.findMatchHighlightBackground": "#cfceff",
    "editor.wordHighlightStrongBackground": "#8ad3a2",
    "editorLineNumber.foreground": "#676470",
    "editorLineNumber.activeForeground": "#007047",
    "input.placeholderForeground": "#9f356a",
    "inlineChatInput.placeholderForeground": "#9f356a",
    "statusBar.background": "#a5c67f",
    "statusBarItem.remoteBackground": "#a5c67f",
    "statusBar.foreground": "#142810",
    "statusBarItem.remoteForeground": "#142810",
    "statusBar.noFolderBackground": "#d0d7ca",
    "editorGroup.border": "#a5aaaf",
    "editorGroupHeader.tabsBackground": "#e3e9d6",
    "diffEditor.insertedLineBackground": "#c7e8ba",
    "diffEditor.removedLineBackground": "#f2d0c6",
    "diffEditor.insertedTextBackground": "#bed9b0",
    "diffEditor.removedTextBackground": "#efbfbd",
    "editorSuggestWidget.background": "#e9efd1",
    "editorSuggestWidget.selectedBackground": "#c2e4ba",
    "editorSuggestWidget.highlightForeground": "#007047",
    "sideBar.background": "#d5ddcb",
    "activityBar.background": "#d5ddcb",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d1d8c7",
    "input.foreground": "#221321",
    "inlineChatInput.background": "#d1d8c7",
    "inlineChatInput.foreground": "#221321",
    "editorCursor.foreground": "#221321"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f4f4a"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f4f4a"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#007047"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#4f677f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6a4a9f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#894852"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d00000"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#6a4a9f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#355500"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#306630"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#80308f"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#6a4a9f"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#80308f",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#80308f"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#162f8f"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#5032aa"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#5032aa"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#007047"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#c3303a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#5032aa"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#9f356a"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b04300"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d00000"
      }
    },
    {
      "name": "markdown-code-face",
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "background": "#e3e9d6"
      }
    },
    {
      "name": "markdown-url-face",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#00601f"
      }
    },
    {
      "name": "markdown-list-face",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#676470"
      }
    }
  ]
}
