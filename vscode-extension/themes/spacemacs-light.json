{
  "name": "spacemacs-light",
  "type": "light",
  "colors": {
    "editor.background": "#fbf8ef",
    "panel.background": "#fbf8ef",
    "editorGutter.background": "#efeae9",
    "editor.foreground": "#655370",
    "editorCursor.background": "#100a14",
    "editor.selectionBackground": "#d3d3e740",
    "editor.findMatchBackground": "#ba2f5980",
    "editor.selectionHighlightBackground": "#e3dedd",
    "editor.findMatchHighlightBackground": "#dae6d0",
    "editorLineNumber.foreground": "#a8a8bf",
    "editorLineNumber.activeForeground": "#655370",
    "input.placeholderForeground": "#3a81c3",
    "inlineChatInput.placeholderForeground": "#3a81c3",
    "statusBar.background": "#e7e5eb",
    "statusBarItem.remoteBackground": "#e7e5eb",
    "statusBar.foreground": "#655370",
    "statusBarItem.remoteForeground": "#655370",
    "statusBar.noFolderBackground": "#fbf8ef",
    "editorGroup.border": "#b3b9be",
    "editorGroupHeader.tabsBackground": "#efeae9",
    "diffEditor.insertedLineBackground": "#edf2e9",
    "diffEditor.removedLineBackground": "#faede4",
    "diffEditor.insertedTextBackground": "#dae6d0",
    "diffEditor.removedTextBackground": "#eed9d2",
    "editorSuggestWidget.background": "#e2e0ea",
    "editorSuggestWidget.foreground": "#8c799f",
    "editorSuggestWidget.selectedBackground": "#c8c6dd",
    "editorSuggestWidget.highlightForeground": "#3a81c3",
    "sideBar.background": "#e2dfd7",
    "activityBar.background": "#e2dfd7",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#dddad2",
    "input.foreground": "#655370",
    "inlineChatInput.background": "#dddad2",
    "inlineChatInput.foreground": "#655370",
    "editorCursor.foreground": "#655370"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2aa1ae",
        "background": "#ecf3ec"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2aa1ae",
        "background": "#ecf3ec"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2d9574"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#da8b55"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#4e3163"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3a81c3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#4e3163"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#3a81c3"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6c3163",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6c3163",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#715ab1"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#715ab1"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#715ab1",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#715ab1"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ba2f59",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#4e3163"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2d9574"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#6c3163"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#dc752f",
        "background": "#fbf8ef"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e0211d"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#6c3163",
        "background": "#ddd8eb"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#655370",
        "background": "#ddd8eb"
      }
    }
  ]
}
