{
  "name": "ef-day",
  "type": "light",
  "colors": {
    "editor.background": "#fff5ea",
    "panel.background": "#fff5ea",
    "editorGutter.background": "#fff5ea",
    "editor.foreground": "#584141",
    "editorCursor.background": "#cf1f00",
    "editor.selectionBackground": "#f0d2df40",
    "editor.findMatchBackground": "#efbf0080",
    "editor.selectionHighlightBackground": "#febccf",
    "editor.findMatchHighlightBackground": "#cfceff",
    "editor.wordHighlightStrongBackground": "#8fcfdf",
    "editorLineNumber.foreground": "#63728f",
    "editorLineNumber.activeForeground": "#ba2d2f",
    "input.placeholderForeground": "#a45a22",
    "inlineChatInput.placeholderForeground": "#a45a22",
    "statusBar.background": "#ffaf72",
    "statusBarItem.remoteBackground": "#ffaf72",
    "statusBar.foreground": "#542f38",
    "statusBarItem.remoteForeground": "#542f38",
    "statusBar.noFolderBackground": "#e9e0d8",
    "editorGroup.border": "#c8bdb6",
    "editorGroupHeader.tabsBackground": "#f2e9db",
    "diffEditor.insertedLineBackground": "#ccefcf",
    "diffEditor.removedLineBackground": "#ffd4d8",
    "diffEditor.insertedTextBackground": "#bae0c0",
    "diffEditor.removedTextBackground": "#ffc0ca",
    "editorSuggestWidget.background": "#ffead2",
    "editorSuggestWidget.selectedBackground": "#f2d3d0",
    "editorSuggestWidget.highlightForeground": "#ba2d2f",
    "sideBar.background": "#e6ddd3",
    "activityBar.background": "#e6ddd3",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#e0d8ce",
    "input.foreground": "#584141",
    "inlineChatInput.background": "#e0d8ce",
    "inlineChatInput.foreground": "#584141",
    "editorCursor.foreground": "#584141"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#527545"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#527545"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5f7200"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9a625a"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#a04450"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a45a22"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ce3f00"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#cf2f4f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ca3e54"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a04450"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#8448aa"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#a04450"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#8448aa",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#8448aa"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#0f7f5f"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ce3f00"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#375cc6"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5f7200"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#cb2f80"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#375cc6"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#3f6faf"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a45a22"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ce3f00"
      }
    }
  ]
}
