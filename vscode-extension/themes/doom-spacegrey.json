{
  "name": "doom-spacegrey",
  "type": "dark",
  "colors": {
    "editor.background": "#2b303b",
    "panel.background": "#2b303b",
    "editorGutter.background": "#2b303b",
    "editor.foreground": "#c0c5ce",
    "editorCursor.background": "#d08770",
    "editor.selectionBackground": "#4f5b6640",
    "editor.findMatchBackground": "#915e4e80",
    "editor.selectionHighlightBackground": "#4f5b66",
    "editor.findMatchHighlightBackground": "#915e4e",
    "editor.wordHighlightStrongBackground": "#1b2229",
    "editorLineNumber.foreground": "#4f5b66",
    "editorLineNumber.activeForeground": "#c0c5ce",
    "input.placeholderForeground": "#d08770",
    "inlineChatInput.placeholderForeground": "#d08770",
    "statusBar.background": "#1c1f24",
    "statusBarItem.remoteBackground": "#1c1f24",
    "statusBar.noFolderBackground": "#21262d",
    "editorGroup.border": "#20242c",
    "editorGroupHeader.tabsBackground": "#1c1f24",
    "diffEditor.insertedLineBackground": "#232830",
    "diffEditor.removedLineBackground": "#2f3237",
    "diffEditor.insertedTextBackground": "#232830",
    "diffEditor.removedTextBackground": "#2f3237",
    "editorSuggestWidget.background": "#232830",
    "editorSuggestWidget.foreground": "#c0c5ce",
    "editorSuggestWidget.selectedBackground": "#4f5b66",
    "editorSuggestWidget.highlightForeground": "#d08770",
    "sideBar.background": "#40454f",
    "activityBar.background": "#40454f",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#888888",
    "input.background": "#3c414b",
    "input.foreground": "#c0c5ce",
    "inlineChatInput.background": "#3c414b",
    "inlineChatInput.foreground": "#c0c5ce",
    "editorCursor.foreground": "#c0c5ce",
    "statusBar.foreground": "#c0c5ce",
    "statusBarItem.remoteForeground": "#c0c5ce"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#65737e"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#65737e"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8b969e"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#c0c5ce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8fa1b3"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9dabbb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#bf939c"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#b8a4ba",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#b8a4ba"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ecbe7b"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "font-lock-number-face",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#c0c5ce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#c0c5ce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#c0c5ce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#c0c5ce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ecbe7b"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "name": "diff-header",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#46d9ff"
      }
    },
    {
      "name": "diff-file-header",
      "scope": [
        "meta.diff.header.file"
      ],
      "settings": {
        "foreground": "#8fa1b3"
      }
    }
  ]
}
