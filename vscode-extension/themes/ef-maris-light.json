{
  "name": "ef-maris-light",
  "type": "light",
  "colors": {
    "editor.background": "#edf4f8",
    "panel.background": "#edf4f8",
    "editorGutter.background": "#edf4f8",
    "editor.foreground": "#151a27",
    "editorCursor.background": "#036f99",
    "editor.selectionBackground": "#c8dcff40",
    "editor.findMatchBackground": "#efbf0080",
    "editor.selectionHighlightBackground": "#b7bbea",
    "editor.findMatchHighlightBackground": "#cfceff",
    "editor.wordHighlightStrongBackground": "#cab3b2",
    "editorLineNumber.foreground": "#676470",
    "editorLineNumber.activeForeground": "#003faf",
    "input.placeholderForeground": "#444fcf",
    "inlineChatInput.placeholderForeground": "#444fcf",
    "statusBar.background": "#a0c2ef",
    "statusBarItem.remoteBackground": "#a0c2ef",
    "statusBar.foreground": "#142810",
    "statusBarItem.remoteForeground": "#142810",
    "statusBar.noFolderBackground": "#cfd8e3",
    "editorGroup.border": "#a2a6af",
    "editorGroupHeader.tabsBackground": "#e0e7ef",
    "diffEditor.insertedLineBackground": "#b0e8ca",
    "diffEditor.removedLineBackground": "#f5c7d6",
    "diffEditor.insertedTextBackground": "#a0d4b9",
    "diffEditor.removedTextBackground": "#efb1cd",
    "editorSuggestWidget.background": "#e4eaf0",
    "editorSuggestWidget.selectedBackground": "#cdd5f7",
    "editorSuggestWidget.highlightForeground": "#003faf",
    "sideBar.background": "#d5dcdf",
    "activityBar.background": "#d5dcdf",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#666666",
    "input.background": "#d1d7da",
    "input.foreground": "#151a27",
    "inlineChatInput.background": "#d1d7da",
    "inlineChatInput.foreground": "#151a27",
    "editorCursor.foreground": "#151a27"
  },
  "tokenColors": [
    {
      "name": "font-lock-comment-face",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8b4052"
      }
    },
    {
      "name": "font-lock-comment-delimiter-face",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8b4052"
      }
    },
    {
      "name": "font-lock-string-face",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#006f70"
      }
    },
    {
      "name": "font-lock-doc-face",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#3f627f"
      }
    },
    {
      "name": "font-lock-doc-markup-face",
      "scope": [
        "comment.documentation storage.type",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6a4a9f"
      }
    },
    {
      "name": "font-lock-keyword-face",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#444fcf"
      }
    },
    {
      "name": "font-lock-negation-char-face",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d00000"
      }
    },
    {
      "name": "font-lock-builtin-face",
      "scope": [
        "support.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#6a4a9f"
      }
    },
    {
      "name": "font-lock-function-name-face",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3a6f00"
      }
    },
    {
      "name": "font-lock-function-call-face",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4a763f"
      }
    },
    {
      "name": "font-lock-variable-name-face",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1f66af"
      }
    },
    {
      "name": "font-lock-variable-use-face",
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#3f627f"
      }
    },
    {
      "name": "font-lock-property-name-face",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#1f66af",
        "fontStyle": ""
      }
    },
    {
      "name": "font-lock-property-use-face",
      "scope": [
        "variable.other.object.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#1f66af"
      }
    },
    {
      "name": "font-lock-type-face",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#007010"
      }
    },
    {
      "name": "font-lock-constant-face",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#003faf"
      }
    },
    {
      "name": "font-lock-escape-face",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#805a1f"
      }
    },
    {
      "name": "font-lock-regexp-face",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#006f70"
      }
    },
    {
      "name": "font-lock-regexp-grouping-construct",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#c3303a"
      }
    },
    {
      "name": "font-lock-regexp-grouping-backslash",
      "scope": [
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#805a1f"
      }
    },
    {
      "name": "font-lock-preprocessor-face",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#5f2fba"
      }
    },
    {
      "name": "font-lock-warning-face",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8b4400"
      }
    },
    {
      "name": "error",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d00000"
      }
    }
  ]
}
