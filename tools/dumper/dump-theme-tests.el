;;; dump-theme-tests.el --- Tests for theme face export -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'dump-theme)

(ert-deftest dump-theme-exports-style-only-faces ()
  (let ((output (make-temp-file "theme-faces" nil ".json"))
        (custom-enabled-themes nil))
    (unwind-protect
        (cl-letf (((symbol-function 'load-theme) (lambda (&rest _) nil))
                  ((symbol-function 'disable-theme) (lambda (&rest _) nil))
                  ((symbol-function 'face-list) (lambda () '(styled plain)))
                  ((symbol-function 'face-attribute)
                   (lambda (face attr _frame inherit)
                     (should (eq inherit t))
                     (if (eq face 'styled)
                         (pcase attr
                           (:weight 'semi-bold)
                           (:slant 'oblique)
                           (:underline t)
                           (:strike-through t)
                           (_ 'unspecified))
                       'unspecified))))
          (dump-theme-faces 'test-theme output)
          (let* ((json-object-type 'hash-table)
                 (json-key-type 'string)
                 (data (json-read-file output))
                 (styled (gethash "styled" data)))
            (should styled)
            (dolist (key '("bold" "italic" "underline" "strike"))
              (should (eq (gethash key styled) t)))
            (should-not (gethash "fg" styled))
            (should-not (gethash "plain" data))))
      (delete-file output))))
